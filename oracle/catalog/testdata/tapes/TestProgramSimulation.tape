| ===SEQUENCE	ORDER_SEQ
| CREATE SEQUENCE "ORDER_SEQ" INCREMENT BY 1 MINVALUE 1 MAXVALUE 9999999999999999999999999999 CACHE 20 NOCYCLE NOORDER;
| ===TABLE	AUDIT_LOG
| CREATE TABLE "AUDIT_LOG" ("ID" NUMBER(10), "WHAT" VARCHAR2(100 BYTE), "AT" DATE);
| ===TABLE	CUSTOMERS
| CREATE TABLE "CUSTOMERS" ("ID" NUMBER(10) NOT NULL, "NAME" VARCHAR2(100 BYTE) NOT NULL, "REGION" VARCHAR2(10 BYTE));
| ALTER TABLE "CUSTOMERS" ADD CONSTRAINT "CUSTOMERS_PK" PRIMARY KEY ("ID");
| ===TABLE	ORDERS
| CREATE TABLE "ORDERS" ("ID" NUMBER(10) NOT NULL, "CUSTOMER_ID" NUMBER(10), "AMOUNT" NUMBER(10,2), "STATUS" VARCHAR2(20 BYTE));
| ALTER TABLE "ORDERS" ADD CONSTRAINT "ORDERS_CUSTOMER_FK" FOREIGN KEY ("CUSTOMER_ID") REFERENCES "CUSTOMERS" ("ID");
| ALTER TABLE "ORDERS" ADD CONSTRAINT "ORDERS_PK" PRIMARY KEY ("ID");
| ===VIEW	V_CUSTOMERS
| CREATE VIEW "V_CUSTOMERS" ("ID", "NAME") AS SELECT id, name FROM customers;
| ===SYNONYM	CUST
| CREATE SYNONYM "CUST" FOR "CUSTOMERS";
