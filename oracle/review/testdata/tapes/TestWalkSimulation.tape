-- pin: default gvenzl/oracle-free:23.26.3-slim-faststart sha256:f5ff19033860d662c821cb04eb10483fa94f14f78eae252d054291ea07028093 23.26.3.0.0

== TestWalkSimulation default#1
> exec
| BEGIN
|   FOR s IN (SELECT synonym_name FROM dba_synonyms WHERE owner = 'PUBLIC' AND table_owner IN ('SIMSHOP', 'SIMOTHER') ORDER BY synonym_name) LOOP
|     EXECUTE IMMEDIATE 'DROP PUBLIC SYNONYM "' || s.synonym_name || '"';
|   END LOOP;
|   FOR u IN (SELECT username FROM dba_users WHERE username IN ('SIMSHOP', 'SIMOTHER') ORDER BY username) LOOP
|     EXECUTE IMMEDIATE 'DROP USER ' || u.username || ' CASCADE';
|   END LOOP;
| END;
< ok 1 0
> exec
| CREATE USER SIMSHOP IDENTIFIED BY omni_test QUOTA UNLIMITED ON users
< ok 0 0
> exec
| GRANT CREATE SESSION, CREATE TABLE, CREATE VIEW, CREATE MATERIALIZED VIEW, CREATE SEQUENCE, CREATE SYNONYM, CREATE PROCEDURE, CREATE TRIGGER, CREATE TYPE TO SIMSHOP
< ok 0 0
> exec
| CREATE USER SIMOTHER IDENTIFIED BY omni_test QUOTA UNLIMITED ON users
< ok 0 0
> query
| SELECT * FROM (
| SELECT 'object' s, owner o, NULL tbl, object_name n, object_type k FROM dba_objects
|  WHERE owner IN ('SIMSHOP', 'SIMOTHER') AND namespace = 1 AND object_type <> 'NON-EXISTENT'
| UNION ALL SELECT 'table', x.owner, NULL, x.table_name,
|        CASE WHEN EXISTS (SELECT 1 FROM dba_mviews m WHERE m.owner = x.owner AND m.mview_name = x.table_name) THEN 'MATERIALIZED VIEW' ELSE 'TABLE' END
|   FROM (SELECT owner, table_name FROM dba_tables UNION ALL SELECT owner, table_name FROM dba_object_tables) x WHERE x.owner IN ('SIMSHOP', 'SIMOTHER')
| UNION ALL SELECT 'view', owner, NULL, view_name, 'VIEW' FROM dba_views WHERE owner IN ('SIMSHOP', 'SIMOTHER')
| UNION ALL SELECT 'sequence', sequence_owner, NULL, sequence_name, 'SEQUENCE' FROM dba_sequences WHERE sequence_owner IN ('SIMSHOP', 'SIMOTHER')
| UNION ALL SELECT 'synonym', owner, NULL, synonym_name, 'SYNONYM' FROM all_synonyms
|  WHERE owner IN ('SIMSHOP', 'SIMOTHER') OR owner = 'PUBLIC' AND INSTR(',A,DUAL,FTP,T,T_OFFSET,USING,ZZZ,', ',' || synonym_name || ',') > 0
| UNION ALL SELECT 'column', owner, table_name, column_name, NULL FROM dba_tab_cols WHERE owner IN ('SIMSHOP', 'SIMOTHER')
| UNION ALL SELECT 'primary key', owner, table_name, NULL, NULL FROM dba_constraints WHERE owner IN ('SIMSHOP', 'SIMOTHER') AND constraint_type = 'P'
| UNION ALL SELECT 'table constraint', owner, table_name, constraint_name, NULL FROM dba_constraints WHERE owner IN ('SIMSHOP', 'SIMOTHER')
| UNION ALL SELECT 'table constraint', owner, table_name, log_group_name, NULL FROM dba_log_groups WHERE owner IN ('SIMSHOP', 'SIMOTHER')
| UNION ALL SELECT 'constraint', owner, table_name, constraint_name, owner FROM dba_constraints WHERE owner IN ('SIMSHOP', 'SIMOTHER')
| UNION ALL SELECT 'constraint', owner, table_name, log_group_name, owner FROM dba_log_groups WHERE owner IN ('SIMSHOP', 'SIMOTHER')
| UNION ALL SELECT 'index', owner, table_name, index_name, table_owner FROM dba_indexes WHERE owner IN ('SIMSHOP', 'SIMOTHER')
| UNION ALL SELECT 'trigger', owner, table_name, trigger_name, table_owner FROM dba_triggers WHERE owner IN ('SIMSHOP', 'SIMOTHER')
| ) WHERE (n IS NULL OR NOT (n LIKE 'SYS\_%' ESCAPE '\' OR n LIKE 'ISEQ$$\_%' ESCAPE '\' OR n LIKE 'BIN$%' OR n LIKE 'ORA$%'))
|   AND (tbl IS NULL OR NOT (tbl LIKE 'SYS\_%' ESCAPE '\' OR tbl LIKE 'BIN$%' OR tbl LIKE 'ORA$%'))
| ORDER BY s, o, tbl, n, k
