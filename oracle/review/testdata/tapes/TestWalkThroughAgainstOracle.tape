== TestWalkThroughAgainstOracle/triggers default#1
> exec
| BEGIN
|   FOR s IN (SELECT synonym_name FROM dba_synonyms WHERE owner = 'PUBLIC' AND table_owner IN ('SHOP', 'OTHER') ORDER BY synonym_name) LOOP
|     EXECUTE IMMEDIATE 'DROP PUBLIC SYNONYM "' || s.synonym_name || '"';
|   END LOOP;
|   FOR u IN (SELECT username FROM dba_users WHERE username IN ('SHOP', 'OTHER') ORDER BY username) LOOP
|     EXECUTE IMMEDIATE 'DROP USER ' || u.username || ' CASCADE';
|   END LOOP;
| END;
< ok 1 0
> exec
| CREATE USER SHOP IDENTIFIED BY omni_test QUOTA UNLIMITED ON users
< ok 0 0
> exec
| GRANT CREATE SESSION, CREATE TABLE, CREATE VIEW, CREATE MATERIALIZED VIEW, CREATE SEQUENCE, CREATE SYNONYM, CREATE PROCEDURE, CREATE TRIGGER, CREATE TYPE TO SHOP
< ok 0 0
