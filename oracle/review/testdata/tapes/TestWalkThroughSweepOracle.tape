> query
| SELECT * FROM (
| SELECT 'object' s, owner o, NULL tbl, object_name n, object_type k FROM dba_objects
|  WHERE owner IN ('SHOP1', 'OTHER1') AND namespace = 1 AND object_type <> 'NON-EXISTENT'
| UNION ALL SELECT 'table', x.owner, NULL, x.table_name,
|        CASE WHEN EXISTS (SELECT 1 FROM dba_mviews m WHERE m.owner = x.owner AND m.mview_name = x.table_name) THEN 'MATERIALIZED VIEW' ELSE 'TABLE' END
|   FROM (SELECT owner, table_name FROM dba_tables UNION ALL SELECT owner, table_name FROM dba_object_tables) x WHERE x.owner IN ('SHOP1', 'OTHER1')
| UNION ALL SELECT 'view', owner, NULL, view_name, 'VIEW' FROM dba_views WHERE owner IN ('SHOP1', 'OTHER1')
| UNION ALL SELECT 'sequence', sequence_owner, NULL, sequence_name, 'SEQUENCE' FROM dba_sequences WHERE sequence_owner IN ('SHOP1', 'OTHER1')
| UNION ALL SELECT 'synonym', owner, NULL, synonym_name, 'SYNONYM' FROM all_synonyms
|  WHERE owner IN ('SHOP1', 'OTHER1') OR owner = 'PUBLIC' AND INSTR(',A,ADD,ALTER,AS,B,C,CHECK,CK,COLUMN,CONSTRAINT,CREATE,DROP,DUAL,EXISTS,FK,FOREIGN,FROM,FUNCTION,ID,IF,INDEX,J,KEY,NOT,NULL,NUMBER,ON,OTHER1,PK,PRIMARY,REFERENCES,RENAME,SELECT,SET,TABLE,TO,UNIQUE,UPDATE,UQ,V,X,Y,Z,a,x,', ',' || synonym_name || ',') > 0
| UNION ALL SELECT 'column', owner, table_name, column_name, NULL FROM dba_tab_cols WHERE owner IN ('SHOP1', 'OTHER1')
| UNION ALL SELECT 'primary key', owner, table_name, NULL, NULL FROM dba_constraints WHERE owner IN ('SHOP1', 'OTHER1') AND constraint_type = 'P'
| UNION ALL SELECT 'table constraint', owner, table_name, constraint_name, NULL FROM dba_constraints WHERE owner IN ('SHOP1', 'OTHER1')
| UNION ALL SELECT 'table constraint', owner, table_name, log_group_name, NULL FROM dba_log_groups WHERE owner IN ('SHOP1', 'OTHER1')
| UNION ALL SELECT 'constraint', owner, table_name, constraint_name, owner FROM dba_constraints WHERE owner IN ('SHOP1', 'OTHER1')
| UNION ALL SELECT 'constraint', owner, table_name, log_group_name, owner FROM dba_log_groups WHERE owner IN ('SHOP1', 'OTHER1')
| UNION ALL SELECT 'index', owner, table_name, index_name, table_owner FROM dba_indexes WHERE owner IN ('SHOP1', 'OTHER1')
| UNION ALL SELECT 'trigger', owner, table_name, trigger_name, table_owner FROM dba_triggers WHERE owner IN ('SHOP1', 'OTHER1')
| ) WHERE (n IS NULL OR NOT (n LIKE 'SYS\_%' ESCAPE '\' OR n LIKE 'ISEQ$$\_%' ESCAPE '\' OR n LIKE 'BIN$%' OR n LIKE 'ORA$%'))
|   AND (tbl IS NULL OR NOT (tbl LIKE 'SYS\_%' ESCAPE '\' OR tbl LIKE 'BIN$%' OR tbl LIKE 'ORA$%'))
| ORDER BY s, o, tbl, n, k
