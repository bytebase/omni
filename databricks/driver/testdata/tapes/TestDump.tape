| {"status":200,"contentType":"application/json","body":"{\"tables\":[{\"name\":\"job_run_timeline\",\"catalog_name\":\"system\",\"schema_name\":\"lakeflow\",\"table_type\":\"MANAGED\",\"comment\":\"The `job_run_timeline` table is a fact table that contains slices of ongoing job runs, allowing one to track the run time and metadata related to each job run. Each slice is represented by `period_start_time` and `period_end_time` timestamps. For documentation, example queries, and monitoring usage, see [Lakeflow System Tables](https://docs.databricks.com/en/admin/system-tables/jobs.html#job-run-timeline-table-schema).\",\"columns\":[{\"name\":\"account_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"nullable\":true,\"comment\":\"The ID of the account this job belongs to.\"},{\"name\":\"workspace_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":1,\"nullable\":true,\"comment\":\"The ID of the workspace this job belongs to.\"},{\"name\":\"job_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":2,\"nullable\":true,\"comment\":\"The ID of the job. This key is only unique within a single workspace.\"},{\"name\":\"run_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":3,\"nullable\":true,\"comment\":\"The ID of the job run.\"},{\"name\":\"period_start_time\",\"type_text\":\"timestamp\",\"type_name\":\"TIMESTAMP\",\"position\":4,\"nullable\":true,\"comment\":\"The start time for the run or for the time period. Timezone information is recorded at the end of the value with +00:00 representing UTC.\"},{\"name\":\"period_end_time\",\"type_text\":\"timestamp\",\"type_name\":\"TIMESTAMP\",\"position\":5,\"nullable\":true,\"comment\":\"The end time for the run or for the time period. Timezone information is recorded at the end of the value with +00:00 representing UTC.\"},{\"name\":\"trigger_type\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":6,\"nullable\":true,\"comment\":\"The type of trigger that can fire a run. For possible values, see [Trigger type values](https://docs.databricks.com/en/admin/system-tables/jobs.html#trigger)\"},{\"name\":\"result_state\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":7,\"nullable\":true,\"comment\":\"The outcome of the job run. For possible values, see [Result state values](https://docs.databricks.com/en/admin/system-tables/jobs.html#result).\"},{\"name\":\"run_type\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":8,\"nullable\":true,\"comment\":\"The type of job run. For possible values, see [Run type values](https://docs.databricks.com/en/admin/system-tables/jobs.html#run-type).\"},{\"name\":\"run_name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":9,\"nullable\":true,\"comment\":\"The user-supplied run name associated with this job run.\"},{\"name\":\"compute_ids\",\"type_text\":\"array\\u003cstring\\u003e\",\"type_name\":\"ARRAY\",\"position\":10,\"nullable\":true,\"comment\":\"Array containing the compute IDs for the parent job run. Use for identifying cluster used by `WORKFLOW_RUN` run types. For other compute information, refer to the `job_task_run_timeline` table. **Not populated for rows emitted before late August 2024**\"},{\"name\":\"termination_code\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":11,\"nullable\":true,\"comment\":\"The termination code of the job run. For possible values, see [Termination code values](https://docs.databricks.com/en/admin/system-tables/jobs.html#termination). **Not populated for rows emitted before late August 2024.**\"},{\"name\":\"job_parameters\",\"type_text\":\"map\\u003cstring,map\\u003cstring,string\\u003e\\u003e\",\"type_name\":\"MAP\",\"position\":12,\"nullable\":true,\"comment\":\"The job-level parameters used in the job run. **Not populated for rows emitted before late August 2024.**\"},{\"name\":\"source_task_run_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":13,\"nullable\":true,\"comment\":\"The ID of the run that started this job run: the Run Job task run for a job run started by a Run Job task, or the run that called dbutils.notebook.run for a notebook workflow run. **Not populated for rows emitted before late November 2025**\"},{\"name\":\"root_task_run_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":14,\"nullable\":true,\"comment\":\"For notebook workflow runs (dbutils.notebook.run), the value is the ID of the top-level task run that started the workflow, including when notebooks call other notebooks. For other runs, the value is NULL. For job runs started by a Run Job task, use source_task_run_id to trace each parent run back to the top-level run. **Not populated for rows emitted before late November 2025**\"},{\"name\":\"compute\",\"type_text\":\"array\\u003cstruct\\u003ctype:string,cluster_id:string,warehouse_id:string\\u003e\\u003e\",\"type_name\":\"ARRAY\",\"position\":15,\"nullable\":true,\"comment\":\"Details about the compute resources used in the job run. **Not populated for rows emitted before late November 2025**\"},{\"name\":\"termination_type\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":16,\"nullable\":true,\"comment\":\"The type of termination for the job run. **Not populated for rows emitted before late November 2025**\"},{\"name\":\"setup_duration_seconds\",\"type_text\":\"bigint\",\"type_name\":\"LONG\",\"position\":17,\"nullable\":true,\"comment\":\"The duration of the setup phase for the job run in seconds. **Not populated for rows emitted before late November 2025**\"},{\"name\":\"queue_duration_seconds\",\"type_text\":\"bigint\",\"type_name\":\"LONG\",\"position\":18,\"nullable\":true,\"comment\":\"The duration spent in the queue for the job run in seconds. **Not populated for rows emitted before late November 2025**\"},{\"name\":\"run_duration_seconds\",\"type_text\":\"bigint\",\"type_name\":\"LONG\",\"position\":19,\"nullable\":true,\"comment\":\"The total duration of the job run in seconds. **Not populated for rows emitted before late November 2025**\"},{\"name\":\"cleanup_duration_seconds\",\"type_text\":\"bigint\",\"type_name\":\"LONG\",\"position\":20,\"nullable\":true,\"comment\":\"The duration of the cleanup phase for the job run in seconds. **Not populated for rows emitted before late November 2025**\"},{\"name\":\"execution_duration_seconds\",\"type_text\":\"bigint\",\"type_name\":\"LONG\",\"position\":21,\"nullable\":true,\"comment\":\"The duration of the execution phase for the job run in seconds. **Not populated for rows emitted before late November 2025**\"}]},{\"name\":\"job_task_run_timeline\",\"catalog_name\":\"system\",\"schema_name\":\"lakeflow\",\"table_type\":\"MANAGED\",\"comment\":\"The `job_task_run_timeline` table is a fact table that contains slices of ongoing job runs, allowing one to track the run time and metadata related to each job task run. Each slice is represented by `period_start_time` and `period_end_time` timestamps. For documentation, example queries, and monitoring usage, see [Lakeflow System Tables](https://docs.databricks.com/en/admin/system-tables/jobs.html#job-task-run-timeline-table-schema).\",\"columns\":[{\"name\":\"account_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"nullable\":true,\"comment\":\"The ID of the account this job belongs to.\"},{\"name\":\"workspace_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":1,\"nullable\":true,\"comment\":\"The ID of the workspace this job belongs to.\"},{\"name\":\"job_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":2,\"nullable\":true,\"comment\":\"The ID of the job. Only unique within a single workspace.\"},{\"name\":\"run_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":3,\"nullable\":true,\"comment\":\"The ID of the task run.\"},{\"name\":\"period_start_time\",\"type_text\":\"timestamp\",\"type_name\":\"TIMESTAMP\",\"position\":4,\"nullable\":true,\"comment\":\"The start time for the task or for the time period. Timezone information is recorded at the end of the value with +00:00 representing UTC.\"},{\"name\":\"period_end_time\",\"type_text\":\"timestamp\",\"type_name\":\"TIMESTAMP\",\"position\":5,\"nullable\":true,\"comment\":\"The end time for the task or for the time period. Timezone information is recorded at the end of the value with +00:00 representing UTC.\"},{\"name\":\"task_key\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":6,\"nullable\":true,\"comment\":\"The reference key for a task in a job. This key is only unique within a single job.\"},{\"name\":\"compute_ids\",\"type_text\":\"array\\u003cstring\\u003e\",\"type_name\":\"ARRAY\",\"position\":7,\"nullable\":true,\"comment\":\"An array containing the IDs of compute used by the job task.\"},{\"name\":\"result_state\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":8,\"nullable\":true,\"comment\":\"The outcome of the job task run.\"},{\"name\":\"job_run_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":9,\"nullable\":true,\"comment\":\"The ID of the job run. **Not populated for rows emitted before late August 2024.**\"},{\"name\":\"parent_run_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":10,\"nullable\":true,\"comment\":\"The ID of the parent run. **Not populated for rows emitted before late August 2024.**\"},{\"name\":\"termination_code\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":11,\"nullable\":true,\"comment\":\"The termination code of the task run. **Not populated for rows emitted before late August 2024.**\"},{\"name\":\"compute\",\"type_text\":\"array\\u003cstruct\\u003ctype:string,cluster_id:string,warehouse_id:string\\u003e\\u003e\",\"type_name\":\"ARRAY\",\"position\":12,\"nullable\":true,\"comment\":\"Details about the compute resources used in the job task run. **Not populated for rows emitted before late November 2025**\"},{\"name\":\"termination_type\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":13,\"nullable\":true,\"comment\":\"The type of termination for the job task run. **Not populated for rows emitted before late November 2025**\"},{\"name\":\"task_parameters\",\"type_text\":\"map\\u003cstring,map\\u003cstring,string\\u003e\\u003e\",\"type_name\":\"MAP\",\"position\":14,\"nullable\":true,\"comment\":\"The task-level parameters used in the job task run. **Not populated for rows emitted before late November 2025**\"},{\"name\":\"setup_duration_seconds\",\"type_text\":\"bigint\",\"type_name\":\"LONG\",\"position\":15,\"nullable\":true,\"comment\":\"The duration of the setup phase for the task run in seconds. **Not populated for rows emitted before late November 2025**\"},{\"name\":\"cleanup_duration_seconds\",\"type_text\":\"bigint\",\"type_name\":\"LONG\",\"position\":16,\"nullable\":true,\"comment\":\"The duration of the cleanup phase for the task run in seconds. **Not populated for rows emitted before late November 2025**\"},{\"name\":\"execution_duration_seconds\",\"type_text\":\"bigint\",\"type_name\":\"LONG\",\"position\":17,\"nullable\":true,\"comment\":\"The duration of the execution phase for the task run in seconds. **Not populated for rows emitted before late November 2025**\"}]},{\"name\":\"job_tasks\",\"catalog_name\":\"system\",\"schema_name\":\"lakeflow\",\"table_type\":\"MANAGED\",\"comment\":\"The `job_tasks` table is a slow-changing dimension table (SCD2) that contains the full history of job task configurations over time. When a row changes, a new row is emitted, logically replacing the previous one. For documentation, example queries, and monitoring usage, see [Lakeflow System Tables](https://docs.databricks.com/en/admin/system-tables/jobs.html#job-task-table-schema).\",\"columns\":[{\"name\":\"account_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"nullable\":true,\"comment\":\"The ID of the account this job belongs to.\"},{\"name\":\"workspace_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":1,\"nullable\":true,\"comment\":\"The ID of the workspace this job belongs to.\"},{\"name\":\"job_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":2,\"nullable\":true,\"comment\":\"The ID of the job. Only unique within a single workspace.\"},{\"name\":\"task_key\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":3,\"nullable\":true,\"comment\":\"The reference key for a task in a job. Only unique within a single job.\"},{\"name\":\"depends_on_keys\",\"type_text\":\"array\\u003cstring\\u003e\",\"type_name\":\"ARRAY\",\"position\":4,\"nullable\":true,\"comment\":\"The task keys of all upstream dependencies of this task.\"},{\"name\":\"change_time\",\"type_text\":\"timestamp\",\"type_name\":\"TIMESTAMP\",\"position\":5,\"nullable\":true,\"comment\":\"The time when the task was last modified. Timezone recorded as +00:00 (UTC).\"},{\"name\":\"delete_time\",\"type_text\":\"timestamp\",\"type_name\":\"TIMESTAMP\",\"position\":6,\"nullable\":true,\"comment\":\"The time when a task was deleted by the user. Timezone recorded as +00:00 (UTC).\"},{\"name\":\"timeout_seconds\",\"type_text\":\"bigint\",\"type_name\":\"LONG\",\"position\":7,\"nullable\":true,\"comment\":\"The timeout duration for the task in seconds. **Not populated for rows emitted before late November 2025**\"},{\"name\":\"health_rules\",\"type_text\":\"array\\u003cstruct\\u003cmetric:string,operator:string,value:bigint\\u003e\\u003e\",\"type_name\":\"ARRAY\",\"position\":8,\"nullable\":true,\"comment\":\"Set of health rules defined for this job task. **Not populated for rows emitted before late November 2025**\"}]},{\"name\":\"jobs\",\"catalog_name\":\"system\",\"schema_name\":\"lakeflow\",\"table_type\":\"MANAGED\",\"comment\":\"The `jobs` table is a slow-changing dimension table (SCD2) that contains the full history of job configurations over time. When a row changes, a new row is emitted, logically replacing the previous one. For documentation, example queries, and monitoring usage, see [Lakeflow System Tables](https://docs.databricks.com/en/admin/system-tables/jobs.html#jobs-table-schema).\",\"columns\":[{\"name\":\"account_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"nullable\":true,\"comment\":\"The ID of the account this job belongs to.\"},{\"name\":\"workspace_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":1,\"nullable\":true,\"comment\":\"The ID of the workspace this job belongs to.\"},{\"name\":\"job_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":2,\"nullable\":true,\"comment\":\"The ID of the job. Only unique within a single workspace.\"},{\"name\":\"name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":3,\"nullable\":true,\"comment\":\"The user-supplied name of the job.\"},{\"name\":\"creator_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":4,\"nullable\":true,\"comment\":\"The ID of the principal who created the job.\"},{\"name\":\"tags\",\"type_text\":\"map\\u003cstring,string\\u003e\",\"type_name\":\"MAP\",\"position\":5,\"nullable\":true,\"comment\":\"The user-supplied custom tags associated with this job.\"},{\"name\":\"run_as\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":6,\"nullable\":true,\"comment\":\"The ID of the user or service principal whose permissions are used for the job run.\"},{\"name\":\"change_time\",\"type_text\":\"timestamp\",\"type_name\":\"TIMESTAMP\",\"position\":7,\"nullable\":true,\"comment\":\"The time when the job was last modified. Timezone recorded as +00:00 (UTC).\"},{\"name\":\"delete_time\",\"type_text\":\"timestamp\",\"type_name\":\"TIMESTAMP\",\"position\":8,\"nullable\":true,\"comment\":\"The time when the job was deleted by the user. Timezone recorded as +00:00 (UTC).\"},{\"name\":\"description\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":9,\"nullable\":true,\"comment\":\"The user-supplied description of the job. **Not populated for rows emitted before late August 2024.**\"},{\"name\":\"trigger\",\"type_text\":\"struct\\u003cfile_arrival:struct\\u003curl:string,min_time_between_triggers_seconds:int,wait_after_last_change_seconds:int\\u003e,periodic:struct\\u003cinterval:int,units:string\\u003e,continuous:struct\\u003cenabled:boolean\\u003e,table_update:struct\\u003ctable_names:array\\u003cstring\\u003e,min_time_between_triggers_seconds:bigint,wait_after_last_change_seconds:bigint,condition:string\\u003e,schedule:struct\\u003cquartz_cron_expression:string,timezone_id:string\\u003e,paused:boolean,job_completion:struct\\u003cmonitored_jobs:array\\u003cstruct\\u003cworkspace_id:string,job_id:string\\u003e\\u003e,if_status:string\\u003e\\u003e\",\"type_name\":\"STRUCT\",\"position\":10,\"nullable\":true,\"comment\":\"The trigger configuration for the job. **Not populated for rows emitted before late November 2025**\"},{\"name\":\"trigger_type\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":11,\"nullable\":true,\"comment\":\"The type of trigger for the job. `MULTIPLE` indicates the job has 2 or more triggers; in that case the singular `trigger` column is NULL and `triggers` carries every trigger. **Not populated for rows emitted before late November 2025**\"},{\"name\":\"run_as_user_name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":12,\"nullable\":true,\"comment\":\"The email/ID of the service principal or group name whose permissions are used for the job run. **Not populated for rows emitted before late November 2025**\"},{\"name\":\"creator_user_name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":13,\"nullable\":true,\"comment\":\"The email/ID of the service principal or group name who created the job. **Not populated for rows emitted before late November 2025**\"},{\"name\":\"paused\",\"type_text\":\"boolean\",\"type_name\":\"BOOLEAN\",\"position\":14,\"nullable\":true,\"comment\":\"Indicates whether the job is paused. **Not populated for rows emitted before late November 2025**\"},{\"name\":\"timeout_seconds\",\"type_text\":\"bigint\",\"type_name\":\"LONG\",\"position\":15,\"nullable\":true,\"comment\":\"The timeout duration for the job in seconds. **Not populated for rows emitted before late November 2025**\"},{\"name\":\"health_rules\",\"type_text\":\"array\\u003cstruct\\u003cmetric:string,operator:string,value:bigint\\u003e\\u003e\",\"type_name\":\"ARRAY\",\"position\":16,\"nullable\":true,\"comment\":\"Set of health rules defined for this job. **Not populated for rows emitted before late November 2025**\"},{\"name\":\"deployment\",\"type_text\":\"struct\\u003ckind:string,metadata_file_path:string\\u003e\",\"type_name\":\"STRUCT\",\"position\":17,\"nullable\":true,\"comment\":\"Deployment information for jobs managed by external sources. **Not populated for rows emitted before late November 2025**\"},{\"name\":\"create_time\",\"type_text\":\"timestamp\",\"type_name\":\"TIMESTAMP\",\"position\":18,\"nullable\":true,\"comment\":\"The time at which this job was created. Timezone recorded as +00:00 (UTC). **Not populated for rows emitted before late November 2025**\"},{\"name\":\"triggers\",\"type_text\":\"array\\u003cstruct\\u003cfile_arrival:struct\\u003curl:string,min_time_between_triggers_seconds:int,wait_after_last_change_seconds:int\\u003e,periodic:struct\\u003cinterval:int,units:string\\u003e,table_update:struct\\u003ctable_names:array\\u003cstring\\u003e,min_time_between_triggers_seconds:bigint,wait_after_last_change_seconds:bigint,condition:string\\u003e,continuous:struct\\u003cenabled:boolean\\u003e,schedule:struct\\u003cquartz_cron_expression:string,timezone_id:string\\u003e,paused:boolean,job_completion:struct\\u003cmonitored_jobs:array\\u003cstruct\\u003cworkspace_id:string,job_id:string\\u003e\\u003e,if_status:string\\u003e\\u003e\\u003e\",\"type_name\":\"ARRAY\",\"position\":19,\"nullable\":true,\"comment\":\"The full set of trigger configurations for the job, as an array. Each element mirrors the singular `trigger` struct. Always populated alongside `trigger` for jobs with one trigger, and is the only source of truth for jobs with multiple triggers (where `trigger_type` is `MULTIPLE` and `trigger` is NULL). **Not populated for rows emitted before mid 2026**\"}]},{\"name\":\"pipeline_update_timeline\",\"catalog_name\":\"system\",\"schema_name\":\"lakeflow\",\"table_type\":\"MANAGED\",\"comment\":\"The `pipeline_update_timeline` table is a fact table that contains slices of ongoing pipeline updates, allowing one to track the execution time and metadata related to each pipeline update. Each slice is represented by `period_start_time` and `period_end_time` timestamps.\",\"columns\":[{\"name\":\"workspace_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"nullable\":true,\"comment\":\"The ID of the workspace this pipeline belongs to.\"},{\"name\":\"pipeline_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":1,\"nullable\":true,\"comment\":\"The ID of the pipeline. Unique within a workspace.\"},{\"name\":\"update_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":2,\"nullable\":true,\"comment\":\"The ID of the pipeline update.\"},{\"name\":\"update_type\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":3,\"nullable\":true,\"comment\":\"The type of the pipeline update.\"},{\"name\":\"request_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":4,\"nullable\":true,\"comment\":\"The ID of the request. Helps to understand how many times an update had to be retried/restarted.\"},{\"name\":\"run_as_user_name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":5,\"nullable\":true,\"comment\":\"The email/ID of the service principal or group name whose permissions are used for the pipeline update.\"},{\"name\":\"trigger_type\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":6,\"nullable\":true,\"comment\":\"What triggered this update.\"},{\"name\":\"trigger_details\",\"type_text\":\"struct\\u003cjob_task:struct\\u003cjob_id:string,job_task_run_id:string,performance_target:string\\u003e\\u003e\",\"type_name\":\"STRUCT\",\"position\":7,\"nullable\":true,\"comment\":\"The details of the pipeline's trigger.\"},{\"name\":\"result_state\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":8,\"nullable\":true,\"comment\":\"The outcome of the pipeline update.\"},{\"name\":\"compute\",\"type_text\":\"struct\\u003ctype:string,cluster_id:string\\u003e\",\"type_name\":\"STRUCT\",\"position\":9,\"nullable\":true,\"comment\":\"Details about the compute resource used in the pipeline update.\"},{\"name\":\"period_start_time\",\"type_text\":\"timestamp\",\"type_name\":\"TIMESTAMP\",\"position\":10,\"nullable\":true,\"comment\":\"The start time for the pipeline update or for the hour. The value is stored as a UTC timestamp.\"},{\"name\":\"period_end_time\",\"type_text\":\"timestamp\",\"type_name\":\"TIMESTAMP\",\"position\":11,\"nullable\":true,\"comment\":\"The end time for the pipeline update or for the hour. The value is stored as a UTC timestamp.\"},{\"name\":\"refresh_selection\",\"type_text\":\"array\\u003cstruct\\u003ctable_catalog:string,table_schema:string,table_name:string\\u003e\\u003e\",\"type_name\":\"ARRAY\",\"position\":12,\"nullable\":true,\"comment\":\"A list of tables to update without fullRefresh.\"},{\"name\":\"full_refresh_selection\",\"type_text\":\"array\\u003cstruct\\u003ctable_catalog:string,table_schema:string,table_name:string\\u003e\\u003e\",\"type_name\":\"ARRAY\",\"position\":13,\"nullable\":true,\"comment\":\"A list of tables to update with fullRefresh.\"},{\"name\":\"reset_checkpoint_selection\",\"type_text\":\"array\\u003cstring\\u003e\",\"type_name\":\"ARRAY\",\"position\":14,\"nullable\":true,\"comment\":\"A list of streaming flows to clear the checkpoints for.\"},{\"name\":\"account_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":15,\"nullable\":true,\"comment\":\"The ID of the account this pipeline belongs to.\"}]},{\"name\":\"pipelines\",\"catalog_name\":\"system\",\"schema_name\":\"lakeflow\",\"table_type\":\"MANAGED\",\"comment\":\"The `pipelines` table is a slow-changing dimension table (SCD2) that contains the full history of pipeline configurations over time. When a row changes, a new row is emitted, logically replacing the previous one.\",\"columns\":[{\"name\":\"workspace_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"nullable\":true,\"comment\":\"The ID of the workspace this pipeline belongs to.\"},{\"name\":\"pipeline_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":1,\"nullable\":true,\"comment\":\"The ID of the pipeline.\"},{\"name\":\"pipeline_type\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":2,\"nullable\":true,\"comment\":\"The type of pipeline.\"},{\"name\":\"name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":3,\"nullable\":true,\"comment\":\"The user-supplied name of the pipeline.\"},{\"name\":\"created_by\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":4,\"nullable\":true,\"comment\":\"The email/ID of the service principal or group name who created the pipeline.\"},{\"name\":\"run_as\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":5,\"nullable\":true,\"comment\":\"The email/ID of the service principal or group name whose permissions are used for the pipeline run.\"},{\"name\":\"tags\",\"type_text\":\"map\\u003cstring,string\\u003e\",\"type_name\":\"MAP\",\"position\":6,\"nullable\":true,\"comment\":\"The user-supplied tags associated with the pipeline.\"},{\"name\":\"settings\",\"type_text\":\"struct\\u003cphoton:boolean,development:boolean,continuous:boolean,serverless:boolean,edition:string,channel:string\\u003e\",\"type_name\":\"STRUCT\",\"position\":7,\"nullable\":true,\"comment\":\"The settings of the pipeline.\"},{\"name\":\"configuration\",\"type_text\":\"map\\u003cstring,string\\u003e\",\"type_name\":\"MAP\",\"position\":8,\"nullable\":true,\"comment\":\"The user-supplied configuration of the pipeline.\"},{\"name\":\"change_time\",\"type_text\":\"timestamp\",\"type_name\":\"TIMESTAMP\",\"position\":9,\"nullable\":true,\"comment\":\"The time when the pipeline was last modified. Timezone recorded as +00:00 (UTC).\"},{\"name\":\"delete_time\",\"type_text\":\"timestamp\",\"type_name\":\"TIMESTAMP\",\"position\":10,\"nullable\":true,\"comment\":\"The time when a pipeline was deleted by the user. Timezone recorded as +00:00 (UTC).\"},{\"name\":\"account_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":11,\"nullable\":true,\"comment\":\"The ID of the account this pipeline belongs to.\"},{\"name\":\"create_time\",\"type_text\":\"timestamp\",\"type_name\":\"TIMESTAMP\",\"position\":12,\"nullable\":true,\"comment\":\"The time when a pipeline was created by the user. Timezone recorded as +00:00 (UTC). **Not populated for rows emitted before late November 2025**\"}]},{\"name\":\"zerobus_ingest\",\"catalog_name\":\"system\",\"schema_name\":\"lakeflow\",\"table_type\":\"MANAGED\",\"comment\":\"A table that stores all data related to records ingested using Zerobus Ingest\",\"columns\":[{\"name\":\"commit_version\",\"type_text\":\"bigint\",\"type_name\":\"LONG\",\"nullable\":true,\"comment\":\"Unique version number of a commit to the delta table\"},{\"name\":\"stream_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":1,\"nullable\":true,\"comment\":\"ID of the stream that performed the ingestion\"},{\"name\":\"workspace_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":2,\"nullable\":true,\"comment\":\"ID of the workspace that the stream is created in\"},{\"name\":\"account_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":3,\"nullable\":true,\"comment\":\"ID of the account that owns the given workspace\"},{\"name\":\"table_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":4,\"nullable\":true,\"comment\":\"ID of the table that is being written into\"},{\"name\":\"table_name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":5,\"nullable\":true,\"comment\":\"Fully qualified table name in human readable format\"},{\"name\":\"commit_time\",\"type_text\":\"timestamp\",\"type_name\":\"TIMESTAMP\",\"position\":6,\"nullable\":true,\"comment\":\"Time of the commit\"},{\"name\":\"committed_bytes\",\"type_text\":\"bigint\",\"type_name\":\"LONG\",\"position\":7,\"nullable\":true,\"comment\":\"Size of the ingested data in Bytes\"},{\"name\":\"committed_records\",\"type_text\":\"bigint\",\"type_name\":\"LONG\",\"position\":8,\"nullable\":true,\"comment\":\"Number of committed records\"},{\"name\":\"tags\",\"type_text\":\"array\\u003cstring\\u003e\",\"type_name\":\"ARRAY\",\"position\":9,\"nullable\":true,\"comment\":\"Custom tags for tracking usage origin and other metadata\"},{\"name\":\"errors\",\"type_text\":\"array\\u003cstruct\\u003cerror_code:bigint,error_message:string,timestamp:timestamp\\u003e\\u003e\",\"type_name\":\"ARRAY\",\"position\":10,\"nullable\":true,\"comment\":\"The errors that occurred while using the stream\"}]},{\"name\":\"zerobus_stream\",\"catalog_name\":\"system\",\"schema_name\":\"lakeflow\",\"table_type\":\"MANAGED\",\"comment\":\"A table that stores all data related to stream events incurred by Zerobus Ingest usage\",\"columns\":[{\"name\":\"stream_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"nullable\":true,\"comment\":\"ID of the created stream\"},{\"name\":\"event_time\",\"type_text\":\"timestamp\",\"type_name\":\"TIMESTAMP\",\"position\":1,\"nullable\":true,\"comment\":\"Time of log event\"},{\"name\":\"workspace_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":2,\"nullable\":true,\"comment\":\"ID of the workspace that the stream is created in\"},{\"name\":\"account_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":3,\"nullable\":true,\"comment\":\"ID of the account that owns the given workspace\"},{\"name\":\"producer_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":4,\"nullable\":true,\"comment\":\"Custom ID of the client producer application used to ingest data\"},{\"name\":\"opened_time\",\"type_text\":\"timestamp\",\"type_name\":\"TIMESTAMP\",\"position\":5,\"nullable\":true,\"comment\":\"Time of opening the stream\"},{\"name\":\"closed_time\",\"type_text\":\"timestamp\",\"type_name\":\"TIMESTAMP\",\"position\":6,\"nullable\":true,\"comment\":\"Time of closing the stream\"},{\"name\":\"table_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":7,\"nullable\":true,\"comment\":\"ID of the table that is being written into\"},{\"name\":\"table_name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":8,\"nullable\":true,\"comment\":\"Fully qualified table name in human readable format\"},{\"name\":\"protocol\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":9,\"nullable\":true,\"comment\":\"Protocol used for data ingestion\"},{\"name\":\"data_format\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":10,\"nullable\":true,\"comment\":\"Data format used for passing data\"},{\"name\":\"errors\",\"type_text\":\"array\\u003cstruct\\u003cerror_code:bigint,error_message:string,timestamp:timestamp\\u003e\\u003e\",\"type_name\":\"ARRAY\",\"position\":11,\"nullable\":true,\"comment\":\"The errors that occurred while using the stream\"}]}]}"}
