| {"status":200,"contentType":"application/json","body":"{\"tables\":[{\"name\":\"experiments_latest\",\"catalog_name\":\"system\",\"schema_name\":\"mlflow\",\"table_type\":\"MANAGED\",\"comment\":\"Each row represents an experiment created in the databricks managed MLflow system. An experiment represents a user defined collection of model training runs\",\"columns\":[{\"name\":\"account_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"nullable\":true,\"comment\":\"The ID of the account containing the MLflow experiment\"},{\"name\":\"update_time\",\"type_text\":\"timestamp\",\"type_name\":\"TIMESTAMP\",\"position\":1,\"nullable\":true,\"comment\":\"The system time when the experiment was last updated\"},{\"name\":\"delete_time\",\"type_text\":\"timestamp\",\"type_name\":\"TIMESTAMP\",\"position\":2,\"nullable\":true,\"comment\":\"The system time when the MLflow experiment was soft-deleted by the user\"},{\"name\":\"workspace_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":3,\"nullable\":true,\"comment\":\"The ID of the workspace containing the MLflow experiment\"},{\"name\":\"experiment_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":4,\"nullable\":true,\"comment\":\"The ID of the MLflow experiment\"},{\"name\":\"name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":5,\"nullable\":true,\"comment\":\"User-provided name of the experiment\"},{\"name\":\"create_time\",\"type_text\":\"timestamp\",\"type_name\":\"TIMESTAMP\",\"position\":6,\"nullable\":true,\"comment\":\"The system time when the experiment was created\"}]},{\"name\":\"run_metrics_history\",\"catalog_name\":\"system\",\"schema_name\":\"mlflow\",\"table_type\":\"MANAGED\",\"comment\":\"Holds the timeseries metrics logged to MLflow associated with a given model training, evaluation, or agent development. Each row represents one datapoint in the metric timeseries.\",\"columns\":[{\"name\":\"account_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"nullable\":true,\"comment\":\"The ID of the account containing the MLflow run to which the metric was logged\"},{\"name\":\"insert_time\",\"type_text\":\"timestamp\",\"type_name\":\"TIMESTAMP\",\"position\":1,\"nullable\":true,\"comment\":\"The system time when the metric was inserted\"},{\"name\":\"record_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":2,\"nullable\":true,\"comment\":\"A unique identifier of the metric to distinguish between identical values\"},{\"name\":\"workspace_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":3,\"nullable\":true,\"comment\":\"The ID of the workspace containing the MLflow run to which the metric was logged\"},{\"name\":\"experiment_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":4,\"nullable\":true,\"comment\":\"The ID of the MLflow experiment containing the MLflow run to which the metric was logged\"},{\"name\":\"run_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":5,\"nullable\":true,\"comment\":\"The ID of the MLflow run to which the metric was logged\"},{\"name\":\"metric_name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":6,\"nullable\":true,\"comment\":\"The metric name\"},{\"name\":\"metric_time\",\"type_text\":\"timestamp\",\"type_name\":\"TIMESTAMP\",\"position\":7,\"nullable\":true,\"comment\":\"The user-specified time when the metric was computed\"},{\"name\":\"metric_step\",\"type_text\":\"bigint\",\"type_name\":\"LONG\",\"position\":8,\"nullable\":true,\"comment\":\"The step (e.g. epoch) of model training or agent development at which the metric was logged\"},{\"name\":\"metric_value\",\"type_text\":\"double\",\"type_name\":\"DOUBLE\",\"position\":9,\"nullable\":true,\"comment\":\"The metric value\"}]},{\"name\":\"runs_latest\",\"catalog_name\":\"system\",\"schema_name\":\"mlflow\",\"table_type\":\"MANAGED\",\"comment\":\"Each row represents a run created in the databricks managed MLflow system. A run holds metadata associated with a model training, agent development, or evaluation. This table holds the summary information on each run, not the entire history. For metrics, you can consult run_metrics_history to see the complete logged time series.\",\"columns\":[{\"name\":\"account_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"nullable\":true,\"comment\":\"The ID of the account containing the MLflow run\"},{\"name\":\"update_time\",\"type_text\":\"timestamp\",\"type_name\":\"TIMESTAMP\",\"position\":1,\"nullable\":true,\"comment\":\"The system time when the run was last updated\"},{\"name\":\"delete_time\",\"type_text\":\"timestamp\",\"type_name\":\"TIMESTAMP\",\"position\":2,\"nullable\":true,\"comment\":\"The system time when the MLflow run was soft-deleted by the user\"},{\"name\":\"workspace_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":3,\"nullable\":true,\"comment\":\"The ID of the workspace containing the MLflow run\"},{\"name\":\"run_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":4,\"nullable\":true,\"comment\":\"The ID of the MLflow run\"},{\"name\":\"experiment_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":5,\"nullable\":true,\"comment\":\"The ID of the MLflow experiment containing the MLflow run\"},{\"name\":\"created_by\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":6,\"nullable\":true,\"comment\":\"The name of the Databricks principal, user, or group that created the MLflow run.\"},{\"name\":\"start_time\",\"type_text\":\"timestamp\",\"type_name\":\"TIMESTAMP\",\"position\":7,\"nullable\":true,\"comment\":\"The user-specified time when the MLflow run started\"},{\"name\":\"end_time\",\"type_text\":\"timestamp\",\"type_name\":\"TIMESTAMP\",\"position\":8,\"nullable\":true,\"comment\":\"The user-specified time when the MLflow run ended\"},{\"name\":\"run_name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":9,\"nullable\":true,\"comment\":\"The name of the MLflow run\"},{\"name\":\"status\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":10,\"nullable\":true,\"comment\":\"The execution status of the MLflow run\"},{\"name\":\"params\",\"type_text\":\"map\\u003cstring,string\\u003e\",\"type_name\":\"MAP\",\"position\":11,\"nullable\":true,\"comment\":\"Key-value parameters of the MLflow run\"},{\"name\":\"tags\",\"type_text\":\"map\\u003cstring,string\\u003e\",\"type_name\":\"MAP\",\"position\":12,\"nullable\":true,\"comment\":\"Key-value tags set on the MLflow run\"},{\"name\":\"aggregated_metrics\",\"type_text\":\"array\\u003cstruct\\u003cmetric_name:string,min_value:double,max_value:double,latest_value:double\\u003e\\u003e\",\"type_name\":\"ARRAY\",\"position\":13,\"nullable\":true,\"comment\":\"An aggregated view summarizing the metrics in the run_metrics_history\"}]}]}"}
