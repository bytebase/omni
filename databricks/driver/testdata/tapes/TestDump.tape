ved by vacuum.\"},{\"name\":\"time_travel_bytes\",\"type_text\":\"bigint\",\"type_name\":\"LONG\",\"position\":20,\"nullable\":true,\"comment\":\"Size of data retained for time travel, in bytes.\"},{\"name\":\"time_travel_files\",\"type_text\":\"bigint\",\"type_name\":\"LONG\",\"position\":21,\"nullable\":true,\"comment\":\"Number of files retained for time travel.\"},{\"name\":\"metric_type\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":22,\"nullable\":true,\"comment\":\"How the storage metrics in this row were produced. CALCULATED means derived from a full table scan; ESTIMATED means derived from a cheaper heuristic path.\"}]}]}"}
