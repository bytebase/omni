| {"status":200,"contentType":"application/json","body":"{\"tables\":[{\"name\":\"endpoint_usage\",\"catalog_name\":\"system\",\"schema_name\":\"serving\",\"table_type\":\"MANAGED\",\"comment\":\"This system table records per request usage information for model serving. For instance, it can be used to attribute how many LLM tokens were sent to different served entities. To look up more information about the served entity that received the request, use the served_entity_id as the join key with system.serving.served_entities.\",\"columns\":[{\"name\":\"workspace_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"nullable\":true,\"comment\":\"The workspace ID for the workspace in which the serving endpoint exists.\"},{\"name\":\"account_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":1,\"nullable\":true,\"comment\":\"The Databricks account ID of the workspace associated with the serving endpoint.\"},{\"name\":\"client_request_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":2,\"nullable\":true,\"comment\":\"The user provided request identifier that can be specified in the model serving request body.\"},{\"name\":\"databricks_request_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":3,\"nullable\":true,\"comment\":\"A Databricks generated request identifier attached to all model serving requests.\"},{\"name\":\"requester\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":4,\"nullable\":true,\"comment\":\"The name or email of the user or service principal whose permissions are used for the invocation request of the serving endpoint.\"},{\"name\":\"status_code\",\"type_text\":\"int\",\"type_name\":\"INT\",\"position\":5,\"nullable\":true,\"comment\":\"The HTTP status code that was returned from the model.\"},{\"name\":\"request_time\",\"type_text\":\"timestamp\",\"type_name\":\"TIMESTAMP\",\"position\":6,\"nullable\":true,\"comment\":\"The timestamp at which the request is received.\"},{\"name\":\"input_token_count\",\"type_text\":\"bigint\",\"type_name\":\"LONG\",\"position\":7,\"nullable\":true,\"comment\":\"The token count of the input.\"},{\"name\":\"output_token_count\",\"type_text\":\"bigint\",\"type_name\":\"LONG\",\"position\":8,\"nullable\":true,\"comment\":\"The token count of the output.\"},{\"name\":\"input_character_count\",\"type_text\":\"bigint\",\"type_name\":\"LONG\",\"position\":9,\"nullable\":true,\"comment\":\"The character count of the input string or prompt.\"},{\"name\":\"output_character_count\",\"type_text\":\"bigint\",\"type_name\":\"LONG\",\"position\":10,\"nullable\":true,\"comment\":\"The character count of the output string of the response.\"},{\"name\":\"usage_context\",\"type_text\":\"map\\u003cstring,string\\u003e\",\"type_name\":\"MAP\",\"position\":11,\"nullable\":true,\"comment\":\"The user provided map containing identifiers of the end user or the customer application that makes the call to the endpoint. See [Further define usage with usage_context](https://docs.databricks.com/en/ai-gateway/configure-ai-gateway-endpoints.html#usage-context).\"},{\"name\":\"request_streaming\",\"type_text\":\"boolean\",\"type_name\":\"BOOLEAN\",\"position\":12,\"nullable\":true,\"comment\":\"Whether the request is in stream mode.\"},{\"name\":\"served_entity_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":13,\"nullable\":true,\"comment\":\"The unique ID used to join with the system.serving.served_entities dimension table to lookup information about the endpoint and served entity.\"}]},{\"name\":\"served_entities\",\"catalog_name\":\"system\",\"schema_name\":\"serving\",\"table_type\":\"MANAGED\",\"comment\":\"This system table records all entities that were served through Databricks model serving as well as the configurations at different config versions.\",\"columns\":[{\"name\":\"served_entity_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"nullable\":true,\"comment\":\"The unique ID of the served entity.\"},{\"name\":\"account_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":1,\"nullable\":true,\"comment\":\"The Databricks account ID of the workspace associated with the serving endpoint.\"},{\"name\":\"workspace_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":2,\"nullable\":true,\"comment\":\"The workspace ID for the workspace in which the serving endpoint exists.\"},{\"name\":\"created_by\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":3,\"nullable\":true,\"comment\":\"The name of the creator. Can be a user, service principal, or group name.\"},{\"name\":\"endpoint_name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":4,\"nullable\":true,\"comment\":\"The name of the serving endpoint.\"},{\"name\":\"endpoint_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":5,\"nullable\":true,\"comment\":\"The unique ID of the serving endpoint.\"},{\"name\":\"served_entity_name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":6,\"nullable\":true,\"comment\":\"The name of the served entity.\"},{\"name\":\"entity_type\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":7,\"nullable\":true,\"comment\":\"Type of the entity that is served. Can be FEATURE_SPEC, EXTERNAL_MODEL, FOUNDATION_MODEL, or CUSTOM_MODEL\"},{\"name\":\"entity_name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":8,\"nullable\":true,\"comment\":\"The underlying name of the entity. Different from the served_entity_name which is a user provided name. For example, entity_name is the name of the Unity Catalog model.\"},{\"name\":\"entity_version\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":9,\"nullable\":true,\"comment\":\"The version of the served entity.\"},{\"name\":\"endpoint_config_version\",\"type_text\":\"int\",\"type_name\":\"INT\",\"position\":10,\"nullable\":true,\"comment\":\"The version of the endpoint configuration.\"},{\"name\":\"task\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":11,\"nullable\":true,\"comment\":\"The task type. Can be llm/v1/chat, llm/v1/completions, or llm/v1/embeddings.\"},{\"name\":\"external_model_config\",\"type_text\":\"struct\\u003cprovider:string\\u003e\",\"type_name\":\"STRUCT\",\"position\":12,\"nullable\":true,\"comment\":\"Configurations for external models. For example, {Provider: OpenAI}\"},{\"name\":\"foundation_model_config\",\"type_text\":\"struct\\u003cmin_provisioned_throughput:bigint,max_provisioned_throughput:bigint\\u003e\",\"type_name\":\"STRUCT\",\"position\":13,\"nullable\":true,\"comment\":\"Configurations for foundation models. For example,{min_provisioned_throughput: 2200, max_provisioned_throughput: 4400}\"},{\"name\":\"custom_model_config\",\"type_text\":\"struct\\u003cmin_concurrency:int,max_concurrency:int,compute_type:string\\u003e\",\"type_name\":\"STRUCT\",\"position\":14,\"nullable\":true,\"comment\":\"Configurations for custom models. For example,{ min_concurrency: 0, max_concurrency: 4, compute_type: CPU }\"},{\"name\":\"feature_spec_config\",\"type_text\":\"struct\\u003cmin_concurrency:int,max_concurrency:int,compute_type:string\\u003e\",\"type_name\":\"STRUCT\",\"position\":15,\"nullable\":true,\"comment\":\"Configurations for feature specifications. For example, { min_concurrency: 0, max_concurrency: 4, compute_type: CPU }\"},{\"name\":\"change_time\",\"type_text\":\"timestamp\",\"type_name\":\"TIMESTAMP\",\"position\":16,\"nullable\":true,\"comment\":\"Timestamp of change for the served entity.\"},{\"name\":\"endpoint_delete_time\",\"type_text\":\"timestamp\",\"type_name\":\"TIMESTAMP\",\"position\":17,\"nullable\":true,\"comment\":\"Timestamp of entity deletion. The endpoint is the container for the served entity. After the endpoint is deleted, the served entity is also deleted.\"}]}]}"}
