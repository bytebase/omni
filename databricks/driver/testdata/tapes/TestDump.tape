| {"status":200,"contentType":"application/json","body":"{\"tables\":[{\"name\":\"abac_policy_definitions\",\"catalog_name\":\"workspace\",\"schema_name\":\"information_schema\",\"table_type\":\"VIEW\",\"view_definition\":\"SELECT * FROM system.information_schema.abac_policy_definitions WHERE catalog_name = 'workspace'\",\"comment\":\"Lists ABAC policies with their full authoring metadata.\",\"columns\":[{\"name\":\"policy_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"nullable\":false,\"comment\":\"Unique identifier of the policy.\"},{\"name\":\"policy_name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":1,\"nullable\":false,\"comment\":\"Name of the policy.\"},{\"name\":\"policy_type\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":2,\"nullable\":false,\"comment\":\"The policy type. For example, ROW_FILTER, COLUMN_MASK, GRANT, or DENY.\"},{\"name\":\"catalog_name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":3,\"nullable\":true,\"comment\":\"Name of the catalog the policy is attached to (or that contains the schema/table the policy is attached to).\"},{\"name\":\"schema_name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":4,\"nullable\":true,\"comment\":\"Name of the schema the policy is attached to (or that contains the table the policy is attached to). NULL for CATALOG-attached policies.\"},{\"name\":\"securable_name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":5,\"nullable\":true,\"comment\":\"Name of the securable the policy is attached to. NULL for CATALOG-attached and SCHEMA-attached policies.\"},{\"name\":\"on_securable_type\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":6,\"nullable\":false,\"comment\":\"Type of the securable the policy is attached to. For example, CATALOG, SCHEMA, or TABLE.\"},{\"name\":\"to_principals\",\"type_text\":\"array\\u003cstring\\u003e\",\"type_name\":\"ARRAY\",\"position\":7,\"nullable\":false,\"comment\":\"List 