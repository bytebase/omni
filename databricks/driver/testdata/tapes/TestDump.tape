| {"status":200,"contentType":"application/json","body":"{\"tables\":[{\"name\":\"materialization_history\",\"catalog_name\":\"system\",\"schema_name\":\"sharing\",\"table_type\":\"MANAGED\",\"comment\":\"The materialization history table records all data materializations created for secure sharing purposes.\",\"columns\":[{\"name\":\"sharing_materialization_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"nullable\":true,\"comment\":\"A unique ID for this data materialization.\"},{\"name\":\"account_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":1,\"nullable\":true,\"comment\":\"The ID of the Databricks account where the materialization was created.\"},{\"name\":\"workspace_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":2,\"nullable\":true,\"comment\":\"The ID of the Databricks workspace where the materialization was billed to.\"},{\"name\":\"recipient_name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":3,\"nullable\":true,\"comment\":\"The name of the downstream recipient using the data materialization.\"},{\"name\":\"provider_name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":4,\"nullable\":true,\"comment\":\"The name of the upstream provider using the data materialization.\"},{\"name\":\"share_name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":5,\"nullable\":true,\"comment\":\"Name of share used to create materialization.\"},{\"name\":\"schema_name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":6,\"nullable\":true,\"comment\":\"Name of the schema of the shared asset used to create materialization.\"},{\"name\":\"table_name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":7,\"nullable\":true,\"comment\":\"Name of the table used to create materialization.\"},{\"name\":\"created_at\",\"type_text\":\"timestamp\",\"type_name\":\"TIMESTAMP\",\"position\":8,\"nullable\":true,\"comment\":\"Timestamp of when the materialization was created.\"}]}]}"}
