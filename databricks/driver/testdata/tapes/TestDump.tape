| {"status":200,"contentType":"application/json","body":"{\"tables\":[{\"name\":\"claims_sample_synthetic\",\"catalog_name\":\"samples\",\"schema_name\":\"healthverity\",\"table_type\":\"MANAGED\",\"comment\":\"HealthVerity synchronizes transformational technologies with the nation’s largest healthcare and consumer data ecosystem to power previously unattainable outcomes and fundamentally advance science. HealthVerity offers hundreds of data sources across medical, pharmacy, lab, biomarker, EHR, consumer, and more.\\n\\nThis sample high-fidelity synthetic dataset from HealthVerity represents 1,500+ synthetic patients modeled on de-identified medical and pharmacy claims. **This dataset is intended for educational rather than production purposes, and may be used solely in non-production settings for internal testing, evaluation and/or informational purposes, and may not be relied upon or used for general commercial use**. This is only a synthetic sample dataset meant to illustrate a small portion of the type and volume of Real-world Data that is available within the HealthVerity Marketplace ecosystem. HealthVerity would welcome the opportunity to learn more about your project, and determine the optimal patient data for your objective. For more details on our offerings, please visit our website ([https://www.healthverity.com](https://www.healthverity.com)) or contact us through [https://www.healthverity.com/contact/](https://www.healthverity.com/contact/).\",\"columns\":[{\"name\":\"hvid\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"nullable\":true,\"comment\":\"The HealthVerity universal identifier for the patient, as determined by the HealthVerity matching engine.\"},{\"name\":\"claim_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":1,\"nullable\":true,\"comment\":\"Uniquely identifies a single claim that was submitted for reimbursement by this data vendor.\"},{\"name\":\"claim_type\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":2,\"nullable\":true,\"comment\":\"Indicates whether the claim is a professional (P) or institutional (I) claim.\"},{\"name\":\"date_service\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":3,\"nullable\":true,\"comment\":\"The calendar date on which the services referred to in this claim were rendered. (2400/DTP03, DTP01=472)\"},{\"name\":\"diagnosis_code\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":4,\"nullable\":true,\"comment\":\"A code indicating the patient's disease, injury, or condition, as identified by a healthcare practitioner. (2300/HI(01-12)-02)\"},{\"name\":\"procedure_code\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":5,\"nullable\":true,\"comment\":\"A code indicating the course of action taken by the healthcare practitioner. (837P 2400/SV101-02; 837I 2400/SV201, SV202)\"},{\"name\":\"patient_gender\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":6,\"nullable\":true,\"comment\":\"A single character identifying the gender of the person who received healthcare treatment. F = Female, M = Male, U = Unknown. (2010CA/DMG03)\"},{\"name\":\"patient_year_of_birth\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":7,\"nullable\":true,\"comment\":\"The four-digit year in which the patient was born. (2010CA/DMG02)\"},{\"name\":\"patient_zip3\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":8,\"nullable\":true,\"comment\":\"The first three digits of the U.S. postal code for the residence of the person who received healthcare treatment. If not supplied by the data provider, HealthVerity may populate this field with the first three digits of the postal code for the primary care provider or the rendering provider. (2010CA/N403)\"},{\"name\":\"patient_state\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":9,\"nullable\":true,\"comment\":\"The two-character postal code for the state in which the patient resides. (2010CA/N402)\"},{\"name\":\"inst_admit_type_std_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":10,\"nullable\":true,\"comment\":\"A standard code indicating the priority of this admission or visit. (837I 2300/CL101)\"},{\"name\":\"inst_admit_source_std_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":11,\"nullable\":true,\"comment\":\"A standard code indicating the source of the referral for the admission or visit. (837I 2300/CL102)\"},{\"name\":\"inst_discharge_status_std_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":12,\"nullable\":true,\"comment\":\"A standard code indicating the status of the patient as of the statement end date. (837I 2300/CL103)\"},{\"name\":\"inst_type_of_bill_std_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":13,\"nullable\":true,\"comment\":\"A standard code identifying the type of facility where services were performed. (837I 2300/CLM05-01, CLM05-03)\"},{\"name\":\"inst_drg_std_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":14,\"nullable\":true,\"comment\":\"A standard diagnosis-related group code indicating the payment classification. (837I 2300/HCP06)\"},{\"name\":\"place_of_service_std_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":15,\"nullable\":true,\"comment\":\"A standard code indicating the facility or place where services were rendered, as maintained by the Centers for Medicare and Medicaid Services (CMS). (2400/SV105)\"},{\"name\":\"service_line_number\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":16,\"nullable\":true,\"comment\":\"An integer representing the sequence for this service line within the claim. (2400/LX01)\"},{\"name\":\"diagnosis_code_qual\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":17,\"nullable\":true,\"comment\":\"The type of code used to indicate the disease, injury, or condition. Examples: ICD-10, ICD-9.\"},{\"name\":\"admit_diagnosis_ind\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":18,\"nullable\":true,\"comment\":\"A flag indicating whether the diagnosis reported on an institutional claim represents the admitting diagnosis. (2300/HI01-02)\"},{\"name\":\"procedure_code_qual\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":19,\"nullable\":true,\"comment\":\"The type of code used to indicate the course of action taken by the healthcare practitioner. Examples: CPT, HCPCS. (837P 2400/SV101-01; 837I 2400/SV202-01)\"},{\"name\":\"procedure_units_billed\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":20,\"nullable\":true,\"comment\":\"The number of discrete actions, elements, or precisely measured amounts administered in this course of action. (837P 2400/SV104; 837I 2400/SV205)\"},{\"name\":\"procedure_modifier_1\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":21,\"nullable\":true,\"comment\":\"Identifies the first qualifier for the procedure code. This is a code that supplies additional information about the procedure. (837P 2400/SV101-03; 837I 2400/SV202-03)\"},{\"name\":\"procedure_modifier_2\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":22,\"nullable\":true,\"comment\":\"Identifies the second qualifier for the procedure code. This is a code that supplies additional information about the procedure. (837P 2400/SV101-04; 837I 2400/SV202-04)\"},{\"name\":\"procedure_modifier_3\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":23,\"nullable\":true,\"comment\":\"Identifies the third qualifier for the procedure code. This is a code that supplies additional information about the procedure. (837P 2400/SV101-05; 837I 2400/SV202-05)\"},{\"name\":\"procedure_modifier_4\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":24,\"nullable\":true,\"comment\":\"Identifies the fourth qualifier for the procedure code. This is a code that supplies additional information about the procedure. (837P 2400/SV101-06; 837I 2400/SV202-06)\"},{\"name\":\"revenue_code\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":25,\"nullable\":true,\"comment\":\"A standard NUBC revenue code from the UB claim form. (837I 2400/SV201)\"},{\"name\":\"line_charge\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":26,\"nullable\":true,\"comment\":\"The total amount charged for this service line. (837P 2400/SV102; 837I 2400/SV203)\"},{\"name\":\"line_allowed\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":27,\"nullable\":true,\"comment\":\"The total amount allowed for this service line. (2400/HCP02)\"},{\"name\":\"prov_rendering_npi\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":28,\"nullable\":true,\"comment\":\"The standard National Provider Identifier (NPI) for the provider who rendered services. (837P 2310B-2420A/NM109, NM108=XX; 837I 2310D-2420C/NM109, NM108=XX)\"},{\"name\":\"prov_billing_npi\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":29,\"nullable\":true,\"comment\":\"The standard National Provider Identifier (NPI) for the provider that billed for services. (2010AA/NM109, NM108=XX)\"},{\"name\":\"prov_referring_npi\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":30,\"nullable\":true,\"comment\":\"The standard National Provider Identifier (NPI) for the provider who referred the patient to the rendering provider. (837P 2310A/NM109, NM108=XX; 837I 2310F/NM109, NM108=XX)\"},{\"name\":\"payer_type\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":31,\"nullable\":true,\"comment\":\"A code indicating the classification for the payer.\"},{\"name\":\"prov_rendering_std_taxonomy\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":32,\"nullable\":true,\"comment\":\"The National Uniform Claim Committee (NUCC) standard taxonomy code for the provider who rendered services. (837P 2310B/PRV03; 837I 2310D/PRV03)\"},{\"name\":\"prov_billing_std_taxonomy\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":33,\"nullable\":true,\"comment\":\"The National Uniform Claim Committee (NUCC) standard taxonomy code for the provider who submitted the claim. (2000A/PRV03)\"},{\"name\":\"prov_referring_std_taxonomy\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":34,\"nullable\":true,\"comment\":\"The National Uniform Claim Committee (NUCC) standard taxonomy code for the provider who referred the patient to the rendering provider.\"}]}]}"}
