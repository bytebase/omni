| {"status":200,"contentType":"application/json","body":"{\"tables\":[{\"name\":\"history\",\"catalog_name\":\"system\",\"schema_name\":\"query\",\"table_type\":\"MANAGED\",\"comment\":\"The query history table, located at system.query.history, includes records for every SQL statement run using SQL warehouses. The table includes account-wide records from all workspaces in the same region from which you access the table.\",\"columns\":[{\"name\":\"account_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"nullable\":true,\"comment\":\"ID of the account.\"},{\"name\":\"workspace_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":1,\"nullable\":true,\"comment\":\"The ID of the workspace where the query was run.\"},{\"name\":\"statement_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":2,\"nullable\":true,\"comment\":\"The ID that uniquely identifies the execution of the statement. You can use this ID to find the statement execution in the Query History UI.\"},{\"name\":\"executed_by\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":3,\"nullable\":true,\"comment\":\"The email address or username of the user who ran the statement.\"},{\"name\":\"session_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":4,\"nullable\":true,\"comment\":\"The Spark session ID.\"},{\"name\":\"execution_status\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":5,\"nullable\":true,\"comment\":\"The statement termination state. Possible values are:\\n\\nFINISHED: execution was successful\\n\\nFAILED: execution failed with the reason for failure described in the accompanying error message\\n\\nCANCELED: execution was canceled\"},{\"name\":\"compute\",\"type_text\":\"struct\\u003ctype:string,cluster_id:string,warehouse_id:string\\u003e\",\"type_name\":\"STRUCT\",\"position\":6,\"nullable\":true,\"comment\":\"A struct that represents the type of compute resource used to run the statement and the ID of the resource where applicable. The type value will be WAREHOUSE.\"},{\"name\":\"executed_by_user_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":7,\"nullable\":true,\"comment\":\"The ID of the user who ran the statement.\"},{\"name\":\"statement_text\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":8,\"nullable\":true,\"comment\":\"Text of the SQL statement. If you have configured customer-managed keys, statement_text is empty.\"},{\"name\":\"statement_type\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":9,\"nullable\":true,\"comment\":\"The statement type. For example: ALTER, COPY, and`INSERT`.\"},{\"name\":\"error_message\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":10,\"nullable\":true,\"comment\":\"Message describing the error condition. If you have configured customer-managed keys, error_message is empty.\"},{\"name\":\"client_application\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":11,\"nullable\":true,\"comment\":\"Client application that ran the statement. For example: Databricks SQL, Tableau, and Power BI.\"},{\"name\":\"client_driver\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":12,\"nullable\":true,\"comment\":\"The connector used to connect to Databricks to run the statement. For example: Databricks SQL Driver for Go, Databricks ODBC Driver, Databricks JDBC Driver.\"},{\"name\":\"total_duration_ms\",\"type_text\":\"bigint\",\"type_name\":\"LONG\",\"position\":13,\"nullable\":true,\"comment\":\"Total execution time of the statement in milliseconds ( excluding result fetch time ).\"},{\"name\":\"waiting_for_compute_duration_ms\",\"type_text\":\"bigint\",\"type_name\":\"LONG\",\"position\":14,\"nullable\":true,\"comment\":\"Time spent waiting for compute resources to be provisioned in milliseconds.\"},{\"name\":\"waiting_at_capacity_duration_ms\",\"type_text\":\"bigint\",\"type_name\":\"LONG\",\"position\":15,\"nullable\":true,\"comment\":\"Time spent waiting in queue for available compute capacity in milliseconds.\"},{\"name\":\"execution_duration_ms\",\"type_text\":\"bigint\",\"type_name\":\"LONG\",\"position\":16,\"nullable\":true,\"comment\":\"Time spent executing the statement in milliseconds.\"},{\"name\":\"compilation_duration_ms\",\"type_text\":\"bigint\",\"type_name\":\"LONG\",\"position\":17,\"nullable\":true,\"comment\":\"Time spent loading metadata and optimizing the statement in milliseconds.\"},{\"name\":\"total_task_duration_ms\",\"type_text\":\"bigint\",\"type_name\":\"LONG\",\"position\":18,\"nullable\":true,\"comment\":\"The sum of all task durations in milliseconds. This time represents the combined time it took to run the query across all cores of all nodes. It can be significantly longer than the wall-clock duration if multiple tasks are executed in parallel. It can be shorter than the wall-clock duration if tasks wait for available nodes.\"},{\"name\":\"result_fetch_duration_ms\",\"type_text\":\"bigint\",\"type_name\":\"LONG\",\"position\":19,\"nullable\":true,\"comment\":\"Time spent, in milliseconds, fetching the statement results after the execution finished.\"},{\"name\":\"start_time\",\"type_text\":\"timestamp\",\"type_name\":\"TIMESTAMP\",\"position\":20,\"nullable\":true,\"comment\":\"The time when Databricks received the request. Timezone information is recorded at the end of the value with +00:00 representing UTC.\"},{\"name\":\"end_time\",\"type_text\":\"timestamp\",\"type_name\":\"TIMESTAMP\",\"position\":21,\"nullable\":true,\"comment\":\"The time the statement execution ended, excluding result fetch time. Timezone information is recorded at the end of the value with +00:00 representing UTC.\"},{\"name\":\"update_time\",\"type_text\":\"timestamp\",\"type_name\":\"TIMESTAMP\",\"position\":22,\"nullable\":true,\"comment\":\"The time the statement last received a progress update. Timezone information is recorded at the end of the value with +00:00 representing UTC.\"},{\"name\":\"read_partitions\",\"type_text\":\"bigint\",\"type_name\":\"LONG\",\"position\":23,\"nullable\":true,\"comment\":\"The number of table partitions read after table partition pruning.\"},{\"name\":\"pruned_files\",\"type_text\":\"bigint\",\"type_name\":\"LONG\",\"position\":24,\"nullable\":true,\"comment\":\"The number of pruned files during table partition and file pruning.\"},{\"name\":\"read_files\",\"type_text\":\"bigint\",\"type_name\":\"LONG\",\"position\":25,\"nullable\":true,\"comment\":\"The number of files read after table partition and file pruning.\"},{\"name\":\"read_rows\",\"type_text\":\"bigint\",\"type_name\":\"LONG\",\"position\":26,\"nullable\":true,\"comment\":\"The number of rows output from scans after table partition, file, in file and row pruning.\"},{\"name\":\"produced_rows\",\"type_text\":\"bigint\",\"type_name\":\"LONG\",\"position\":27,\"nullable\":true,\"comment\":\"Total number of rows returned by the statement.\"},{\"name\":\"read_bytes\",\"type_text\":\"bigint\",\"type_name\":\"LONG\",\"position\":28,\"nullable\":true,\"comment\":\"The number of bytes of files read after IO pruning.\"},{\"name\":\"read_io_cache_percent\",\"type_text\":\"tinyint\",\"type_name\":\"BYTE\",\"position\":29,\"nullable\":true,\"comment\":\"The percentage of bytes of persistent data read from the IO cache.\"},{\"name\":\"from_result_cache\",\"type_text\":\"boolean\",\"type_name\":\"BOOLEAN\",\"position\":30,\"nullable\":true,\"comment\":\"TRUE indicates that the statement result was fetched from the cache.\"},{\"name\":\"spilled_local_bytes\",\"type_text\":\"bigint\",\"type_name\":\"LONG\",\"position\":31,\"nullable\":true,\"comment\":\"Size of data, in bytes, temporarily written to disk while executing the statement.\"},{\"name\":\"written_bytes\",\"type_text\":\"bigint\",\"type_name\":\"LONG\",\"position\":32,\"nullable\":true,\"comment\":\"The size in bytes of persistent data written to cloud object storage.\"},{\"name\":\"shuffle_read_bytes\",\"type_text\":\"bigint\",\"type_name\":\"LONG\",\"position\":33,\"nullable\":true,\"comment\":\"The total amount of data in bytes sent over the network.\"},{\"name\":\"query_source\",\"type_text\":\"struct\\u003cjob_info:struct\\u003cjob_id:string,job_run_id:string,job_task_run_id:string\\u003e,legacy_dashboard_id:string,dashboard_id:string,alert_id:string,notebook_id:string,sql_query_id:string,genie_space_id:string,pipeline_info:struct\\u003cpipeline_id:string,update_id:string\\u003e\\u003e\",\"type_name\":\"STRUCT\",\"position\":34,\"nullable\":true,\"comment\":\"A struct that contains key-value pairs representing one or more Databricks entities that were involved in the execution of this statement, such as jobs, notebooks, or dashboards. This field only records Databricks entities and are not sorted by execution order. Statement executions that contain multiple IDs indicate that the execution was triggered by multiple entities: for example, an Alert may trigger on a Job result and call a SQL Query, so all three IDs will be populated within query_source.\"},{\"name\":\"executed_as_user_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":35,\"nullable\":true,\"comment\":\"The ID of the user or service principal whose privilege was used to run the statement.\"},{\"name\":\"executed_as\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":36,\"nullable\":true,\"comment\":\"The name of the user or service principal whose privilege was used to run the statement.\"},{\"name\":\"written_rows\",\"type_text\":\"bigint\",\"type_name\":\"LONG\",\"position\":37,\"nullable\":true,\"comment\":\"Total number of rows of persistent data written to cloud object storage.\"},{\"name\":\"written_files\",\"type_text\":\"bigint\",\"type_name\":\"LONG\",\"position\":38,\"nullable\":true,\"comment\":\"The number of files of persistent data written to cloud object storage.\"},{\"name\":\"cache_origin_statement_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":39,\"nullable\":true,\"comment\":\"Statement id of query that inserted result in cache when result is fetched from cache, otherwise store the query's statement id.\"},{\"name\":\"query_parameters\",\"type_text\":\"struct\\u003cnamed_parameters:map\\u003cstring,struct\\u003cexprs:array\\u003cstruct\\u003ctag:string,data_type:struct\\u003ctype_name:string,type_ddl:string,redacted_type_ddl:string\\u003e,literal:struct\\u003cdata_type:struct\\u003ctype_name:string,type_ddl:string,redacted_type_ddl:string\\u003e,int_value:int,long_value:bigint,double_value:double,float_value:float,byte_value:int,short_value:int,string_value:string,boolean_value:boolean,decimal_value:struct\\u003cvalue:string,precision:int,scale:int\\u003e,binary_value:binary,timestamp_value:bigint,timestamp_ntz_value:bigint,date_value:bigint,calendar_interval_value:struct\\u003cmonths:int,days:int,microseconds:bigint\\u003e,day_time_interval_value:bigint,year_month_interval_value:int\\u003e,seq_expression:struct\\u003cchildren:array\\u003cbigint\\u003e\\u003e,function:struct\\u003cfunction_name:string,arguments:array\\u003cbigint\\u003e\\u003e,alias:struct\\u003cexpr:bigint,name:array\\u003cstring\\u003e,metadata:string\\u003e,sort_order:struct\\u003cchild:bigint,direction:string,null_ordering:string\\u003e,lambda_function:struct\\u003cfunction:bigint,arguments:array\\u003cstruct\\u003cname_parts:array\\u003cstring\\u003e\\u003e\\u003e\\u003e,window:struct\\u003cwindow_function:bigint,partition_spec:array\\u003cbigint\\u003e,order_spec:array\\u003cbigint\\u003e\\u003e,unresolved_extract_value:struct\\u003cchild:bigint,extraction:bigint\\u003e,update_fields:struct\\u003cstruct_expression:bigint,field_name:string,value_expression:bigint\\u003e,unresolved_named_lambda_variable:struct\\u003cname_parts:array\\u003cstring\\u003e\\u003e,named_argument_expression:struct\\u003ckey:string,value:bigint\\u003e,id:bigint\\u003e\\u003e\\u003e\\u003e,pos_parameters:array\\u003cstruct\\u003cexprs:array\\u003cstruct\\u003ctag:string,data_type:struct\\u003ctype_name:string,type_ddl:string,redacted_type_ddl:string\\u003e,literal:struct\\u003cdata_type:struct\\u003ctype_name:string,type_ddl:string,redacted_type_ddl:string\\u003e,int_value:int,long_value:bigint,double_value:double,float_value:float,byte_value:int,short_value:int,string_value:string,boolean_value:boolean,decimal_value:struct\\u003cvalue:string,precision:int,scale:int\\u003e,binary_value:binary,timestamp_value:bigint,timestamp_ntz_value:bigint,date_value:bigint,calendar_interval_value:struct\\u003cmonths:int,days:int,microseconds:bigint\\u003e,day_time_interval_value:bigint,year_month_interval_value:int\\u003e,seq_expression:struct\\u003cchildren:array\\u003cbigint\\u003e\\u003e,function:struct\\u003cfunction_name:string,arguments:array\\u003cbigint\\u003e\\u003e,alias:struct\\u003cexpr:bigint,name:array\\u003cstring\\u003e,metadata:string\\u003e,sort_order:struct\\u003cchild:bigint,direction:string,null_ordering:string\\u003e,lambda_function:struct\\u003cfunction:bigint,arguments:array\\u003cstruct\\u003cname_parts:array\\u003cstring\\u003e\\u003e\\u003e\\u003e,window:struct\\u003cwindow_function:bigint,partition_spec:array\\u003cbigint\\u003e,order_spec:array\\u003cbigint\\u003e\\u003e,unresolved_extract_value:struct\\u003cchild:bigint,extraction:bigint\\u003e,update_fields:struct\\u003cstruct_expression:bigint,field_name:string,value_expression:bigint\\u003e,unresolved_named_lambda_variable:struct\\u003cname_parts:array\\u003cstring\\u003e\\u003e,named_argument_expression:struct\\u003ckey:string,value:bigint\\u003e,id:bigint\\u003e\\u003e\\u003e\\u003e,truncated:boolean\\u003e\",\"type_name\":\"STRUCT\",\"position\":40,\"nullable\":true,\"comment\":\"Query parameters values associated with the query. Only one of named_parameters or pos_parameters can be populated.\"},{\"name\":\"query_tags\",\"type_text\":\"map\\u003cstring,string\\u003e\",\"type_name\":\"MAP\",\"position\":41,\"nullable\":true,\"comment\":\"The user-supplied custom tags associated with this statement execution.\"},{\"name\":\"pruned_files_bytes\",\"type_text\":\"bigint\",\"type_name\":\"LONG\",\"position\":42,\"nullable\":true,\"comment\":\"The number of bytes of files pruned after table partition and file pruning.\"},{\"name\":\"read_files_bytes\",\"type_text\":\"bigint\",\"type_name\":\"LONG\",\"position\":43,\"nullable\":true,\"comment\":\"The number of bytes of files read after table partition and file pruning.\"}]}]}"}
