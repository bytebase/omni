| {"status":200,"contentType":"application/json","body":"{\"tables\":[{\"name\":\"abac_policy_definitions\",\"catalog_name\":\"system\",\"schema_name\":\"information_schema\",\"table_type\":\"EXTERNAL\",\"comment\":\"Lists ABAC policies with their full authoring metadata.\",\"columns\":[{\"name\":\"policy_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"nullable\":false,\"comment\":\"Unique identifier of the policy.\"},{\"name\":\"policy_name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":1,\"nullable\":false,\"comment\":\"Name of the policy.\"},{\"name\":\"policy_type\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":2,\"nullable\":false,\"comment\":\"The policy type. For example, ROW_FILTER, COLUMN_MASK, GRANT, or DENY.\"},{\"name\":\"catalog_name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":3,\"nullable\":true,\"comment\":\"Name of the catalog the policy is attached to (or that contains the schema/table the policy is attached to).\"},{\"name\":\"schema_name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":4,\"nullable\":true,\"comment\":\"Name of the schema the policy is attached to (or that contains the table the policy is attached to). NULL for CATALOG-attached policies.\"},{\"name\":\"securable_name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":5,\"nullable\":true,\"comment\":\"Name of the securable the policy is attached to. NULL for CATALOG-attached and SCHEMA-attached policies.\"},{\"name\":\"on_securable_type\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":6,\"nullable\":false,\"comment\":\"Type of the securable the policy is attached to. For example, CATALOG, SCHEMA, or TABLE.\"},{\"name\":\"to_principals\",\"type_text\":\"array\\u003cstring\\u003e\",\"type_name\":\"ARRAY\",\"position\":7,\"nullable\":false,\"comment\":\"List of principals (users, groups, service principals) the policy applies to.\"},{\"name\":\"except_principals\",\"type_text\":\"array\\u003cstring\\u003e\",\"type_name\":\"ARRAY\",\"position\":8,\"nullable\":false,\"comment\":\"List of principals excluded from the policy.\"},{\"name\":\"for_securable_type\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":9,\"nullable\":false,\"comment\":\"Type of securable the policy targets when evaluated.\"},{\"name\":\"privileges\",\"type_text\":\"array\\u003cstring\\u003e\",\"type_name\":\"ARRAY\",\"position\":10,\"nullable\":true,\"comment\":\"Privileges granted or denied by the policy. NULL for ROW_FILTER and COLUMN_MASK policies.\"},{\"name\":\"when_condition\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":11,\"nullable\":true,\"comment\":\"Conditional expression under which the policy applies. NULL when no WHEN clause is set.\"},{\"name\":\"match_columns\",\"type_text\":\"array\\u003cstring\\u003e\",\"type_name\":\"ARRAY\",\"position\":12,\"nullable\":true,\"comment\":\"Columns referenced by the policy. NULL for GRANT and DENY policies.\"},{\"name\":\"governed_tags\",\"type_text\":\"array\\u003cstruct\\u003ctag_key:string,tag_value:string\\u003e\\u003e\",\"type_name\":\"ARRAY\",\"position\":13,\"nullable\":false,\"comment\":\"Governed tag keys and optional values referenced by the policy.\"},{\"name\":\"created_by\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":14,\"nullable\":false,\"comment\":\"Principal who created the policy.\"}]},{\"name\":\"catalog_privileges\",\"catalog_name\":\"system\",\"schema_name\":\"information_schema\",\"table_type\":\"EXTERNAL\",\"comment\":\"Lists principals that have privileges on the catalogs.\",\"columns\":[{\"name\":\"grantor\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"nullable\":false,\"comment\":\"Principal that granted the privilege.\"},{\"name\":\"grantee\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":1,\"nullable\":false,\"comment\":\"Principal to which the privilege is granted.\"},{\"name\":\"catalog_name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":2,\"nullable\":false,\"comment\":\"Catalog on which the privilege is granted.\"},{\"name\":\"privilege_type\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":3,\"nullable\":false,\"comment\":\"Privilege being granted.\"},{\"name\":\"is_grantable\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":4,\"nullable\":false,\"comment\":\"Always NO. Reserved for future use.\"},{\"name\":\"inherited_from\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":5,\"nullable\":false,\"comment\":\"The ancestor relation that the privilege is inherited from.\"}]},{\"name\":\"catalog_provider_share_usage\",\"catalog_name\":\"system\",\"schema_name\":\"information_schema\",\"table_type\":\"EXTERNAL\",\"comment\":\"Describes provider share mounted onto catalogs.\",\"columns\":[{\"name\":\"catalog_name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"nullable\":false,\"comment\":\"Catalog that has mounted the share.\"},{\"name\":\"provider_name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":1,\"nullable\":false,\"comment\":\"Provider that shared the share.\"},{\"name\":\"share_name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":2,\"nullable\":false,\"comment\":\"Name of the share.\"}]},{\"name\":\"catalog_tags\",\"catalog_name\":\"system\",\"schema_name\":\"information_schema\",\"table_type\":\"EXTERNAL\",\"columns\":[{\"name\":\"catalog_name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"nullable\":false},{\"name\":\"tag_name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":1,\"nullable\":false},{\"name\":\"tag_value\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":2,\"nullable\":false}]},{\"name\":\"catalogs\",\"catalog_name\":\"system\",\"schema_name\":\"information_schema\",\"table_type\":\"EXTERNAL\",\"comment\":\"Describes catalogs.\",\"columns\":[{\"name\":\"catalog_name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"nullable\":false,\"comment\":\"Name of the catalog.\"},{\"name\":\"catalog_owner\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":1,\"nullable\":false,\"comment\":\"Owner of the catalog.\"},{\"name\":\"comment\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":2,\"nullable\":true,\"comment\":\"An optional comment that describes the catalog.\"},{\"name\":\"created\",\"type_text\":\"timestamp\",\"type_name\":\"TIMESTAMP\",\"position\":3,\"nullable\":false,\"comment\":\"Timestamp when the catalog was created.\"},{\"name\":\"created_by\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":4,\"nullable\":false,\"comment\":\"Principal who created the catalog.\"},{\"name\":\"last_altered\",\"type_text\":\"timestamp\",\"type_name\":\"TIMESTAMP\",\"position\":5,\"nullable\":false,\"comment\":\"Timestamp when the catalog was last altered in any way.\"},{\"name\":\"last_altered_by\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":6,\"nullable\":false,\"comment\":\"Principal who last altered the catalog.\"},{\"name\":\"url\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":7,\"nullable\":true,\"comment\":\"The external location where the catalog was stored\"},{\"name\":\"custom_max_retention_hours\",\"type_text\":\"long\",\"type_name\":\"LONG\",\"position\":8,\"nullable\":true,\"comment\":\"The user specified period in hours in which a dropped catalog and its children are restorable\"}]},{\"name\":\"check_constraints\",\"catalog_name\":\"system\",\"schema_name\":\"information_schema\",\"table_type\":\"EXTERNAL\",\"comment\":\"Reserved for future use.\",\"columns\":[{\"name\":\"constraint_catalog\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"nullable\":false,\"comment\":\"Catalog containing the check constraint.\"},{\"name\":\"constraint_schema\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":1,\"nullable\":false,\"comment\":\"Schema containing the check constraint.\"},{\"name\":\"co