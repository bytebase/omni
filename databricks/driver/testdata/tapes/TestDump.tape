| {"status":200,"contentType":"application/json","body":"{\"tables\":[{\"name\":\"auto_upgrade_operations_history\",\"catalog_name\":\"system\",\"schema_name\":\"storage\",\"table_type\":\"MANAGED\",\"comment\":\"Tracks auto-upgrade operations performed by predictive optimization, such as enabling deletion vectors or row tracking.\",\"columns\":[{\"name\":\"account_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"nullable\":true,\"comment\":\"ID of the account.\"},{\"name\":\"start_time\",\"type_text\":\"timestamp\",\"type_name\":\"TIMESTAMP\",\"position\":1,\"nullable\":true,\"comment\":\"The time at which the operation started. Timezone information is recorded at the end of the value with +00:00 representing UTC.\"},{\"name\":\"end_time\",\"type_text\":\"timestamp\",\"type_name\":\"TIMESTAMP\",\"position\":2,\"nullable\":true,\"comment\":\"The time at which the operation ended. Timezone information is recorded at the end of the value with +00:00 representing UTC.\"},{\"name\":\"metastore_name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":3,\"nullable\":true,\"comment\":\"The name of the metastore to which the table belongs.\"},{\"name\":\"metastore_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":4,\"nullable\":true,\"comment\":\"The ID of the metastore to which the table belongs.\"},{\"name\":\"catalog_name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":5,\"nullable\":true,\"comment\":\"The name of the catalog to which the table belongs.\"},{\"name\":\"schema_name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":6,\"nullable\":true,\"comment\":\"The name of the schema to which the table belongs.\"},{\"name\":\"table_name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":7,\"nullable\":true,\"comment\":\"The name of the table.\"},{\"name\":\"table_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":8,\"nullable\":true,\"comment\":\"The ID of the table.\"},{\"name\":\"feature_name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":9,\"nullable\":true,\"comment\":\"The table feature being enabled, such as deletionVectors or rowTracking.\"},{\"name\":\"operation_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":10,\"nullable\":true,\"comment\":\"The ID for the auto-upgrade operation.\"},{\"name\":\"operation\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":11,\"nullable\":true,\"comment\":\"The kind of operation: ENABLE or DISABLE.\"},{\"name\":\"operation_result\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":12,\"nullable\":true,\"comment\":\"The result of the operation.\"}]},{\"name\":\"predictive_optimization_operations_history\",\"catalog_name\":\"system\",\"schema_name\":\"storage\",\"table_type\":\"MANAGED\",\"comment\":\"Predictive optimization optimizes your data layout for peak performance and cost efficiency. This system table tracks the operation history of this feature. \",\"columns\":[{\"name\":\"account_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"nullable\":true,\"comment\":\"ID of the account.\"},{\"name\":\"workspace_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":1,\"nullable\":true,\"comment\":\"The ID of the workspace in which predictive optimization ran the operation.\"},{\"name\":\"start_time\",\"type_text\":\"timestamp\",\"type_name\":\"TIMESTAMP\",\"position\":2,\"nullable\":true,\"comment\":\"The time at which the operation started. Timezone information is recorded at the end of the value with +00:00 representing UTC.\"},{\"name\":\"end_time\",\"type_text\":\"timestamp\",\"type_name\":\"TIMESTAMP\",\"position\":3,\"nullable\":true,\"comment\":\"The time at which the operation ended. Timezone information is recorded at the end of the value with +00:00 representing UTC.\"},{\"name\":\"metastore_name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":4,\"nullable\":true,\"comment\":\"The name of the metastore to which the optimized table belongs.\"},{\"name\":\"metastore_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":5,\"nullable\":true,\"comment\":\"The ID of the metastore to which the optimized table belongs.\"},{\"name\":\"catalog_name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":6,\"nullable\":true,\"comment\":\"The name of the catalog to which the optimized table belongs.\"},{\"name\":\"schema_name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":7,\"nullable\":true,\"comment\":\"The name of the schema to which the optimized table belongs.\"},{\"name\":\"table_name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":8,\"nullable\":true,\"comment\":\"The name of the optimized table.\"},{\"name\":\"table_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":9,\"nullable\":true,\"comment\":\"The ID of the optimized table.\"},{\"name\":\"operation_type\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":10,\"nullable\":true,\"comment\":\"The optimization operation which was performed.\"},{\"name\":\"operation_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":11,\"nullable\":true,\"comment\":\"The ID for the optimization operation.\"},{\"name\":\"operation_status\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":12,\"nullable\":true,\"comment\":\"The status of the optimization operation. The value will be SUCCESSFUL or FAILED with a specific error type.\"},{\"name\":\"operation_metrics\",\"type_text\":\"map\\u003cstring,string\\u003e\",\"type_name\":\"MAP\",\"position\":13,\"nullable\":true,\"comment\":\"Additional details about the specific optimization that was performed.\"},{\"name\":\"usage_unit\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":14,\"nullable\":true,\"comment\":\"The unit of usage that this operation incurred. \"},{\"name\":\"usage_quantity\",\"type_text\":\"decimal(38,18)\",\"type_name\":\"DECIMAL\",\"position\":15,\"nullable\":true,\"comment\":\"The amount of the usage unit that was used by this operation.\"}]},{\"name\":\"table_metrics_history\",\"catalog_name\":\"system\",\"schema_name\":\"storage\",\"table_type\":\"MANAGED\",\"comment\":\"Storage metrics history for Unity Catalog tables.\",\"columns\":[{\"name\":\"snapshot_date\",\"type_text\":\"date\",\"type_name\":\"DATE\",\"nullable\":true,\"comment\":\"The UTC date when the record was captured.\"},{\"name\":\"account_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":1,\"nullable\":true,\"comment\":\"The account identifier (UUID).\"},{\"name\":\"metastore_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":2,\"nullable\":true,\"comment\":\"The metastore identifier (UUID).\"},{\"name\":\"table_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":3,\"nullable\":true,\"comment\":\"The table identifier (UUID).\"},{\"name\":\"catalog_name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":4,\"nullable\":true,\"comment\":\"The name of the catalog containing the table.\"},{\"name\":\"schema_name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":5,\"nullable\":true,\"comment\":\"The name of the schema containing the table.\"},{\"name\":\"table_name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":6,\"nullable\":true,\"comment\":\"The name of the table.\"},{\"name\":\"table_type\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":7,\"nullable\":true,\"comment\":\"The type of table.\"},{\"name\":\"clone_details\",\"type_text\":\"struct\\u003cparent_id:string,type:string\\u003e\",\"type_name\":\"STRUCT\",\"position\":8,\"nullable\":true,\"comment\":\"Details about the clone source table, if this table is a shallow clone.\"},{\"name\":\"table_owner\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":9,\"nullable\":true,\"comment\":\"The owner of the table.\"},{\"name\":\"active_bytes