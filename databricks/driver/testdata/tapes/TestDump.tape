| {"status":200,"contentType":"application/json","body":"{\"tables\":[{\"name\":\"account_prices\",\"catalog_name\":\"system\",\"schema_name\":\"billing\",\"table_type\":\"MANAGED\",\"columns\":[{\"name\":\"account_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"nullable\":true,\"comment\":\"ID of the account this report was generated for\"},{\"name\":\"price_start_time\",\"type_text\":\"timestamp\",\"type_name\":\"TIMESTAMP\",\"position\":1,\"nullable\":true,\"comment\":\"The time this price became effective in UTC\"},{\"name\":\"price_end_time\",\"type_text\":\"timestamp\",\"type_name\":\"TIMESTAMP\",\"position\":2,\"nullable\":true,\"comment\":\"The time this price stopped being effective in UTC\"},{\"name\":\"sku_name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":3,\"nullable\":true,\"comment\":\"Name of the SKU\"},{\"name\":\"cloud\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":4,\"nullable\":true,\"comment\":\"Name of the Cloud this price is applicable to. Possible values are AWS, AZURE, and GCP.\"},{\"name\":\"currency_code\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":5,\"nullable\":true,\"comment\":\"The currency this price is expressed in\"},{\"name\":\"usage_unit\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":6,\"nullable\":true,\"comment\":\"The unit of measurement that is monetized.\"},{\"name\":\"pricing\",\"type_text\":\"struct\\u003cdefault:decimal(38,18)\\u003e\",\"type_name\":\"STRUCT\",\"position\":7,\"nullable\":true}]},{\"name\":\"attributed_usage\",\"catalog_name\":\"system\",\"schema_name\":\"billing\",\"table_type\":\"MANAGED\",\"comment\":\"The [attributed usage table](https://docs.google.com/document/d/1QAAo2MgBOI4ZRvZt01xQJWGkOCdMFXJrsts9Ta4RYeU) gives you access to account-wide estimated usage data at the sub-billing level. The preview data is limited to estimated attributed usage of DBSQL queries.\",\"columns\":[{\"name\":\"record_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"nullable\":true,\"comment\":\"Unique ID for this attributed usage record (for DBSQL queries, formatted as cpq_\\u003cstatement_id\\u003e)\"},{\"name\":\"usage_metadata\",\"type_text\":\"struct\\u003cdbsql_statement_id:string,warehouse_id:string,client_application:string\\u003e\",\"type_name\":\"STRUCT\",\"position\":1,\"nullable\":true,\"comment\":\"System-provided metadata about the attributed usage, including IDs for compute resources and jobs. Expected to be sparse (many fields are null), but at least one field will not be null.\"},{\"name\":\"identity_metadata\",\"type_text\":\"struct\\u003cexecuted_by:string\\u003e\",\"type_name\":\"STRUCT\",\"position\":2,\"nullable\":true,\"comment\":\"System-provided metadata about the identities involved in the attributed usage\"},{\"name\":\"start_time\",\"type_text\":\"timestamp\",\"type_name\":\"TIMESTAMP\",\"position\":3,\"nullable\":true,\"comment\":\"The start time relevant to this attributed usage record (e.g., DBSQL query start time)\"},{\"name\":\"end_time\",\"type_text\":\"timestamp\",\"type_name\":\"TIMESTAMP\",\"position\":4,\"nullable\":true,\"comment\":\"The end time relevant to this attributed usage record (e.g., DBSQL query end time)\"},{\"name\":\"usage_date\",\"type_text\":\"date\",\"type_name\":\"DATE\",\"position\":5,\"nullable\":true,\"comment\":\"Date of the attributed usage record (derived from end_time). This field can be used for faster aggregation by date.\"},{\"name\":\"usage_unit\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":6,\"nullable\":true,\"comment\":\"Unit this usage is measured in (e.g., DBU)\"},{\"name\":\"active_usage_quantity\",\"type_text\":\"decimal(38,18)\",\"type_name\":\"DECIMAL\",\"position\":7,\"nullable\":true,\"comment\":\"Estimated number of units consumed for this record (for DBSQL, only active warehouse usage)\"},{\"name\":\"granular_tags\",\"type_text\":\"struct\\u003cquery_tags:map\\u003cstring,string\\u003e\\u003e\",\"type_name\":\"STRUCT\",\"position\":8,\"nullable\":true,\"comment\":\"Tags that are applied on the attributed usage level (e.g., Query Tags)\"},{\"name\":\"usage_record_ids\",\"type_text\":\"array\\u003cstring\\u003e\",\"type_name\":\"ARRAY\",\"position\":9,\"nullable\":true,\"comment\":\"Record IDs from system.billing.usage that this attributed usage record is associated with\"},{\"name\":\"account_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":10,\"nullable\":true,\"comment\":\"ID of the account this report was generated for\"},{\"name\":\"workspace_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":11,\"nullable\":true,\"comment\":\"ID of the workspace this usage was associated with\"},{\"name\":\"sku_name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":12,\"nullable\":true,\"comment\":\"Name of the SKU (e.g., ENTERPRISE_SERVERLESS_SQL_COMPUTE_US_WEST_OREGON)\"},{\"name\":\"cloud\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":13,\"nullable\":true,\"comment\":\"Cloud associated with this usage. Possible values are AWS, AZURE, and GCP.\"},{\"name\":\"billing_origin_product\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":14,\"nullable\":true,\"comment\":\"The product that originated the usage (e.g., SQL, JOBS)\"},{\"name\":\"custom_tags\",\"type_text\":\"map\\u003cstring,string\\u003e\",\"type_name\":\"MAP\",\"position\":15,\"nullable\":true,\"comment\":\"Custom tags associated with the usage record\"}]},{\"name\":\"list_prices\",\"catalog_name\":\"system\",\"schema_name\":\"billing\",\"table_type\":\"MANAGED\",\"comment\":\"The [pricing table](https://docs.databricks.com/admin/system-tables/pricing.html) gives you access to a historical log of SKU pricing. A record gets added each time there is a change to a SKU price.\",\"columns\":[{\"name\":\"account_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"nullable\":true,\"comment\":\"ID of the account this report was generated for\"},{\"name\":\"price_start_time\",\"type_text\":\"timestamp\",\"type_name\":\"TIMESTAMP\",\"position\":1,\"nullable\":true,\"comment\":\"The time this price became effective in UTC\"},{\"name\":\"price_end_time\",\"type_text\":\"timestamp\",\"type_name\":\"TIMESTAMP\",\"position\":2,\"nullable\":true,\"comment\":\"The time this price stopped being effective in UTC\"},{\"name\":\"sku_name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":3,\"nullable\":true,\"comment\":\"Name of the SKU\"},{\"name\":\"cloud\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":4,\"nullable\":true,\"comment\":\"Name of the Cloud this price is applicable to. Possible values are AWS, AZURE, and GCP.\"},{\"name\":\"currency_code\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":5,\"nullable\":true,\"comment\":\"The currency this price is expressed in\"},{\"name\":\"usage_unit\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":6,\"nullable\":true,\"comment\":\"The unit of measurement that is monetized.\"},{\"name\":\"pricing\",\"type_text\":\"struct\\u003cdefault:decimal(38,18),promotional:struct\\u003cdefault:decimal(38,18)\\u003e,effective_list:struct\\u003cdefault:decimal(38,18)\\u003e\\u003e\",\"type_name\":\"STRUCT\",\"position\":7,\"nullable\":true,\"comment\":\"A structured data field that includes pricing info at the published list price rate. The key default will always return a single price that can be used for simple long-term estimates. The key promotional represents a temporary promotional price that all customers get which could be used for cost estimation during the temporary period. The key effective_list resolves list and promotional price, and contains the effective list price used for calculating the cost.\"}]},{\"name\":\"usage\",\"catalog_name\":\"system\",\"schema_name\":\"billing\",\"table_type\":\"MANAGED\",\"comment\":\"The [usage table](https://docs.databricks.com/admin/system-tables/billing.html) gives you access to account-wide billable usage data. The data is centralized and routed to all the regions.\",\"columns\":[{\"name\":\"account_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"nullable\":true,\"comment\":\"ID of the account this report was generated for\"},{\"name\":\"workspace_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":1,\"nullable\":true,\"comment\":\"ID of the Workspace this usage was associated with\"},{\"name\":\"record_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":2,\"nullable\":true,\"comment\":\"Unique ID for this usage record\"},{\"name\":\"sku_name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":3,\"nullable\":true,\"comment\":\"Name of the SKU\"},{\"name\":\"cloud\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":4,\"nullable\":true,\"comment\":\"Cloud this usage is relevant for. Possible values are AWS, AZURE, and GCP.\"},{\"name\":\"usage_start_time\",\"type_text\":\"timestamp\",\"type_name\":\"TIMESTAMP\",\"position\":5,\"nullable\":true,\"comment\":\"The start time relevant to this usage record. Timezone information is recorded at the end of the value with +00:00 representing UTC timezone.\"},{\"name\":\"usage_end_time\",\"type_text\":\"timestamp\",\"type_name\":\"TIMESTAMP\",\"position\":6,\"nullable\":true,\"comment\":\"The end time relevant to this usage record. Timezone information is recorded at the end of the value with +00:00 representing UTC timezone.\"},{\"name\":\"usage_date\",\"type_text\":\"date\",\"type_name\":\"DATE\",\"position\":7,\"nullable\":true,\"comment\":\"Date of the usage record, this field can be used for faster aggregation by date\"},{\"name\":\"custom_tags\",\"type_text\":\"map\\u003cstring,string\\u003e\",\"type_name\":\"MAP\",\"position\":8,\"nullable\":true,\"comment\":\"Tags applied by the users to this usage. Includes compute resource tags and jobs tags.\"},{\"name\":\"usage_unit\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":9,\"nullable\":true,\"comment\":\"Unit this usage is measured in. Possible values include DBUs and Gbps-hours.\"},{\"name\":\"usage_quantity\",\"type_text\":\"decimal(38,18)\",\"type_name\":\"DECIMAL\",\"position\":10,\"nullable\":true,\"comment\":\"Number of units consumed for this record.\"},{\"name\":\"usage_metadata\",\"type_text\":\"struct\\u003ccluster_id:string,job_id:string,warehouse_id:string,instance_pool_id:string,node_type:string,job_run_id:string,notebook_id:string,dlt_pipeline_id:string,endpoint_name:string,endpoint_id:string,dlt_update_id:string,dlt_maintenance_id:string,run_name:string,job_name:string,notebook_path:string,central_clean_room_id:string,source_region:string,destination_region:string,app_id:string,app_name:string,metastore_id:string,private_endpoint_name:string,storage_api_type:string,budget_policy_id:string,ai_runtime_pool_id:string,ai_runtime_workload_id:string,uc_table_catalog:string,uc_table_schema:string,uc_table_name:string,database_instance_id:string,sharing_materialization_id:string,schema_id:string,usage_policy_id:string,base_environment_id:string,agent_bricks_id:string,index_id:string,catalog_id:string,project_id:string,branch_id:string,table_id:string,supervisor_agent_id:string,networking_client:string,associated_product:string,recipient_id:string,interactive_source:string,snapshot_id:string,ai_gateway:struct\\u003cendpoint_name:string,endpoint_id:string,destination_id:string,destination_model:string\\u003e,genie:struct\\u003csurface:string,channel:string,agent_id:string\\u003e,data_source:string,operation:string,serverless_compute_id:string,entity_full_name:string,failover_group_name:string,private_network_gateway_id:string,monitor_type:string,compute_policy_id:string,catalog_services:struct\\u003cfeature_type:string\\u003e,index_name:string\\u003e\",\"type_name\":\"STRUCT\",\"position\":11,\"nullable\":true,\"comment\":\"System-provided metadata about the usage, including IDs for compute resources and jobs (if applicable). See [Analyze usage metadata](https://docs.databricks.com/en/admin/system-tables/billing.html#usage-metadata).\"},{\"name\":\"identity_metadata\",\"type_text\":\"struct\\u003crun_as:string,created_by:string,owned_by:string,run_by:string\\u003e\",\"type_name\":\"STRUCT\",\"position\":12,\"nullable\":true,\"comment\":\"System-provided metadata about the identities involved in the usage. See [Analyze identity metadata](https://docs.databricks.com/en/admin/system-tables/billing.html#identity-metadata).\"},{\"name\":\"record_type\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":13,\"nullable\":true,\"comment\":\"Whether the record is original, a retraction, or a restatement. The value is ORIGINAL unless the record is related to a correction. See [Analyze correction records](https://docs.databricks.com/en/admin/system-tables/billing.html#record-type).\"},{\"name\":\"ingestion_date\",\"type_text\":\"date\",\"type_name\":\"DATE\",\"position\":14,\"nullable\":true,\"comment\":\"Date the record was ingested into the usage table.\"},{\"name\":\"billing_origin_product\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":15,\"nullable\":true,\"comment\":\"The product that originated the usage. Some products can be billed as different SKUs. For possible values, see [View information about the product associated with the usage](https://docs.databricks.com/en/admin/system-tables/billing.html#features).\"},{\"name\":\"product_features\",\"type_text\":\"struct\\u003cjobs_tier:string,sql_tier:string,dlt_tier:string,is_serverless:boolean,is_photon:boolean,serving_type:string,networking:struct\\u003cconnectivity_type:string,connection_method:string\\u003e,ai_runtime:struct\\u003ccompute_type:string\\u003e,model_serving:struct\\u003coffering_type:string,reservation_term:string\\u003e,ai_gateway:struct\\u003cfeature_type:string\\u003e,serverless_gpu:struct\\u003cworkload_type:string\\u003e,agent_bricks:struct\\u003cproblem_type:string,workload_type:string\\u003e,performance_target:string,ai_functions:struct\\u003cai_function:string\\u003e,apps:struct\\u003ccompute_size:string\\u003e,lakeflow_connect:struct\\u003ctask_type:string,zerobus_request_type:string\\u003e,lakebase:struct\\u003cstorage_type:string,compute_type:string\\u003e,ai_bi_genie:struct\\u003ccapability_type:string,offering_type:string\\u003e,genie:struct\\u003coffering_type:string\\u003e\\u003e\",\"type_name\":\"STRUCT\",\"position\":16,\"nullable\":true,\"comment\":\"Details about the specific product features used.\"},{\"name\":\"usage_type\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":17,\"nullable\":true,\"comment\":\"The type of usage attributed to the product or workload for billing purposes. Possible values are COMPUTE_TIME, STORAGE_SPACE, NETWORK_BYTES, NETWORK_BANDWIDTH, API_CALLS, TOKEN, or GPU_TIME.\"}]}]}"}
