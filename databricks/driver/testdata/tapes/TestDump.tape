er list.\"},{\"name\":\"parameter_mode\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":4,\"nullable\":false,\"comment\":\"The parameter mode, 'IN' 'OUT' or 'INOUT.\"},{\"name\":\"is_result\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":5,\"nullable\":false,\"comment\":\"Always 'NO'. Reserved for future use.\"},{\"name\":\"as_locator\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":6,\"nullable\":false,\"comment\":\"Always 'NO'. Reserved for future use.\"},{\"name\":\"parameter_name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":7,\"nullable\":true,\"comment\":\"Name of the parameter, NULL if unnamed.\"},{\"name\":\"data_type\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":8,\"nullable\":false,\"comment\":\"The parameter data type name.\"},{\"name\":\"full_data_type\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":9,\"nullable\":false,\"comment\":\"The parameter data type definition, for example 'DECIMAL(10, 4)'.\"},{\"name\":\"character_maximum_length\",\"type_text\":\"long\",\"type_name\":\"LONG\",\"position\":10,\"nullable\":true,\"comment\":\"Always NULL, reserved for future use.\"},{\"name\":\"character_octet_length\",\"type_text\":\"long\",\"type_name\":\"LONG\",\"position\":11,\"nullable\":true,\"comment\":\"Always NULL, reserved for future use.\"},{\"name\":\"numeric_precision\",\"type_text\":\"int\",\"type_name\":\"INT\",\"position\":12,\"nullable\":true,\"comment\":\"For base-2 integral numeric types, FLOAT, and DOUBLE, the number of supported bits. For DECIMAL the number of digits, NULL otherwise.\"},{\"name\":\"numeric_precision_radix\",\"type_text\":\"int\",\"type_name\":\"INT\",\"position\":13,\"nullable\":true,\"comment\":\"For DECIMAL 10, for all other numeric types 2, NULL otherwise.\"},{\"name\":\"numeric_scale\",\"type_text\":\"int\",\"type_name\":\"INT\",\"position\":14,\"nullable\":true,\"comment\":\"For integral numeric types 0, for DECIMAL the number of digits to the right of the decimal point, NULL otherwise.\"},{\"name\":\"datetime_precision\",\"type_text\":\"int\",\"type_name\":\"INT\",\"position\":15,\"nullable\":true,\"comment\":\"For DATE 0, for TIMESTAMP, and INTERVAL … SECOND 6, any other INTERVAL 0, NULL otherwise.\"},{\"name\":\"interval_type\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":16,\"nullable\":true,\"comment\":\"For INTERVAL the unit portion of the interval, for example 'YEAR TO MONTH', NULL otherwise.\"},{\"name\":\"interval_precision\",\"type_text\":\"int\",\"type_name\":\"INT\",\"position\":17,\"nullable\":true,\"comment\":\"Always NULL, reserved for future use.\"},{\"name\":\"maximum_cardinality\",\"type_text\":\"long\",\"type_name\":\"LONG\",\"position\":18,\"nullable\":true,\"comment\":\"Always NULL, reserved for future use.\"},{\"name\":\"parameter_default\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":19,\"nullable\":true,\"comment\":\"Always NULL, reserved for future use.\"},{\"name\":\"comment\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":20,\"nullable\":true,\"comment\":\"An optional comment describing the parameter.\"},{\"name\":\"collation_catalog\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":21,\"nullable\":true,\"comment\":\"For string columns, always SYSTEM. Reserved for future use, NULL if not a string column.\"},{\"name\":\"collation_schema\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":22,\"nullable\":true,\"comment\":\"For string columns, always BUILTIN. Reserved for future use, NULL if not a string column.\"},{\"name\":\"collation_name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":23,\"nullable\":true,\"comment\":\"For string columns, the name of the collation, NULL if not a string column.\"}]},{\"name\":\"providers\",\"catalog_name\":\"system\",\"schema_name\":\"information_schema\",\"table_type\":\"EXTERNAL\",\"comment\":\"Describes providers.\",\"columns\":[{\"name\":\"provider_name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"nullable\":false,\"comment\":\"Name of the provider.\"},{\"name\":\"provider_owner\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":1,\"nullable\":false,\"comment\":\"Owner of the provider.\"},{\"name\":\"authentication_type\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":2,\"nullable\":false,\"comment\":\"Authentication type used with the provider.\"},{\"name\":\"share_credentials_version\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":3,\"nullable\":true,\"comment\":\"File format version of the profile file used in Delta Sharing protocol.\"},{\"name\":\"endpoint\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":4,\"nullable\":true,\"comment\":\"Endpoint of the Delta Sharing server.\"},{\"name\":\"comment\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":5,\"nullable\":true,\"comment\":\"An optional comment that describes the provider.\"},{\"name\":\"cloud\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":6,\"nullable\":true,\"comment\":\"Cloud vendor of the provider.\"},{\"name\":\"region\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":7,\"nullable\":true,\"comment\":\"Region of the provider.\"},{\"name\":\"data_provider_global_metastore_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":8,\"nullable\":true,\"comment\":\"Globally unique metastore ID of the provider.\"},{\"name\":\"created\",\"type_text\":\"timestamp\",\"type_name\":\"TIMESTAMP\",\"position\":9,\"nullable\":false,\"comment\":\"Timestamp when the provider was created.\"},{\"name\":\"created_by\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":10,\"nullable\":false,\"comment\":\"Principal who created the provider.\"},{\"name\":\"last_altered\",\"type_text\":\"timestamp\",\"type_name\":\"TIMESTAMP\",\"position\":11,\"nullable\":false,\"comment\":\"Timestamp when the provider was last altered in any way.\"},{\"name\":\"last_altered_by\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":12,\"nullable\":false,\"comment\":\"Principal who last altered the provider.\"}]},{\"name\":\"recipient_allowed_ip_ranges\",\"catalog_name\":\"system\",\"schema_name\":\"information_schema\",\"table_type\":\"EXTERNAL\",\"comment\":\"Lists allowed IP ranges for recipients.\",\"columns\":[{\"name\":\"recipient_name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"nullable\":false,\"comment\":\"Name of the recipient.\"},{\"name\":\"allowed_ip_range\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":1,\"nullable\":false,\"comment\":\"Allowed IP range in IP address or CIDR format.\"}]},{\"name\":\"recipient_tokens\",\"catalog_name\":\"system\",\"schema_name\":\"information_schema\",\"table_type\":\"EXTERNAL\",\"comment\":\"Lists tokens for recipients.\",\"columns\":[{\"name\":\"recipient_name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"nullable\":false,\"comment\":\"Name of the recipient.\"},{\"name\":\"recipient_token_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":1,\"nullable\":false,\"comment\":\"ID of the recipient token.\"},{\"name\":\"activation_url\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":2,\"nullable\":true,\"comment\":\"Full activation URL used to retrieve the recipient token. It will be null if the token is already retrieved.\"},{\"name\":\"expiration_time\",\"type_text\":\"timestamp\",\"type_name\":\"TIMESTAMP\",\"position\":3,\"nullable\":false,\"comment\":\"Expiration timestamp of the recipient token.\"},{\"name\":\"created\",\"type_text\":\"timestamp\",\"type_name\":\"TIMESTAMP\",\"position\":4,\"nullable\":false,\"comment\":\"Timestamp when the recipient token was created.\"},{\"name\":\"created_by\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":5,\"nullable\":false,\"comment\":\"Principal who created the recipient token.\"},{\"name\":\"last_altered\",\"type_text\":\"timestamp\",\"type_name\":\"TIMESTAMP\",\"position\":6,\"nullable\":false,\"comment\":\"Timestamp when the recipient token was last altered in any way.\"},{\"name\":\"last_altered_by\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":7,\"nullable\":false,\"comment\":\"Principal who last altered the recipient token.\"}]},{\"name\":\"recipients\",\"catalog_name\":\"system\",\"schema_name\":\"information_schema\",\"table_type\":\"EXTERNAL\",\"comment\":\"Describes recipients.\",\"columns\":[{\"name\":\"recipient_name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"nullable\":false,\"comment\":\"Name of the recipient.\"},{\"name\":\"recipient_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":1,\"nullable\":false,\"comment\":\"Id of the recipient\"},{\"name\":\"recipient_owner\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":2,\"nullable\":false,\"comment\":\"Owner of the recipient.\"},{\"name\":\"authentication_type\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":3,\"nullable\":false,\"comment\":\"Authentication type used with the recipient.\"},{\"name\":\"comment\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":4,\"nullable\":true,\"comment\":\"An optional comment that describes the recipient.\"},{\"name\":\"cloud\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":5,\"nullable\":true,\"comment\":\"Cloud vendor of the recipient (Databricks-to-Databricks only).\"},{\"name\":\"region\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":6,\"nullable\":true,\"comment\":\"Region of the recipient (Databricks-to-Databricks only).\"},{\"name\":\"data_recipient_global_metastore_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":7,\"nullable\":true,\"comment\":\"Globally unique metastore ID of the recipient (Databricks-to-Databricks only).\"},{\"name\":\"created\",\"type_text\":\"timestamp\",\"type_name\":\"TIMESTAMP\",\"position\":8,\"nullable\":false,\"comment\":\"Timestamp when the recipient was created.\"},{\"name\":\"created_by\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":9,\"nullable\":false,\"comment\":\"Principal who created the recipient.\"},{\"name\":\"last_altered\",\"type_text\":\"timestamp\",\"type_name\":\"TIMESTAMP\",\"position\":10,\"nullable\":false,\"comment\":\"Timestamp when the recipient was last altered in any way.\"},{\"name\":\"last_altered_by\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":11,\"nullable\":false,\"comment\":\"Principal who last altered the recipient.\"}]},{\"name\":\"referential_constraints\",\"catalog_name\":\"system\",\"schema_name\":\"information_schema\",\"table_type\":\"EXTERNAL\",\"comment\":\"Describes referential (foreign key) constraints defined in the catalog.\",\"columns\":[{\"name\":\"constraint_catalog\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"nullable\":false,\"comment\":\"Catalog containing the foreign key constraint.\"},{\"name\":\"constraint_schema\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":1,\"nullable\":false,\"comment\":\"Schema containing the foreign key constraints.\"},{\"name\":\"constraint_name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":2,\"nullable\":false,\"comment\":\"Name of the check constraint.\"},{\"name\":\"unique_constraint_catalog\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":3,\"nullable\":false,\"comment\":\"Catalog containing the referenced constraint.\"},{\"name\":\"unique_constraint_schema\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":4,\"nullable\":false,\"comment\":\"Schema containing the referenced constraint.\"},{\"name\":\"unique_constraint_name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":5,\"nullable\":false,\"comment\":\"Name of the referenced constraint.\"},{\"name\":\"match_option\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":6,\"nullable\":false,\"comment\":\"Always FULL, reserved for future use..\"},{\"name\":\"update_rule\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":7,\"nullable\":false,\"comment\":\"Always NO ACTION, reserved for future use.\"},{\"name\":\"delete_rule\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":8,\"nullable\":false,\"comment\":\"Always NO ACTION, reserved for future use.\"}]},{\"name\":\"routine_columns\",\"catalog_name\":\"system\",\"schema_name\":\"information_schema\",\"table_type\":\"EXTERNAL\",\"comment\":\"Describes result columns of table-valued functions.\",\"columns\":[{\"name\":\"specific_catalog\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"nullable\":false,\"comment\":\"Catalog containing the routine.\"},{\"name\":\"specific_schema\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":1,\"nullable\":false,\"comment\":\"Database (schema) containing the routine.\"},{\"name\":\"specific_name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":2,\"nullable\":false,\"comment\":\"Schema unique (specific) name of the routine.\"},{\"name\":\"ordinal_position\",\"type_text\":\"int\",\"type_name\":\"INT\",\"position\":3,\"nullable\":false,\"comment\":\"The position (0-based) of the column in the result column list.\"},{\"name\":\"column_name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":4,\"nullable\":false,\"comment\":\"Name of the column, NULL if unnamed.\"},{\"name\":\"data_type\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":5,\"nullable\":false,\"comment\":\"The column data type name.\"},{\"name\":\"full_data_type\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":6,\"nullable\":false,\"comment\":\"The column data type definition, for example 'DECIMAL(10, 4)'.\"},{\"name\":\"character_maximum_length\",\"type_text\":\"long\",\"type_name\":\"LONG\",\"position\":7,\"nullable\":true,\"comment\":\"Always NULL, reserved for future use.\"},{\"name\":\"ch