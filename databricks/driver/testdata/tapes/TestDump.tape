| {"status":200,"contentType":"application/json","body":"{\"statement_id\":\"00000000-0000-0000-0000-000000000014\",\"status\":{\"state\":\"SUCCEEDED\"},\"manifest\":{\"format\":\"JSON_ARRAY\",\"schema\":{\"column_count\":1,\"columns\":[{\"name\":\"createtab_stmt\",\"type_text\":\"STRING\",\"type_name\":\"STRING\",\"nullable\":false}]},\"truncated\":false},\"result\":{\"row_count\":1,\"data_array\":[[\"CREATE TABLE samples.healthverity.claims_sample_synthetic (\\n  hvid STRING COLLATE UTF8_BINARY COMMENT 'The HealthVerity universal identifier for the patient, as determined by the HealthVerity matching engine.',\\n  claim_id STRING COLLATE UTF8_BINARY COMMENT 'Uniquely identifies a single claim that was submitted for reimbursement by this data vendor.',\\n  claim_type STRING COLLATE UTF8_BINARY COMMENT 'Indicates whether the claim is a professional (P) or institutional (I) claim.',\\n  date_service STRING COLLATE UTF8_BINARY COMMENT 'The calendar date on which the services referred to in this claim were rendered. (2400/DTP03, DTP01=472)',\\n  diagnosis_code STRING COLLATE UTF8_BINARY COMMENT 'A code indicating the patient\\\\'s disease, injury, or condition, as identified by a healthcare practitioner. (2300/HI(01-12)-02)',\\n  procedure_code STRING COLLATE UTF8_BINARY COMMENT 'A code indicating the course of action taken by the healthcare practitioner. (837P 2400/SV101-02; 837I 2400/SV201, SV202)',\\n  patient_gender STRING COLLATE UTF8_BINARY COMMENT 'A single character identifying the gender of the person who received healthcare treatment. F = Female, M = Male, U = Unknown. (2010CA/DMG03)',\\n  patient_year_of_birth STRING COLLATE UTF8_BINARY COMMENT 'The four-digit year in which the patient was born. (2010CA/DMG02)',\\n  patient_zip3 STRING COLLATE UTF8_BINARY COMMENT 'The first three digits of the U.S. postal code for the residence of the person who received healthcare treatment. If not supplied by the data provider, HealthVerity may populate this field with the first three digits of the postal code for the primary care provider or the rendering provider. (2010CA/N403)',\\n  patient_state STRING COLLATE UTF8_BINARY COMMENT 'The two-character postal code for the state in which the patient resides. (2010CA/N402)',\\n  inst_admit_type_std_id STRING COLLATE UTF8_BINARY COMMENT 'A standard code indicating the priority of this admission or visit. (837I 2300/CL101)',\\n  inst_admit_source_std_id STRING COLLATE UTF8_BINARY COMMENT 'A standard code indicating the source of the referral for the admission or visit. (837I 2300/CL102)',\\n  inst_discharge_status_std_id STRING COLLATE UTF8_BINARY COMMENT 'A standard code indicating the status of the patient as of the statement end date. (837I 2300/CL103)',\\n  inst_type_of_bill_std_id STRING COLLATE UTF8_BINARY COMMENT 'A standard code identifying the type of facility where services were performed. (837I 2300/CLM05-01, CLM05-03)',\\n  inst_drg_std_id STRING COLLATE UTF8_BINARY COMMENT 'A standard diagnosis-related group code indicating the payment classification. (837I 2300/HCP06)',\\n  place_of_service_std_id STRING COLLATE UTF8_BINARY COMMENT 'A standard code indicating the facility or place where services were rendered, as maintained by the Centers for Medicare and Medicaid Services (CMS). (2400/SV105)',\\n  service_line_number STRING COLLATE UTF8_BINARY COMMENT 'An integer representing the sequence for this service line within the claim. (2400/LX01)',\\n  diagnosis_code_qual STRING COLLATE UTF8_BINARY COMMENT 'The type of code used to indicate the disease, injury, or condition. Examples: ICD-10, ICD-9.',\\n  admit_diagnosis_ind STRING COLLATE UTF8_BINARY COMMENT 'A flag indicating whether the diagnosis reported on an institutional claim represents the admitting diagnosis. (2300/HI01-02)',\\n  procedure_code_qual STRING COLLATE UTF8_BINARY COMMENT 'The type of code used to indicate the course of action taken by the healthcare practitioner. Examples: CPT, HCPCS. (837P 2400/SV101-01; 837I 2400/SV202-01)',\\n  procedure_units_billed STRING COLLATE UTF8_BINARY COMMENT 'The number of discrete actions, elements, or precisely measured amounts administered in this course of action. (837P 2400/SV104; 837I 2400/SV205)',\\n  procedure_modifier_1 STRING COLLATE UTF8_BINARY COMMENT 'Identifies the first qualifier for the procedure code. This is a code that supplies additional information about the procedure. (837P 2400/SV101-03; 837I 2400/SV202-03)',\\n  procedure_modifier_2 STRING COLLATE UTF8_BINARY COMMENT 'Identifies the second qualifier for the procedure code. This is a code that supplies additional information about the procedure. (837P 2400/SV101-04; 837I 2400/SV202-04)',\\n  procedure_modifier_3 STRING COLLATE UTF8_BINARY COMMENT 'Identifies the third qualifier for the procedure code. This is a code that supplies additional information about the procedure. (837P 2400/SV101-05; 837I 2400/SV202-05)',\\n  procedure_modifier_4 STRING COLLATE UTF8_BINARY COMMENT 'Identifies the fourth qualifier for the procedure code. This is a code that supplies additional information about the procedure. (837P 2400/SV101-06; 837I 2400/SV202-06)',\\n  revenue_code STRING COLLATE UTF8_BINARY COMMENT 'A standard NUBC revenue code from the UB claim form. (837I 2400/SV201)',\\n  line_charge STRING COLLATE UTF8_BINARY COMMENT 'The total amount charged for this service line. (837P 2400/SV102; 837I 2400/SV203)',\\n  line_allowed STRING COLLATE UTF8_BINARY COMMENT 'The total amount allowed for this service line. (2400/HCP02)',\\n  prov_rendering_npi STRING COLLATE UTF8_BINARY COMMENT 'The standard National Provider Identifier (NPI) for the provider who rendered services. (837P 2310B-2420A/NM109, NM108=XX; 837I 2310D-2420C/NM109, NM108=XX)',\\n  prov_billing_npi STRING COLLATE UTF8_BINARY COMMENT 'The standard National Provider Identifier (NPI) for the provider that billed for services. (2010AA/NM109, NM108=XX)',\\n  prov_referring_npi STRING COLLATE UTF8_BINARY COMMENT 'The standard National Provider Identifier (NPI) for the provider who referred the patient to the rendering provider. (837P 2310A/NM109, NM108=XX; 837I 2310F/NM109, NM108=XX)',\\n  payer_type STRING COLLATE UTF8_BINARY COMMENT 'A code indicating the classification for the payer.',\\n  prov_rendering_std_taxonomy STRING COLLATE UTF8_BINARY COMMENT 'The National Uniform Claim Committee (NUCC) standard taxonomy code for the provider who rendered services. (837P 2310B/PRV03; 837I 2310D/PRV03)',\\n  prov_billing_std_taxonomy STRING COLLATE UTF8_BINARY COMMENT 'The National Uniform Claim Committee (NUCC) standard taxonomy code for the provider who submitted the claim. (2000A/PRV03)',\\n  prov_referring_std_taxonomy STRING COLLATE UTF8_BINARY COMMENT 'The National Uniform Claim Committee (NUCC) standard taxonomy code for the provider who referred the patient to the rendering provider.')\\nUSING delta\\nCOMMENT 'HealthVerity synchronizes transformational technologies with the nation’s largest healthcare and consumer data ecosystem to power previously unattainable outcomes and fundamentally advance science. HealthVerity offers hundreds of data sources across medical, pharmacy, lab, biomarker, EHR, consumer, and more.\\n\\nThis sample high-fidelity synthetic dataset from HealthVerity represents 1,500+ synthetic patients modeled on de-identified medical and pharmacy claims. **This dataset is intended for educational rather than production purposes, and may be used solely in non-production settings for internal testing, evaluation and/or informational purposes, and may not be relied upon or used for general commercial use**. This is only a synthetic sample dataset meant to illustrate a small portion of the type and volume of Real-world Data that is available within the HealthVerity Marketplace ecosystem. HealthVerity would welcome the opportunity to learn more about your project, and determine the optimal patient data for your objective. For more details on our offerings, please visit our website ([https://www.healthverity.com](https://www.healthverity.com)) or contact us through [https://www.healthverity.com/contact/](https://www.healthverity.com/contact/).'\\nTBLPROPERTIES (\\n  'delta.dropFeatureTruncateHistory.retentionDuration' = '0 hours',\\n  'delta.enableChangeDataFeed' = 'true',\\n  'delta.enableDeletionVectors' = 'false',\\n  'delta.feature.appendOnly' = 'supported',\\n  'delta.feature.changeDataFeed' = 'supported',\\n  'delta.feature.invariants' = 'supported',\\n  'delta.minReaderVersion' = '1',\\n  'delta.minWriterVersion' = '7',\\n  'delta.parquet.compression.codec' = 'zstd')\\n\"]]}}"}
