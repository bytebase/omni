f the column in the key.\"},{\"name\":\"position_in_unique_constraint\",\"type_text\":\"int\",\"type_name\":\"INT\",\"position\":8,\"nullable\":true,\"comment\":\"For foreign key, position (1-based) of the column in parent unique or primary key constraint, NULL otherwise.\"}]},{\"name\":\"parameters\",\"catalog_name\":\"samples\",\"schema_name\":\"information_schema\",\"table_type\":\"VIEW\",\"view_definition\":\"SELECT * FROM system.information_schema.parameters WHERE specific_catalog = 'samples'\",\"comment\":\"Describes parameters of routines (functions) in the catalog.\",\"columns\":[{\"name\":\"specific_catalog\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"nullable\":false,\"comment\":\"Catalog containing the routine.\"},{\"name\":\"specific_schema\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":1,\"nullable\":false,\"comment\":\"Database (schema) containing the routine.\"},{\"name\":\"specific_name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":2,\"nullable\":false,\"comment\":\"Schema unique (specific) name of the routine.\"},{\"name\":\"ordinal_position\",\"type_text\":\"int\",\"type_name\":\"INT\",\"position\":3,\"nullable\":false,\"comment\":\"The position (0-based) of the parameter in the routine parameter list.\"},{\"name\":\"parameter_mode\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":4,\"nullable\":false,\"comment\":\"The parameter mode, 'IN' 'OUT' or 'INOUT.\"},{\"name\":\"is_result\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":5,\"nullable\":false,\"comment\":\"Always 'NO'. Reserved for future use.\"},{\"name\":\"as_locator\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":6,\"nullable\":false,\"comment\":\"Always 'NO'. Reserved for future use.\"},{\"name\":\"parameter_name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":7,\"nullable\":true,\"comment\":\"Name of the parameter, NULL if unnamed.\"},{\"name\":\"data_type\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":8,\"nullable\":false,\"comment\":\"The parameter data type name.\"},{\"name\":\"full_data_type\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":9,\"nullable\":false,\"comment\":\"The parameter data type definition, for example 'DECIMAL(10, 4)'.\"},{\"name\":\"character_maximum_length\",\"type_text\":\"long\",\"type_name\":\"LONG\",\"position\":10,\"nullable\":true,\"comment\":\"Always NULL, reserved for future use.\"},{\"name\":\"character_octet_length\",\"type_text\":\"long\",\"type_name\":\"LONG\",\"position\":11,\"nullable\":true,\"comment\":\"Always NULL, reserved for future use.\"},{\"name\":\"numeric_precision\",\"type_text\":\"int\",\"type_name\":\"INT\",\"position\":12,\"nullable\":true,\"comment\":\"For base-2 integral numeric types, FLOAT, and DOUBLE, the number of supported bits. For DECIMAL the number of digits, NULL otherwise.\"},{\"name\":\"numeric_precision_radix\",\"type_text\":\"int\",\"type_name\":\"INT\",\"position\":13,\"nullable\":true,\"comment\":\"For DECIMAL 10, for all other numeric types 2, NULL otherwise.\"},{\"name\":\"numeric_scale\",\"type_text\":\"int\",\"type_name\":\"INT\",\"position\":14,\"nullable\":true,\"comment\":\"For integral numeric types 0, for DECIMAL the number of digits to the right of the decimal point, NULL otherwise.\"},{\"name\":\"datetime_precision\",\"type_text\":\"int\",\"type_name\":\"INT\",\"position\":15,\"nullable\":true,\"comment\":\"For DATE 0, for TIMESTAMP, and INTERVAL … SECOND 6, any other INTERVAL 0, NULL otherwise.\"},{\"name\":\"interval_type\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":16,\"nullable\":true,\"comment\":\"For INTERVAL the unit portion of the interval, for example 'YEAR TO MONTH', NULL otherwise.\"},{\"name\":\"interval_precision\",\"type_text\":\"int\",\"type_name\":\"INT\",\"position\":17,\"nullable\":true,\"comment\":\"Always NULL, reserved for future use.\"},{\"name\":\"maximum_cardinality\",\"type_text\"