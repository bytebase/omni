| {"status":200,"contentType":"application/json","body":"{\"tables\":[{\"name\":\"clusters\",\"catalog_name\":\"system\",\"schema_name\":\"compute\",\"table_type\":\"MANAGED\",\"comment\":\"The cluster table is a slow-changing dimension table that contains the full history of compute configurations over time for all-purpose and jobs compute.\",\"columns\":[{\"name\":\"account_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"nullable\":true,\"comment\":\"ID of the account where this cluster was created.\"},{\"name\":\"workspace_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":1,\"nullable\":true,\"comment\":\"ID of the workspace where this cluster was created.\"},{\"name\":\"cluster_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":2,\"nullable\":true,\"comment\":\"ID of the cluster for which this record is associated.\"},{\"name\":\"cluster_name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":3,\"nullable\":true,\"comment\":\"User defined name for the cluster.\"},{\"name\":\"owned_by\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":4,\"nullable\":true,\"comment\":\"Username of the cluster owner. Defaults to the cluster creator, but can be changed through the [Clusters API](https://docs.databricks.com/api/workspace/clusters/changeowner).\"},{\"name\":\"create_time\",\"type_text\":\"timestamp\",\"type_name\":\"TIMESTAMP\",\"position\":5,\"nullable\":true,\"comment\":\"Timestamp of the change to this compute definition.\"},{\"name\":\"delete_time\",\"type_text\":\"timestamp\",\"type_name\":\"TIMESTAMP\",\"position\":6,\"nullable\":true,\"comment\":\"Timestamp of when the cluster was deleted. The value is null if the cluster is not deleted.\"},{\"name\":\"driver_node_type\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":7,\"nullable\":true,\"comment\":\"Driver node type name. This matches the instance type name from the cloud provider.\"},{\"name\":\"worker_node_type\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":8,\"nullable\":true,\"comment\":\"Worker node type name. This matches the instance type name from the cloud provider.\"},{\"name\":\"worker_count\",\"type_text\":\"bigint\",\"type_name\":\"LONG\",\"position\":9,\"nullable\":true,\"comment\":\"Number of workers. Defined for fixed-size clusters only.\"},{\"name\":\"min_autoscale_workers\",\"type_text\":\"bigint\",\"type_name\":\"LONG\",\"position\":10,\"nullable\":true,\"comment\":\"The set minimum number of workers. This field is valid only for autoscaling clusters.\"},{\"name\":\"max_autoscale_workers\",\"type_text\":\"bigint\",\"type_name\":\"LONG\",\"position\":11,\"nullable\":true,\"comment\":\"The set maximum number of workers. This field is valid only for autoscaling clusters.\"},{\"name\":\"auto_termination_minutes\",\"type_text\":\"bigint\",\"type_name\":\"LONG\",\"position\":12,\"nullable\":true,\"comment\":\"The configured autotermination duration.\"},{\"name\":\"enable_elastic_disk\",\"type_text\":\"boolean\",\"type_name\":\"BOOLEAN\",\"position\":13,\"nullable\":true,\"comment\":\"Autoscaling disk enablement status.\"},{\"name\":\"tags\",\"type_text\":\"map\\u003cstring,string\\u003e\",\"type_name\":\"MAP\",\"position\":14,\"nullable\":true,\"comment\":\"User-defined tags for the cluster (does not include default tags).\"},{\"name\":\"cluster_source\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":15,\"nullable\":true,\"comment\":\"Where the cluster was created. For all-purpose compute, the source could be `UI` or `API`. Other compute types are logged as `JOB`, `PIPELINE`, or `PIPELINE_MAINTENANCE`.\"},{\"name\":\"init_scripts\",\"type_text\":\"array\\u003cstring\\u003e\",\"type_name\":\"ARRAY\",\"position\":16,\"nullable\":true,\"comment\":\"Set of paths for init scripts.\"},{\"name\":\"aws_attributes\",\"type_text\":\"struct\\u003cfirst_on_demand:bigint,availability:string,zone_id:string,instance_profile_arn:string,spot_bid_price_percent:bigint,ebs_volume_type:string,ebs_volume_count:bigint,ebs_volume_size:bigint,ebs_volume_iops:bigint,ebs_volume_throughput:bigint\\u003e\",\"type_name\":\"STRUCT\",\"position\":17,\"nullable\":true,\"comment\":\"AWS specific settings.\"},{\"name\":\"azure_attributes\",\"type_text\":\"struct\\u003cfirst_on_demand:bigint,availability:string,spot_bid_max_price:double\\u003e\",\"type_name\":\"STRUCT\",\"position\":18,\"nullable\":true,\"comment\":\"Azure specific settings.\"},{\"name\":\"gcp_attributes\",\"type_text\":\"struct\\u003cuse_preemptible_executors:boolean,google_service_account:string,boot_disk_size:bigint,availability:string,zone_id:string,local_ssd_count:bigint,confidential_compute_type:string\\u003e\",\"type_name\":\"STRUCT\",\"position\":19,\"nullable\":true,\"comment\":\"GCP specific settings.\"},{\"name\":\"driver_instance_pool_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":20,\"nullable\":true,\"comment\":\"Instance pool ID if the driver is configured on top of an instance pool.\"},{\"name\":\"worker_instance_pool_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":21,\"nullable\":true,\"comment\":\"Instance Pool ID if the worker is configured on top of an instance pool.\"},{\"name\":\"dbr_version\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":22,\"nullable\":true,\"comment\":\"The Databricks Runtime of the cluster.\"},{\"name\":\"change_time\",\"type_text\":\"timestamp\",\"type_name\":\"TIMESTAMP\",\"position\":23,\"nullable\":true,\"comment\":\"Timestamp of change to the compute definition.\"},{\"name\":\"change_date\",\"type_text\":\"date\",\"type_name\":\"DATE\",\"position\":24,\"nullable\":true,\"comment\":\"Change date. Used for retention.\"},{\"name\":\"data_security_mode\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":25,\"nullable\":true,\"comment\":\"Data security mode decides what data governance model to use when accessing data from a cluster.\"},{\"name\":\"policy_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":26,\"nullable\":true,\"comment\":\"The ID of the cluster policy used to create the cluster if applicable.\"}]},{\"name\":\"instance_events\",\"catalog_name\":\"system\",\"schema_name\":\"compute\",\"table_type\":\"MANAGED\",\"comment\":\"The instance_events table captures state transitions of classic compute instances.\",\"columns\":[{\"name\":\"account_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"nullable\":true,\"comment\":\"ID of the account where this instance is launched.\"},{\"name\":\"workspace_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":1,\"nullable\":true,\"comment\":\"ID of the workspace where this instance is launched.\"},{\"name\":\"instance_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":2,\"nullable\":true,\"comment\":\"ID of the instance.\"},{\"name\":\"event_time\",\"type_text\":\"timestamp\",\"type_name\":\"TIMESTAMP\",\"position\":3,\"nullable\":true,\"comment\":\"Timestamp of the event.\"},{\"name\":\"event_type\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":4,\"nullable\":true,\"comment\":\"Event type. Possible values: INSTANCE_LAUNCHING, STATE_TRANSITION.\"},{\"name\":\"instance_pool_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":5,\"nullable\":true,\"comment\":\"Instance pool ID if the instance belongs to a pool.\"},{\"name\":\"cluster_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":6,\"nullable\":true,\"comment\":\"ID of the cluster this instance belongs to.\"},{\"name\":\"node_type\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":7,\"nullable\":true,\"comment\":\"The name of the node type. This will match the instance type name from the cloud provider.\"},{\"name\":\"state\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":8,\"nullable\":true,\"comment\":\"Instance state. Possible values: INSTANCE_LAUNCHING, INSTANCE_READY, INSTANCE_PLACED, INSTANCE_TERMINATED.\"},{\"name\":\"availability_type\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":9,\"nullable\":true,\"comment\":\"Availability type of the instance. Possible values: ON_DEMAND, SPOT.\"}]},{\"name\":\"instance_pools\",\"catalog_name\":\"system\",\"schema_name\":\"compute\",\"table_type\":\"MANAGED\",\"comment\":\"The instance_pools table is a slow-changing dimension table that contains the full history of instance pool configurations over time.\",\"columns\":[{\"name\":\"account_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"nullable\":true,\"comment\":\"ID of the account where this instance pool was created.\"},{\"name\":\"workspace_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":1,\"nullable\":true,\"comment\":\"ID of the workspace where this instance pool was created.\"},{\"name\":\"instance_pool_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":2,\"nullable\":true,\"comment\":\"ID of the instance pool.\"},{\"name\":\"change_time\",\"type_text\":\"timestamp\",\"type_name\":\"TIMESTAMP\",\"position\":3,\"nullable\":true,\"comment\":\"Timestamp of change to instance pool configuration.\"},{\"name\":\"create_time\",\"type_text\":\"timestamp\",\"type_name\":\"TIMESTAMP\",\"position\":4,\"nullable\":true,\"comment\":\"Timestamp of instance pool creation.\"},{\"name\":\"delete_time\",\"type_text\":\"timestamp\",\"type_name\":\"TIMESTAMP\",\"position\":5,\"nullable\":true,\"comment\":\"Timestamp of instance pool deletion. The value is null if the instance pool is not deleted.\"},{\"name\":\"instance_pool_name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":6,\"nullable\":true,\"comment\":\"User defined name of the instance pool.\"},{\"name\":\"tags\",\"type_text\":\"map\\u003cstring,string\\u003e\",\"type_name\":\"MAP\",\"position\":7,\"nullable\":true,\"comment\":\"User-defined tags for the instance pool (does not include default tags).\"},{\"name\":\"node_type\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":8,\"nullable\":true,\"comment\":\"Node type used for instances in the pool. This matches the instance type name from the cloud provider.\"},{\"name\":\"idle_instance_autotermination_minutes\",\"type_text\":\"bigint\",\"type_name\":\"LONG\",\"position\":9,\"nullable\":true,\"comment\":\"The extra instances in the pool cache are automatically terminated after they are inactive for this time in minutes.\"},{\"name\":\"min_idle_instances\",\"type_text\":\"bigint\",\"type_name\":\"LONG\",\"position\":10,\"nullable\":true,\"comment\":\"Minimum number of idle instances to keep in the instance pool.\"},{\"name\":\"max_capacity\",\"type_text\":\"bigint\",\"type_name\":\"LONG\",\"position\":11,\"nullable\":true,\"comment\":\"Maximum number of outstanding instances to keep in the pool, including both instances used by clusters and idle instances.\"},{\"name\":\"enable_elastic_disk\",\"type_text\":\"boolean\",\"type_name\":\"BOOLEAN\",\"position\":12,\"nullable\":true,\"comment\":\"Autoscaling Local Storage: when enabled, this instances in this pool will dynamically acquire additional disk space when its Spark workers are running low on disk space.\"},{\"name\":\"disk_spec\",\"type_text\":\"struct\\u003cdisk_type:string,disk_count:bigint,disk_size:bigint,disk_iops:bigint,disk_throughput:bigint\\u003e\",\"type_name\":\"STRUCT\",\"position\":13,\"nullable\":true,\"comment\":\"The specification of the disks that will be attached to all spark containers.\"},{\"name\":\"preloaded_docker_images\",\"type_text\":\"array\\u003cstring\\u003e\",\"type_name\":\"ARRAY\",\"position\":14,\"nullable\":true,\"comment\":\"Custom Docker images preloaded on the pool instances (Databricks Container Services).\"},{\"name\":\"preloaded_spark_version\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":15,\"nullable\":true,\"comment\":\"Preloaded Spark image version for the pool, if defined.\"},{\"name\":\"aws_attributes\",\"type_text\":\"struct\\u003cavailability:string,zone_id:string,spot_bid_price_percent:bigint\\u003e\",\"type_name\":\"STRUCT\",\"position\":16,\"nullable\":true,\"comment\":\"Attributes related to instance pools running on AWS.\"},{\"name\":\"azure_attributes\",\"type_text\":\"struct\\u003cavailability:string,spot_bid_max_price:double\\u003e\",\"type_name\":\"STRUCT\",\"position\":17,\"nullable\":true,\"comment\":\"Attributes related to instance pools running on Azure.\"},{\"name\":\"gcp_attributes\",\"type_text\":\"struct\\u003czone_id:string,local_ssd_count:bigint,availability:string\\u003e\",\"type_name\":\"STRUCT\",\"position\":18,\"nullable\":true,\"comment\":\"Attributes related to instance pools running on GCP.\"}]},{\"name\":\"node_timeline\",\"catalog_name\":\"system\",\"schema_name\":\"compute\",\"table_type\":\"MANAGED\",\"comment\":\"The node timeline table captures node-level resource utilization data at minute granularity. Each record contains data for a given minute of time per instance.\",\"columns\":[{\"name\":\"account_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"nullable\":true,\"comment\":\"ID of the account where this compute resource is running.\"},{\"name\":\"workspace_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":1,\"nullable\":true,\"comment\":\"ID of the workspace where this compute resource is running.\"},{\"name\":\"cluster_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":2,\"nullable\":true,\"comment\":\"ID of the compute resource.\"},{\"name\":\"instance_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":3,\"nullable\":true,\"comment\":\"ID for the specific instance.\"},{\"name\":\"start_time\",\"type_text\":\"timestamp\",\"type_name\":\"TIMESTAMP\",\"position\":4,\"nullable\":true,\"comment\":\"Start time for the record in UTC.\"},{\"name\":\"end_time\",\"type_text\":\"timestamp\",\"type_name\":\"TIMESTAMP\",\"position\":5,\"nullable\":true,\"comment\":\"End time for the record in UTC.\"},{\"name\":\"driver\",\"type_text\":\"boolean\",\"type_name\":\"BOOLEAN\",\"position\":6,\"nullable\":true,\"comment\":\"Whether the instance is a driver or worker node.\"},{\"name\":\"cpu_user_percent\",\"type_text\":\"double\",\"type_name\":\"DOUBLE\",\"position\":7,\"nullable\":true,\"comment\":\"Percentage of time the CPU spent in userland.\"},{\"name\":\"cpu_system_percent\",\"type_text\":\"double\",\"type_name\":\"DOUBLE\",\"position\":8,\"nullable\":true,\"comment\":\"Percentage of time the CPU spent in the kernel.\"},{\"name\":\"cpu_wait_percent\",\"type_text\":\"double\",\"type_name\":\"DOUBLE\",\"position\":9,\"nullable\":true,\"comment\":\"Percentage of time the CPU spent waiting for I/O.\"},{\"name\":\"mem_used_percent\",\"type_text\":\"double\",\"type_name\":\"DOUBLE\",\"position\":10,\"nullable\":true,\"comment\":\"Percentage of the compute's memory that was used during the time period (including memory used by background processes running on the compute).\"},{\"name\":\"mem_swap_percent\",\"type_text\":\"double\",\"type_name\":\"DOUBLE\",\"position\":11,\"nullable\":true,\"comment\":\"Percentage of memory usage attributed to memory swap.\"},{\"name\":\"network_sent_bytes\",\"type_text\":\"bigint\",\"type_name\":\"LONG\",\"position\":12,\"nullable\":true,\"comment\":\"The number of bytes sent out in network traffic.\"},{\"name\":\"network_received_bytes\",\"type_text\":\"bigint\",\"type_name\":\"LONG\",\"position\":13,\"nullable\":true,\"comment\":\"The number of received bytes from network traffic.\"},{\"name\":\"disk_free_bytes_per_mount_point\",\"type_text\":\"map\\u003cstring,bigint\\u003e\",\"type_name\":\"MAP\",\"position\":14,\"nullable\":true,\"comment\":\"The disk utilization grouped by mount point. This is ephemeral storage provisioned only while the compute is running.\"},{\"name\":\"node_type\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":15,\"nullable\":true,\"comment\":\"The name of the node type. This will match the instance type name from the cloud provider.\"},{\"name\":\"private_ip\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":16,\"nullable\":true,\"comment\":\"Private IP.\"},{\"name\":\"spark_jvm_heap_usage_bytes\",\"type_text\":\"bigint\",\"type_name\":\"LONG\",\"position\":17,\"nullable\":true,\"comment\":\"The amount of JVM heap memory currently used by Spark.\"},{\"name\":\"spark_jvm_heap_limit_bytes\",\"type_text\":\"bigint\",\"type_name\":\"LONG\",\"position\":18,\"nullable\":true,\"comment\":\"The maximum heap memory available for Spark to allocate.\"},{\"name\":\"shared_container_memory_limit_bytes\",\"type_text\":\"bigint\",\"type_name\":\"LONG\",\"position\":19,\"nullable\":true,\"comment\":\"The total memory limit shared across running containers.\"},{\"name\":\"spark_container_memory_used_bytes\",\"type_text\":\"bigint\",\"type_name\":\"LONG\",\"position\":20,\"nullable\":true,\"comment\":\"The amount of non-reclaimable memory currently used within the Spark container.\"},{\"name\":\"spark_container_memory_file_cache_bytes\",\"type_text\":\"bigint\",\"type_name\":\"LONG\",\"position\":21,\"nullable\":true,\"comment\":\"The amount of reclaimable memory used for file caching within the Spark container.\"}]},{\"name\":\"node_types\",\"catalog_name\":\"system\",\"schema_name\":\"compute\",\"table_type\":\"MANAGED\",\"comment\":\"The node type table captures the currently available node types with their basic hardware information\",\"columns\":[{\"name\":\"account_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"nullable\":true,\"comment\":\"ID of the account where this node type is available.\"},{\"name\":\"node_type\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":1,\"nullable\":true,\"comment\":\"Unique identifier for node type.\"},{\"name\":\"core_count\",\"type_text\":\"double\",\"type_name\":\"DOUBLE\",\"position\":2,\"nullable\":true,\"comment\":\"Number of vCPUs for the instance.\"},{\"name\":\"memory_mb\",\"type_text\":\"bigint\",\"type_name\":\"LONG\",\"position\":3,\"nullable\":true,\"comment\":\"Total memory for the instance.\"},{\"name\":\"gpu_count\",\"type_text\":\"bigint\",\"type_name\":\"LONG\",\"position\":4,\"nullable\":true,\"comment\":\"Number of GPUs for the instance.\"}]},{\"name\":\"warehouse_events\",\"catalog_name\":\"system\",\"schema_name\":\"compute\",\"table_type\":\"MANAGED\",\"comment\":\"The Warehouse events table table captures events related to SQL warehouses. For example, starting, stopping, running, scaling up and down\",\"columns\":[{\"name\":\"account_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"nullable\":true,\"comment\":\"The ID of the Databricks account.\"},{\"name\":\"workspace_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":1,\"nullable\":true,\"comment\":\"The ID of the workspace where the warehouse is deployed.\"},{\"name\":\"warehouse_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":2,\"nullable\":true,\"comment\":\"The ID of SQL warehouse the event is related to.\"},{\"name\":\"event_type\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":3,\"nullable\":true,\"comment\":\"The type of warehouse event. Possible values are SCALED_UP, SCALED_DOWN, STOPPING, RUNNING, STARTING, and STOPPED.\"},{\"name\":\"cluster_count\",\"type_text\":\"int\",\"type_name\":\"INT\",\"position\":4,\"nullable\":true,\"comment\":\"The number of clusters that are actively running.\"},{\"name\":\"event_time\",\"type_text\":\"timestamp\",\"type_name\":\"TIMESTAMP\",\"position\":5,\"nullable\":true,\"comment\":\"Timestamp of when the event took place in UTC.\"}]},{\"name\":\"warehouses\",\"catalog_name\":\"system\",\"schema_name\":\"compute\",\"table_type\":\"MANAGED\",\"comment\":\"The Warehouses table contains the full history of configurations over time for any SQL warehouse.\",\"columns\":[{\"name\":\"warehouse_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"nullable\":true,\"comment\":\"The ID of the SQL warehouse.\"},{\"name\":\"workspace_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":1,\"nullable\":true,\"comment\":\"The ID of the workspace where the warehouse is deployed.\"},{\"name\":\"account_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":2,\"nullable\":true,\"comment\":\"The ID of the Databricks account.\"},{\"name\":\"warehouse_name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":3,\"nullable\":true,\"comment\":\"The name of the SQL warehouse.\"},{\"name\":\"warehouse_type\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":4,\"nullable\":true,\"comment\":\"The type of SQL warehouse. Possible values are CLASSIC, PRO, REAL_TIME, and SERVERLESS.\"},{\"name\":\"warehouse_channel\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":5,\"nullable\":true,\"comment\":\"The channel of the SQL warehouse. Possible values are CURRENT and PREVIEW.\"},{\"name\":\"warehouse_size\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":6,\"nullable\":true,\"comment\":\"The cluster size of the SQL warehouse. Possible values are 2X_SMALL, X_SMALL, SMALL, MEDIUM, LARGE, X_LARGE, 2X_LARGE, 3X_LARGE, 4X_LARGE, 5X_LARGE, and AUTO.\"},{\"name\":\"min_clusters\",\"type_text\":\"int\",\"type_name\":\"INT\",\"position\":7,\"nullable\":true,\"comment\":\"The minimum number of clusters permitted.\"},{\"name\":\"max_clusters\",\"type_text\":\"int\",\"type_name\":\"INT\",\"position\":8,\"nullable\":true,\"comment\":\"The maximum number of clusters permitted.\"},{\"name\":\"auto_stop_minutes\",\"type_text\":\"int\",\"type_name\":\"INT\",\"position\":9,\"nullable\":true,\"comment\":\"The number of minutes before the SQL warehouse auto-stops due to inactivity.\"},{\"name\":\"tags\",\"type_text\":\"map\\u003cstring,string\\u003e\",\"type_name\":\"MAP\",\"position\":10,\"nullable\":true,\"comment\":\"Tags for the SQL warehouse.\"},{\"name\":\"change_time\",\"type_text\":\"timestamp\",\"type_name\":\"TIMESTAMP\",\"position\":11,\"nullable\":true,\"comment\":\"Timestamp of change to the SQL warehouse definition.\"},{\"name\":\"delete_time\",\"type_text\":\"timestamp\",\"type_name\":\"TIMESTAMP\",\"position\":12,\"nullable\":true,\"comment\":\"Timestamp of when the SQL warehouse was deleted. The value is null if the SQL warehouse is not deleted.\"},{\"name\":\"created_by\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":13,\"nullable\":true,\"comment\":\"The name of the Databricks principal, user, or group that created this warehouse.\"}]}]}"}
