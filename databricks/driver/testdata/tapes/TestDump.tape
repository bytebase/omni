| {"status":200,"contentType":"application/json","body":"{\"tables\":[{\"name\":\"amenities\",\"catalog_name\":\"samples\",\"schema_name\":\"wanderbricks\",\"table_type\":\"MANAGED\",\"comment\":\"Contains data about Wanderbricks property amenities.\",\"columns\":[{\"name\":\"amenity_id\",\"type_text\":\"bigint\",\"type_name\":\"LONG\",\"nullable\":false,\"comment\":\"Unique identifier of the amenity\"},{\"name\":\"name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":1,\"nullable\":true,\"comment\":\"Name of the amenity (e.g., Wi-Fi, Pool)\"},{\"name\":\"category\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":2,\"nullable\":true,\"comment\":\"Category of the amenity (e.g.,  Basic, Luxury)\"},{\"name\":\"icon\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":3,\"nullable\":true,\"comment\":\"Icon representing the amenity\"}]},{\"name\":\"booking_updates\",\"catalog_name\":\"samples\",\"schema_name\":\"wanderbricks\",\"table_type\":\"MANAGED\",\"comment\":\"A stream of updates to the `bookings` table\",\"columns\":[{\"name\":\"booking_id\",\"type_text\":\"bigint\",\"type_name\":\"LONG\",\"nullable\":true,\"comment\":\"The identified of the booking being updated\"},{\"name\":\"booking_update_id\",\"type_text\":\"bigint\",\"type_name\":\"LONG\",\"position\":1,\"nullable\":false,\"comment\":\"Uniquely identifies this update\"},{\"name\":\"check_in\",\"type_text\":\"date\",\"type_name\":\"DATE\",\"position\":2,\"nullable\":true,\"comment\":\"The new check-in date\"},{\"name\":\"check_out\",\"type_text\":\"date\",\"type_name\":\"DATE\",\"position\":3,\"nullable\":true,\"comment\":\"The new check-out date\"},{\"name\":\"created_at\",\"type_text\":\"timestamp\",\"type_name\":\"TIMESTAMP\",\"position\":4,\"nullable\":true,\"comment\":\"The date the booking was created (must match the booking) or be null\"},{\"name\":\"guests_count\",\"type_text\":\"int\",\"type_name\":\"INT\",\"position\":5,\"nullable\":true,\"comment\":\"The new number of guests\"},{\"name\":\"property_id\",\"type_text\":\"bigint\",\"type_name\":\"LONG\",\"position\":6,\"nullable\":true,\"comment\":\"The identifier of the booked property (must match the property of the booking)\"},{\"name\":\"status\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":7,\"nullable\":true,\"comment\":\"The new status for the booking\"},{\"name\":\"total_amount\",\"type_text\":\"float\",\"type_name\":\"FLOAT\",\"position\":8,\"nullable\":true,\"comment\":\"The new total amount due\"},{\"name\":\"updated_at\",\"type_text\":\"timestamp\",\"type_name\":\"TIMESTAMP\",\"position\":9,\"nullable\":true,\"comment\":\"The date this update was created\"},{\"name\":\"user_id\",\"type_text\":\"bigint\",\"type_name\":\"LONG\",\"position\":10,\"nullable\":true,\"comment\":\"The user that created/updated the booking\"}]},{\"name\":\"bookings\",\"catalog_name\":\"samples\",\"schema_name\":\"wanderbricks\",\"table_type\":\"MANAGED\",\"comment\":\"Contains data about Wanderbricks property bookings.\",\"columns\":[{\"name\":\"booking_id\",\"type_text\":\"bigint\",\"type_name\":\"LONG\",\"nullable\":false,\"comment\":\"Unique identifier of the booking\"},{\"name\":\"user_id\",\"type_text\":\"bigint\",\"type_name\":\"LONG\",\"position\":1,\"nullable\":true,\"comment\":\"The identifier of the user making the booking\"},{\"name\":\"property_id\",\"type_text\":\"bigint\",\"type_name\":\"LONG\",\"position\":2,\"nullable\":true,\"comment\":\"Foreign Key to 'properties'\"},{\"name\":\"check_in\",\"type_text\":\"date\",\"type_name\":\"DATE\",\"position\":3,\"nullable\":true,\"comment\":\"Check-in date\"},{\"name\":\"check_out\",\"type_text\":\"date\",\"type_name\":\"DATE\",\"position\":4,\"nullable\":true,\"comment\":\"Check-out date\"},{\"name\":\"guests_count\",\"type_text\":\"int\",\"type_name\":\"INT\",\"position\":5,\"nullable\":true,\"comment\":\"Number of guests for booking\"},{\"name\":\"total_amount\",\"type_text\":\"float\",\"type_name\":\"FLOAT\",\"position\":6,\"nullable\":true,\"comment\":\"Total amount paid\"},{\"name\":\"status\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":7,\"nullable\":true,\"comment\":\"Status of the booking (e.g., pending, confirmed)\"},{\"name\":\"created_at\",\"type_text\":\"timestamp\",\"type_name\":\"TIMESTAMP\",\"position\":8,\"nullable\":true,\"comment\":\"Date the booking was created\"},{\"name\":\"updated_at\",\"type_text\":\"timestamp\",\"type_name\":\"TIMESTAMP\",\"position\":9,\"nullable\":true,\"comment\":\"Date the booking was last updated\"}]},{\"name\":\"clickstream\",\"catalog_name\":\"samples\",\"schema_name\":\"wanderbricks\",\"table_type\":\"MANAGED\",\"comment\":\"A stream of user interactions with the website\",\"columns\":[{\"name\":\"event\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"nullable\":true,\"comment\":\"The type of event that occurred: \\n        - 'view' (user views a property)\\n        - 'click' (user clicks on property or related element)\\n        - 'search' (user conducts a search)\\n        - 'filter' (user applies a filter to refine search results)\"},{\"name\":\"metadata\",\"type_text\":\"struct\\u003cdevice:string,referrer:string\\u003e\",\"type_name\":\"STRUCT\",\"position\":1,\"nullable\":true,\"comment\":\"A nested dictionary containing additional details about the event:\\n        - 'device': The type of device used, e.g. 'desktop', 'mobile', 'tablet'\\n        - 'referrer': The source of the traffic, e.g 'google', 'direct', 'email', 'ad'\\n        \"},{\"name\":\"property_id\",\"type_text\":\"bigint\",\"type_name\":\"LONG\",\"position\":2,\"nullable\":true,\"comment\":\"The property that the user is interacting with\"},{\"name\":\"timestamp\",\"type_text\":\"timestamp\",\"type_name\":\"TIMESTAMP\",\"position\":3,\"nullable\":true,\"comment\":\"The timestamp of the interaction\"},{\"name\":\"user_id\",\"type_text\":\"bigint\",\"type_name\":\"LONG\",\"position\":4,\"nullable\":true,\"comment\":\"The user that created/updated the booking\"}]},{\"name\":\"countries\",\"catalog_name\":\"samples\",\"schema_name\":\"wanderbricks\",\"table_type\":\"MANAGED\",\"comment\":\"Contains data about countries.\",\"columns\":[{\"name\":\"country\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"nullable\":false,\"comment\":\"The name of the country (Primary Key\"},{\"name\":\"country_code\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":1,\"nullable\":true,\"comment\":\"The ISO country code (2-letter)\"},{\"name\":\"continent\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":2,\"nullable\":true,\"comment\":\"The continent the country is located in\"}]},{\"name\":\"customer_support_logs\",\"catalog_name\":\"samples\",\"schema_name\":\"wanderbricks\",\"table_type\":\"MANAGED\",\"comment\":\"Tracks customer support interactions\",\"columns\":[{\"name\":\"created_at\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"nullable\":true,\"comment\":\"The date the ticket was created\"},{\"name\":\"messages\",\"type_text\":\"array\\u003cstruct\\u003cmessage:string,sender:string,sentiment:string,timestamp:string\\u003e\\u003e\",\"type_name\":\"ARRAY\",\"position\":1,\"nullable\":true,\"comment\":\"List of messages in the ticket.\"},{\"name\":\"support_agent_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":2,\"nullable\":true,\"comment\":\"identifier for the support agent\"},{\"name\":\"ticket_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":3,\"nullable\":false,\"comment\":\"The ticket assigned to the interaction\"},{\"name\":\"user_id\",\"type_text\":\"bigint\",\"type_name\":\"LONG\",\"position\":4,\"nullable\":true,\"comment\":\"The user that contacted customer support\"}]},{\"name\":\"destinations\",\"catalog_name\":\"samples\",\"schema_name\":\"wanderbricks\",\"table_type\":\"MANAGED\",\"comment\":\"Contains data about world destinations.\",\"columns\":[{\"name\":\"destination_id\",\"type_text\":\"bigint\",\"type_name\":\"LONG\",\"nullable\":false,\"comment\":\"Primary Key\"},{\"name\":\"destination\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":1,\"nullable\":true,\"comment\":\"Name of the destination\"},{\"name\":\"country\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":2,\"nullable\":true,\"comment\":\"Name of the country\"},{\"name\":\"state_or_province\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":3,\"nullable\":true,\"comment\":\"The name of the state, province or region the destination is located in\"},{\"name\":\"state_or_province_code\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":4,\"nullable\":true,\"comment\":\"The code of the state, province or region the destination is located in\"},{\"name\":\"description\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":5,\"nullable\":true,\"comment\":\"Detailed description of the destination. This column has text data (Markdown format) containing summary information of the destination about tourist destinations, destination demographics, historical and geographical information, and popular cuisine you can find in the destination. Additionally, tourists might find transportation and travel guidelines helpful.\"}]},{\"name\":\"employees\",\"catalog_name\":\"samples\",\"schema_name\":\"wanderbricks\",\"table_type\":\"MANAGED\",\"comment\":\"Contains data about Wanderbricks property hosts' employees.\",\"columns\":[{\"name\":\"employee_id\",\"type_text\":\"bigint\",\"type_name\":\"LONG\",\"nullable\":false,\"comment\":\"Unique identifier of the employee\"},{\"name\":\"host_id\",\"type_text\":\"bigint\",\"type_name\":\"LONG\",\"position\":1,\"nullable\":true,\"comment\":\"The identifier of the host employer of this employee\"},{\"name\":\"name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":2,\"nullable\":true,\"comment\":\"Employee's full name\"},{\"name\":\"role\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":3,\"nullable\":true,\"comment\":\"Employee's role (e.g., cleaner, chef)\"},{\"name\":\"email\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":4,\"nullable\":true,\"comment\":\"Employee's email address\"},{\"name\":\"phone\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":5,\"nullable\":true,\"comment\":\"Employee's phone number\"},{\"name\":\"country\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":6,\"nullable\":true,\"comment\":\"Employee's country of employment\"},{\"name\":\"joined_at\",\"type_text\":\"date\",\"type_name\":\"DATE\",\"position\":7,\"nullable\":true,\"comment\":\"Date the employee joined\"},{\"name\":\"end_service_date\",\"type_text\":\"date\",\"type_name\":\"DATE\",\"position\":8,\"nullable\":true,\"comment\":\"Date the employee left if the employee has left\"},{\"name\":\"is_currently_employed\",\"type_text\":\"boolean\",\"type_name\":\"BOOLEAN\",\"position\":9,\"nullable\":true,\"comment\":\"Boolean indicating if the employee is currently active\"}]},{\"name\":\"hosts\",\"catalog_name\":\"samples\",\"schema_name\":\"wanderbricks\",\"table_type\":\"MANAGED\",\"comment\":\"Contains data about Wanderbricks property hosts.\",\"columns\":[{\"name\":\"host_id\",\"type_text\":\"bigint\",\"type_name\":\"LONG\",\"nullable\":false,\"comment\":\"Unique identifier of the host\"},{\"name\":\"name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":1,\"nullable\":true,\"comment\":\"Host's full name\"},{\"name\":\"email\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":2,\"nullable\":true,\"comment\":\"Hosts's email address\"},{\"name\":\"phone\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":3,\"nullable\":true,\"comment\":\"Host's phone number\"},{\"name\":\"is_verified\",\"type_text\":\"boolean\",\"type_name\":\"BOOLEAN\",\"position\":4,\"nullable\":true,\"comment\":\"Verification status of the host\"},{\"name\":\"is_active\",\"type_text\":\"boolean\",\"type_name\":\"BOOLEAN\",\"position\":5,\"nullable\":true,\"comment\":\"Active status of the host\"},{\"name\":\"rating\",\"type_text\":\"float\",\"type_name\":\"FLOAT\",\"position\":6,\"nullable\":true,\"comment\":\"Host rating (1.0-5.0)\"},{\"name\":\"country\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":7,\"nullable\":true,\"comment\":\"Host's country of residence\"},{\"name\":\"joined_at\",\"type_text\":\"date\",\"type_name\":\"DATE\",\"position\":8,\"nullable\":true,\"comment\":\"Date the host joined\"}]},{\"name\":\"page_views\",\"catalog_name\":\"samples\",\"schema_name\":\"wanderbricks\",\"table_type\":\"MANAGED\",\"comment\":\"Tracks user interactions with property pages\",\"columns\":[{\"name\":\"device_type\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"nullable\":true,\"comment\":\"Type of device used (e.g., desktop', 'mobile', 'tablet')\"},{\"name\":\"page_url\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":1,\"nullable\":true,\"comment\":\"URL of the viewed page\"},{\"name\":\"property_id\",\"type_text\":\"bigint\",\"type_name\":\"LONG\",\"position\":2,\"nullable\":true,\"comment\":\"The property that was viewed\"},{\"name\":\"referrer\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":3,\"nullable\":true,\"comment\":\"Referrer source (e.g., 'google', 'direct', 'email', 'ad')\"},{\"name\":\"timestamp\",\"type_text\":\"timestamp\",\"type_name\":\"TIMESTAMP\",\"position\":4,\"nullable\":true,\"comment\":\"The payment method used\"},{\"name\":\"user_id\",\"type_text\":\"bigint\",\"type_name\":\"LONG\",\"position\":5,\"nullable\":true,\"comment\":\"The user that viewed the property\"},{\"name\":\"view_id\",\"type_text\":\"bigint\",\"type_name\":\"LONG\",\"position\":6,\"nullable\":false,\"comment\":\"Uniquely identifies this view\"}]},{\"name\":\"payments\",\"catalog_name\":\"samples\",\"schema_name\":\"wanderbricks\",\"table_type\":\"MANAGED\",\"comment\":\"Represents payments for bookings\",\"columns\":[{\"name\":\"payment_id\",\"type_text\":\"bigint\",\"type_name\":\"LONG\",\"nullable\":false,\"comment\":\"Uniquely identifies this payment\"},{\"name\":\"booking_id\",\"type_text\":\"bigint\",\"type_name\":\"LONG\",\"position\":1,\"nullable\":true,\"comment\":\"The booking that was paid for\"},{\"name\":\"amount\",\"type_text\":\"decimal(15,4)\",\"type_name\":\"DECIMAL\",\"position\":2,\"nullable\":true,\"comment\":\"The amount paid\"},{\"name\":\"payment_method\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":3,\"nullable\":true,\"comment\":\"The method used for payment (e.g., 'credit_card', 'paypal', 'apple_pay', 'google_pay', 'bank_transfer')\"},{\"name\":\"status\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":4,\"nullable\":true,\"comment\":\"The status of the payment (e.g., 'pending', 'completed', 'failed', 'refunded')\"},{\"name\":\"payment_date\",\"type_text\":\"timestamp\",\"type_name\":\"TIMESTAMP\",\"position\":5,\"nullable\":true,\"comment\":\"The date the payment was made\"}]},{\"name\":\"properties\",\"catalog_name\":\"samples\",\"schema_name\":\"wanderbricks\",\"table_type\":\"MANAGED\",\"comment\":\"Contains data about Wanderbricks properties.\",\"columns\":[{\"name\":\"property_id\",\"type_text\":\"bigint\",\"type_name\":\"LONG\",\"nullable\":false,\"comment\":\"Unique identifier of this property\"},{\"name\":\"host_id\",\"type_text\":\"bigint\",\"type_name\":\"LONG\",\"position\":1,\"nullable\":true,\"comment\":\"The identifier of the host of this property\"},{\"name\":\"destination_id\",\"type_text\":\"bigint\",\"type_name\":\"LONG\",\"position\":2,\"nullable\":true,\"comment\":\"Foreign Key to 'destinations'\"},{\"name\":\"title\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":3,\"nullable\":true,\"comment\":\"Title of the property listing\"},{\"name\":\"description\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":4,\"nullable\":true,\"comment\":\"Description of the property\"},{\"name\":\"base_price\",\"type_text\":\"float\",\"type_name\":\"FLOAT\",\"position\":5,\"nullable\":true,\"comment\":\"Base price for booking\"},{\"name\":\"property_type\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":6,\"nullable\":true,\"comment\":\"Type of property (e.g., house, apartment)\"},{\"name\":\"max_guests\",\"type_text\":\"int\",\"type_name\":\"INT\",\"position\":7,\"nullable\":true,\"comment\":\"Maximum number of guests allowed\"},{\"name\":\"bedrooms\",\"type_text\":\"int\",\"type_name\":\"INT\",\"position\":8,\"nullable\":true,\"comment\":\"Number of bedrooms\"},{\"name\":\"bathrooms\",\"type_text\":\"int\",\"type_name\":\"INT\",\"position\":9,\"nullable\":true,\"comment\":\"Number of bathrooms\"},{\"name\":\"property_latitude\",\"type_text\":\"float\",\"type_name\":\"FLOAT\",\"position\":10,\"nullable\":true,\"comment\":\"Latitude of the property location\"},{\"name\":\"property_longitude\",\"type_text\":\"float\",\"type_name\":\"FLOAT\",\"position\":11,\"nullable\":true,\"comment\":\"Longitude of the property location\"},{\"name\":\"created_at\",\"type_text\":\"date\",\"type_name\":\"DATE\",\"position\":12,\"nullable\":true,\"comment\":\"Date the property was listed\"}]},{\"name\":\"property_amenities\",\"catalog_name\":\"samples\",\"schema_name\":\"wanderbricks\",\"table_type\":\"MANAGED\",\"comment\":\"Contains data about Wanderbricks property amenities.\",\"columns\":[{\"name\":\"property_id\",\"type_text\":\"bigint\",\"type_name\":\"LONG\",\"nullable\":false,\"comment\":\"Foreign Key to 'properties'\"},{\"name\":\"amenity_id\",\"type_text\":\"bigint\",\"type_name\":\"LONG\",\"position\":1,\"nullable\":false,\"comment\":\"Foreign Key to 'amenities'\"}]},{\"name\":\"property_images\",\"catalog_name\":\"samples\",\"schema_name\":\"wanderbricks\",\"table_type\":\"MANAGED\",\"comment\":\"Contains data about Wanderbricks property images.\",\"columns\":[{\"name\":\"image_id\",\"type_text\":\"bigint\",\"type_name\":\"LONG\",\"nullable\":false,\"comment\":\"Unique identifier of the property image\"},{\"name\":\"property_id\",\"type_text\":\"bigint\",\"type_name\":\"LONG\",\"position\":1,\"nullable\":true,\"comment\":\"The identifier of the property for this image\"},{\"name\":\"url\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":2,\"nullable\":true,\"comment\":\"URL of the image\"},{\"name\":\"sequence\",\"type_text\":\"int\",\"type_name\":\"INT\",\"position\":3,\"nullable\":true,\"comment\":\"the order in which to show the images\"},{\"name\":\"is_primary\",\"type_text\":\"boolean\",\"type_name\":\"BOOLEAN\",\"position\":4,\"nullable\":true,\"comment\":\"Boolean indicating if the image is primary\"},{\"name\":\"uploaded_at\",\"type_text\":\"date\",\"type_name\":\"DATE\",\"position\":5,\"nullable\":true,\"comment\":\"Date the image was uploaded\"}]},{\"name\":\"reviews\",\"catalog_name\":\"samples\",\"schema_name\":\"wanderbricks\",\"table_type\":\"MANAGED\",\"comment\":\"Represents user reviews for properties\",\"columns\":[{\"name\":\"booking_id\",\"type_text\":\"bigint\",\"type_name\":\"LONG\",\"nullable\":true,\"comment\":\"The booking that was reviewed\"},{\"name\":\"comment\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":1,\"nullable\":true,\"comment\":\"User's review comment\"},{\"name\":\"created_at\",\"type_text\":\"timestamp\",\"type_name\":\"TIMESTAMP\",\"position\":2,\"nullable\":true,\"comment\":\"The date the review was created\"},{\"name\":\"is_deleted\",\"type_text\":\"boolean\",\"type_name\":\"BOOLEAN\",\"position\":3,\"nullable\":true,\"comment\":\"Whether the review was deleted\"},{\"name\":\"property_id\",\"type_text\":\"bigint\",\"type_name\":\"LONG\",\"position\":4,\"nullable\":true,\"comment\":\"The property that was reviewed\"},{\"name\":\"rating\",\"type_text\":\"double\",\"type_name\":\"DOUBLE\",\"position\":5,\"nullable\":true,\"comment\":\"The rating given by the user (1.0-5.0)\"},{\"name\":\"review_id\",\"type_text\":\"bigint\",\"type_name\":\"LONG\",\"position\":6,\"nullable\":false,\"comment\":\"Uniquely identifies this review\"},{\"name\":\"updated_at\",\"type_text\":\"timestamp\",\"type_name\":\"TIMESTAMP\",\"position\":7,\"nullable\":true,\"comment\":\"The date the review was last updated\"},{\"name\":\"user_id\",\"type_text\":\"bigint\",\"type_name\":\"LONG\",\"position\":8,\"nullable\":true,\"comment\":\"The user that wrote the review\"}]},{\"name\":\"users\",\"catalog_name\":\"samples\",\"schema_name\":\"wanderbricks\",\"table_type\":\"MANAGED\",\"comment\":\"Contains data about Wanderbricks individual and business users.\",\"columns\":[{\"name\":\"user_id\",\"type_text\":\"bigint\",\"type_name\":\"LONG\",\"nullable\":false,\"comment\":\"Unique identifier of the user\"},{\"name\":\"email\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":1,\"nullable\":true,\"comment\":\"User's email address.\"},{\"name\":\"name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":2,\"nullable\":true,\"comment\":\"Name of the user.\"},{\"name\":\"country\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":3,\"nullable\":true,\"comment\":\"Country of residence.\"},{\"name\":\"user_type\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":4,\"nullable\":true,\"comment\":\"Type of user (e.g., individual or business).\"},{\"name\":\"created_at\",\"type_text\":\"timestamp\",\"type_name\":\"TIMESTAMP\",\"position\":5,\"nullable\":true,\"comment\":\"Account creation date.\"},{\"name\":\"is_business\",\"type_text\":\"boolean\",\"type_name\":\"BOOLEAN\",\"position\":6,\"nullable\":true,\"comment\":\"Boolean indicating if the user is a business.\"},{\"name\":\"company_name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":7,\"nullable\":true,\"comment\":\"Name of the company (if user is a business).\"}]}]}"}
