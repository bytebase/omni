| {"status":200,"contentType":"application/json","body":"{\"tables\":[{\"name\":\"external_model_spend\",\"catalog_name\":\"system\",\"schema_name\":\"ai_gateway\",\"table_type\":\"MANAGED\",\"comment\":\"The external model spend table records Databricks-computed USD costs for external model requests from your account, aggregated hourly and broken down by account, workspace, endpoint, model, and other dimensions. Note: Cost estimates for external models are for informational purposes only. These figures are calculated based on list or override prices and might not reflect your final provider invoice. Databricks is not liable for discrepancies in third-party billing.\",\"columns\":[{\"name\":\"record_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"nullable\":true,\"comment\":\"Unique ID for this aggregated spend record\"},{\"name\":\"account_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":1,\"nullable\":true,\"comment\":\"The Databricks account ID\"},{\"name\":\"workspace_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":2,\"nullable\":true,\"comment\":\"The ID of the Databricks workspace where the AI Gateway endpoint is configured\"},{\"name\":\"usage_date\",\"type_text\":\"date\",\"type_name\":\"DATE\",\"position\":3,\"nullable\":true,\"comment\":\"Date of the usage record (derived from `usage_start_time`)\"},{\"name\":\"usage_start_time\",\"type_text\":\"timestamp\",\"type_name\":\"TIMESTAMP\",\"position\":4,\"nullable\":true,\"comment\":\"Start of the hourly aggregation window in UTC\"},{\"name\":\"usage_end_time\",\"type_text\":\"timestamp\",\"type_name\":\"TIMESTAMP\",\"position\":5,\"nullable\":true,\"comment\":\"End of the hourly aggregation window in UTC\"},{\"name\":\"ingestion_date\",\"type_text\":\"date\",\"type_name\":\"DATE\",\"position\":6,\"nullable\":true,\"comment\":\"Date when this record was ingested into the spend table\"},{\"name\":\"usage_metadata\",\"type_text\":\"struct\\u003cprovider:string,model:string,endpoint_id:string,endpoint_name:string,destination_id:string,destination_name:string\\u003e\",\"type_name\":\"STRUCT\",\"position\":7,\"nullable\":true,\"comment\":\"System-provided metadata about the external model usage\"},{\"name\":\"custom_tags\",\"type_text\":\"struct\\u003cendpoint_tags:map\\u003cstring,string\\u003e,request_tags:map\\u003cstring,string\\u003e\\u003e\",\"type_name\":\"STRUCT\",\"position\":8,\"nullable\":true,\"comment\":\"User-provided tags for cost attribution and aggregation\"},{\"name\":\"usage_unit\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":9,\"nullable\":true,\"comment\":\"Unit of measurement for usage_quantity (always USD)\"},{\"name\":\"usage_quantity\",\"type_text\":\"decimal(38,18)\",\"type_name\":\"DECIMAL\",\"position\":10,\"nullable\":true,\"comment\":\"Total cost in USD for this aggregated time window and dimension combination\"},{\"name\":\"pricing_metadata\",\"type_text\":\"struct\\u003cservice_tier:string,long_context:boolean\\u003e\",\"type_name\":\"STRUCT\",\"position\":11,\"nullable\":true,\"comment\":\"Metadata explaining which pricing tier or threshold was applied from the pricing catalog\"},{\"name\":\"identity_metadata\",\"type_text\":\"struct\\u003crun_by:string,run_as:string\\u003e\",\"type_name\":\"STRUCT\",\"position\":12,\"nullable\":true,\"comment\":\"Identity information about who initiated the requests in this aggregation\"}]},{\"name\":\"usage\",\"catalog_name\":\"system\",\"schema_name\":\"ai_gateway\",\"table_type\":\"MANAGED\",\"comment\":\"System table used for usage tracking for AI Gateway endpoints. Each row represents a single request to an AI Gateway endpoint with detailed information about routing, token usage, and applied features.\",\"columns\":[{\"name\":\"account_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"nullable\":true,\"comment\":\"The account id\"},{\"name\":\"workspace_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":1,\"nullable\":true,\"comment\":\"The workspace id of the AI Gateway endpoint\"},{\"name\":\"request_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":2,\"nullable\":true,\"comment\":\"The API proxy generated request identifier (or AI Gateway generated UUID if proxy ID doesn't exist)\"},{\"name\":\"schema_version\",\"type_text\":\"int\",\"type_name\":\"INT\",\"position\":3,\"nullable\":true,\"comment\":\"The version of the event schema (to support schema evolution)\"},{\"name\":\"endpoint_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":4,\"nullable\":true,\"comment\":\"The UUID of the AI Gateway entity\"},{\"name\":\"endpoint_name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":5,\"nullable\":true,\"comment\":\"The name of the top level AI Gateway entity\"},{\"name\":\"endpoint_tags\",\"type_text\":\"map\\u003cstring,string\\u003e\",\"type_name\":\"MAP\",\"position\":6,\"nullable\":true,\"comment\":\"The static tags configured on the endpoint, for the purpose of usage table aggregation and visualization\"},{\"name\":\"endpoint_metadata\",\"type_text\":\"struct\\u003ccreator:string,creation_time:timestamp,last_updated_time:timestamp,destinations:array\\u003cstruct\\u003cname:string,traffic_percent:double,type:string\\u003e\\u003e,inference_table:string,fallbacks:array\\u003cstruct\\u003cname:string,traffic_percent:double,type:string\\u003e\\u003e\\u003e\",\"type_name\":\"STRUCT\",\"position\":7,\"nullable\":true,\"comment\":\"The endpoint level metadata\"},{\"name\":\"event_time\",\"type_text\":\"timestamp\",\"type_name\":\"TIMESTAMP\",\"position\":8,\"nullable\":true,\"comment\":\"The timestamp at which request is received\"},{\"name\":\"latency_ms\",\"type_text\":\"bigint\",\"type_name\":\"LONG\",\"position\":9,\"nullable\":true,\"comment\":\"The latency from AI Gateway received the client request to the completion of forwarding the proxy response\"},{\"name\":\"time_to_first_byte_ms\",\"type_text\":\"bigint\",\"type_name\":\"LONG\",\"position\":10,\"nullable\":true,\"comment\":\"The latency from AI Gateway received the client request to receiving the first byte array of the proxy response\"},{\"name\":\"destination_type\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":11,\"nullable\":true,\"comment\":\"The destination type\"},{\"name\":\"destination_name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":12,\"nullable\":true,\"comment\":\"The name of the destination: the endpoint name, or the Unity Catalog model name for pay-per-token models.\"},{\"name\":\"destination_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":13,\"nullable\":true,\"comment\":\"The ID of the destination: the endpoint ID, or the Unity Catalog model ID for pay-per-token models.\"},{\"name\":\"destination_model\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":14,\"nullable\":true,\"comment\":\"The foundation model name (e.g., 'gpt-5-mini', 'meta-llama-3.3-70b-instruct')\"},{\"name\":\"requester\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":15,\"nullable\":true,\"comment\":\"The name or email of the user or service principal whose permissions are used for the invocation request\"},{\"name\":\"requester_type\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":16,\"nullable\":true,\"comment\":\"The type of the requester\"},{\"name\":\"ip_address\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":17,\"nullable\":true,\"comment\":\"The ip address of the client, if it's not from a databricks service. If the client is a databricks service, the ip_address will be null\"},{\"name\":\"url\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":18,\"nullable\":true,\"comment\":\"The request URL received by AI Gateway\"},{\"name\":\"user_agent\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":19,\"nullable\":true,\"comment\":\"The user agent of the client, if it's not from a databricks service\"},{\"name\":\"api_type\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":20,\"nullable\":true,\"comment\":\"The API type of the request\"},{\"name\":\"request_tags\",\"type_text\":\"map\\u003cstring,string\\u003e\",\"type_name\":\"MAP\",\"position\":21,\"nullable\":true,\"comment\":\"The tags provided in the request body, for the purpose of usage table aggregation and visualization\"},{\"name\":\"input_tokens\",\"type_text\":\"bigint\",\"type_name\":\"LONG\",\"position\":22,\"nullable\":true,\"comment\":\"The total count of input tokens. The value will be null if the token count is not available in the response\"},{\"name\":\"output_tokens\",\"type_text\":\"bigint\",\"type_name\":\"LONG\",\"position\":23,\"nullable\":true,\"comment\":\"The total count of output tokens. The value will be null if the token count is not available in the response\"},{\"name\":\"total_tokens\",\"type_text\":\"bigint\",\"type_name\":\"LONG\",\"position\":24,\"nullable\":true,\"comment\":\"The sum of input tokens and output tokens. The value will be null if the token count is not available in the response\"},{\"name\":\"token_details\",\"type_text\":\"struct\\u003ccache_read_input_tokens:bigint,cache_creation_input_tokens:bigint,output_reasoning_tokens:bigint,cache_creation_5m_input_tokens:bigint,cache_creation_1h_input_tokens:bigint,file_search_count:bigint,num_web_search_queries:bigint\\u003e\",\"type_name\":\"STRUCT\",\"position\":25,\"nullable\":true,\"comment\":\"A more detailed breakdown of the token usages. It includes the details of some major foundation models\"},{\"name\":\"response_content_type\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":26,\"nullable\":true,\"comment\":\"The content of the Content-Type response header. Indicates whether the response is streaming mode or not\"},{\"name\":\"status_code\",\"type_text\":\"int\",\"type_name\":\"INT\",\"position\":27,\"nullable\":true,\"comment\":\"The final HTTP status code returned by the endpoint\"},{\"name\":\"routing_information\",\"type_text\":\"struct\\u003cattempts:array\\u003cstruct\\u003cpriority:string,action:string,destination:string,destination_id:string,status_code:int,error_code:string,latency_ms:bigint,start_time:timestamp,end_time:timestamp\\u003e\\u003e\\u003e\",\"type_name\":\"STRUCT\",\"position\":28,\"nullable\":true,\"comment\":\"Detailed routing information, for primary destination and fallbacks\"},{\"name\":\"invocation_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":29,\"nullable\":true,\"comment\":\"A unique identifier generated by AI Gateway for each individual inference call. Distinguishes multiple calls that share the same request_id (e.g., multi-turn agent calls, guardrail checks)\"},{\"name\":\"invocation_metadata\",\"type_text\":\"struct\\u003csource:string,service_tier:string,relayed:boolean\\u003e\",\"type_name\":\"STRUCT\",\"position\":30,\"nullable\":true,\"comment\":\"System-generated metadata about this inference call\"},{\"name\":\"service_type\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":31,\"nullable\":true,\"comment\":\"The type of service that generated this usage log. One of: MODEL_SERVICE, MCP_SERVICE, MODEL_PROVIDER_SERVICE\"},{\"name\":\"service_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":32,\"nullable\":true,\"comment\":\"The ID of the service (MCP service, endpoint, etc.)\"},{\"name\":\"service_name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":33,\"nullable\":true,\"comment\":\"The Unity Catalog fully-qualified name of the service (e.g., 'main.default.github_tools')\"},{\"name\":\"service_tags\",\"type_text\":\"map\\u003cstring,string\\u003e\",\"type_name\":\"MAP\",\"position\":34,\"nullable\":true,\"comment\":\"Tags set for the service, for the purpose of usage table aggregation and visualization\"},{\"name\":\"mcp_metadata\",\"type_text\":\"struct\\u003ctool_name:string,server_type:string,client_name:string,json_rpc_method:string\\u003e\",\"type_name\":\"STRUCT\",\"position\":35,\"nullable\":true,\"comment\":\"MCP service specific metadata. Populated when service_type is MCP_SERVICE, null otherwise\"},{\"name\":\"session_metadata\",\"type_text\":\"struct\\u003cclient_session_id:string,client_subagent_id:string,coding_agent:string,agent_version:string,surface:string,reasoning_effort:string,smart_router_name:string\\u003e\",\"type_name\":\"STRUCT\",\"position\":36,\"nullable\":true,\"comment\":\"Client-provided coding-agent session context\"},{\"name\":\"auth_mode\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":37,\"nullable\":true,\"comment\":\"Client-declared Databricks credential type; not an authorization audit field\"},{\"name\":\"model_metadata\",\"type_text\":\"struct\\u003cconfig:struct\\u003ccreated_by:string,create_time:timestamp,update_time:timestamp,inference_table:string,routing:struct\\u003cdestinations:array\\u003cstruct\\u003cname:string,traffic_percent:double,type:string\\u003e\\u003e,fallbacks:array\\u003cstruct\\u003cname:string,traffic_percent:double,type:string\\u003e\\u003e\\u003e,rate_limits:array\\u003cstruct\\u003cprincipal_type:string,principal:string,principal_id:string,limit:int,unit:string,interval:string\\u003e\\u003e,service_policies:array\\u003cstruct\\u003clabel:string,phases:array\\u003cstring\\u003e,type:string,handler:string,rank:int\\u003e\\u003e\\u003e,destination_type:string,destination_name:string,destination_model:string,destination_metadata:struct\\u003cprovider_model:string,provider:string,model_serving_endpoint:string,model_serving_endpoint_id:string,workspace_id:string,model_units:int,model_version:int,model_provider_service:string\\u003e,api_type:string,routing_information:struct\\u003cattempts:array\\u003cstruct\\u003cpriority:string,action:string,destination_name:string,status_code:int,error_code:string,latency_ms:bigint,start_time:timestamp,end_time:timestamp,outcome:string\\u003e\\u003e\\u003e,gateway_feature_results:struct\\u003crate_limit_result:struct\\u003cprincipal_type:string,principal:string,principal_id:string,limit:int,unit:string,interval:string,request_tag_key:string,request_tag_value:string\\u003e,service_policies:array\\u003cstruct\\u003cname:string,phase:string,decision:string,reason:string,error_reason:string\\u003e\\u003e\\u003e\\u003e\",\"type_name\":\"STRUCT\",\"position\":38,\"nullable\":true,\"comment\":\"Model service specific metadata. Populated when service_type is MODEL_SERVICE, null otherwise\"},{\"name\":\"model_provider_metadata\",\"type_text\":\"struct\\u003cprovider_model:string,provider:string,api_type:string,gateway_feature_results:struct\\u003crate_limit_result:struct\\u003cprincipal_type:string,principal:string,principal_id:string,limit:int,unit:string,interval:string,request_tag_key:string,request_tag_value:string\\u003e,service_policies:array\\u003cstruct\\u003cname:string,phase:string,decision:string,reason:string,error_reason:string\\u003e\\u003e\\u003e,config:struct\\u003ccreated_by:string,create_time:timestamp,update_time:timestamp,rate_limits:array\\u003cstruct\\u003cprincipal_type:string,principal:string,principal_id:string,limit:int,unit:string,interval:string\\u003e\\u003e,service_policies:array\\u003cstruct\\u003clabel:string,phases:array\\u003cstring\\u003e,type:string,handler:string,rank:int\\u003e\\u003e,inference_table:string\\u003e\\u003e\",\"type_name\":\"STRUCT\",\"position\":39,\"nullable\":true,\"comment\":\"Model provider service specific metadata. Populated when service_type is MODEL_PROVIDER_SERVICE, null otherwise\"}]}]}"}
