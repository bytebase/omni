| {"status":200,"contentType":"application/json","body":"{\"tables\":[{\"name\":\"abac_policy_definitions\",\"catalog_name\":\"samples\",\"schema_name\":\"information_schema\",\"table_type\":\"VIEW\",\"view_definition\":\"SELECT * FROM system.information_schema.abac_policy_definitions WHERE catalog_name = 'samples'\",\"comment\":\"Lists ABAC policies with their full authoring metadata.\",\"columns\":[{\"name\":\"policy_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"nullable\":false,\"comment\":\"Unique identifier of the policy.\"},{\"name\":\"policy_name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":1,\"nullable\":false,\"comment\":\"Name of the policy.\"},{\"name\":\"policy_type\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":2,\"nullable\":false,\"comment\":\"The policy type. For example, ROW_FILTER, COLUMN_MASK, GRANT, or DENY.\"},{\"name\":\"catalog_name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":3,\"nullable\":true,\"comment\":\"Name of the catalog the policy is attached to (or that contains the schema/table the policy is attached to).\"},{\"name\":\"schema_name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":4,\"nullable\":true,\"comment\":\"Name of the schema the policy is attached to (or that contains the table the policy is attached to). NULL for CATALOG-attached policies.\"},{\"name\":\"securable_name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":5,\"nullable\":true,\"comment\":\"Name of the securable the policy is attached to. NULL for CATALOG-attached and SCHEMA-attached policies.\"},{\"name\":\"on_securable_type\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":6,\"nullable\":false,\"comment\":\"Type of the securable the policy is attached to. For example, CATALOG, SCHEMA, or TABLE.\"},{\"name\":\"to_principals\",\"type_text\":\"array\\u003cstring\\u003e\",\"type_name\":\"ARRAY\",\"position\":7,\"nullable\":false,\"comment\":\"List of principals (users, groups, service principals) the policy applies to.\"},{\"name\":\"except_principals\",\"type_text\":\"array\\u003cstring\\u003e\",\"type_name\":\"ARRAY\",\"position\":8,\"nullable\":false,\"comment\":\"List of principals excluded from the policy.\"},{\"name\":\"for_securable_type\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":9,\"nullable\":false,\"comment\":\"Type of securable the policy targets when evaluated.\"},{\"name\":\"privileges\",\"type_text\":\"array\\u003cstring\\u003e\",\"type_name\":\"ARRAY\",\"position\":10,\"nullable\":true,\"comment\":\"Privileges granted or denied by the policy. NULL for ROW_FILTER and COLUMN_MASK policies.\"},{\"name\":\"when_condition\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":11,\"nullable\":true,\"comment\":\"Conditional expression under which the policy applies. NULL when no WHEN clause is set.\"},{\"name\":\"match_columns\",\"type_text\":\"array\\u003cstring\\u003e\",\"type_name\":\"ARRAY\",\"position\":12,\"nullable\":true,\"comment\":\"Columns referenced by the policy. NULL for GRANT and DENY policies.\"},{\"name\":\"governed_tags\",\"type_text\":\"array\\u003cstruct\\u003ctag_key:string,tag_value:string\\u003e\\u003e\",\"type_name\":\"ARRAY\",\"position\":13,\"nullable\":false,\"comment\":\"Governed tag keys and optional values referenced by the policy.\"},{\"name\":\"created_by\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":14,\"nullable\":false,\"comment\":\"Principal who created the policy.\"}]},{\"name\":\"catalog_privileges\",\"catalog_name\":\"samples\",\"schema_name\":\"information_schema\",\"table_type\":\"VIEW\",\"view_definition\":\"SELECT * FROM system.information_schema.catalog_privileges WHERE catalog_name = 'samples'\",\"comment\":\"Lists principals that have privileges on the catalogs.\",\"columns\":[{\"name\":\"grantor\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"nullable\":false,\"comment\":\"Principal that granted the privilege.\"},{\"name\":\"grantee\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":1,\"nullable\":false,\"comment\":\"Principal to which the privilege is granted.\"},{\"name\":\"catalog_name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":2,\"nullable\":false,\"comment\":\"Catalog on which the privilege is granted.\"},{\"name\":\"privilege_type\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":3,\"nullable\":false,\"comment\":\"Privilege being granted.\"},{\"name\":\"is_grantable\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":4,\"nullable\":false,\"comment\":\"Always NO. Reserved for future use.\"},{\"name\":\"inherited_from\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":5,\"nullable\":false,\"comment\":\"The ancestor relation that the privilege is inherited from.\"}]},{\"name\":\"catalog_tags\",\"catalog_name\":\"samples\",\"schema_name\":\"information_schema\",\"table_type\":\"VIEW\",\"view_definition\":\"SELECT * FROM system.information_schema.catalog_tags WHERE catalog_name = 'samples'\",\"columns\":[{\"name\":\"catalog_name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"nullable\":false},{\"name\":\"tag_name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":1,\"nullable\":false},{\"name\":\"tag_value\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":2,\"nullable\":false}]},{\"name\":\"catalogs\",\"catalog_name\":\"samples\",\"schema_name\":\"information_schema\",\"table_type\":\"VIEW\",\"view_definition\":\"SELECT * FROM system.information_schema.catalogs WHERE catalog_name = 'samples'\",\"comment\":\"Describes catalogs.\",\"columns\":[{\"name\":\"catalog_name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"nullable\":false,\"comment\":\"Name of the catalog.\"},{\"name\":\"catalog_owner\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":1,\"nullable\":false,\"comment\":\"Owner of the catalog.\"},{\"name\":\"comment\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":2,\"nullable\":true,\"comment\":\"An optional comment that describes the catalog.\"},{\"name\":\"created\",\"type_text\":\"timestamp\",\"type_name\":\"TIMESTAMP\",\"position\":3,\"nullable\":false,\"comment\":\"Timestamp when the catalog was created.\"},{\"name\":\"created_by\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":4,\"nullable\":false,\"comment\":\"Principal who created the catalog.\"},{\"name\":\"last_altered\",\"type_text\":\"timestamp\",\"type_name\":\"TIMESTAMP\",\"position\":5,\"nullable\":false,\"comment\":\"Timestamp when the catalog was last altered in any way.\"},{\"name\":\"last_altered_by\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":6,\"nullable\":false,\"comment\":\"Principal who last altered the catalog.\"},{\"name\":\"url\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":7,\"nullable\":true,\"comment\":\"The external location where the catalog was stored\"},{\"name\":\"custom_max_retention_hours\",\"type_text\":\"long\",\"type_name\":\"LONG\",\"position\":8,\"nullable\":true,\"comment\":\"The user specified period in hours in which a dropped catalog and its children are restorable\"}]},{\"name\":\"check_constraints\",\"catalog_name\":\"samples\",\"schema_name\":\"information_schema\",\"table_type\":\"VIEW\",\"view_definition\":\"SELECT * FROM system.information_schema.check_constraints WHERE constraint_catalog = 'samples'\",\"comment\":\"Reserved for future use.\",\"columns\":[{\"name\":\"constraint_catalog\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"nullable\":false,\"comment\":\"Catalog containing the check constraint.\"},{\"name\":\"constraint_schema\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":1,\"nullable\":false,\"comment\":\"Schema containing the check constraint.\"},{\"name\":\"constraint_name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":2,\"nullable\":false,\"comment\":\"Name of the check constraint.\"},{\"name\":\"check_clause\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":3,\"nullable\":false,\"comment\":\"The text of the check constraint condition.\"},{\"name\":\"sql_path\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":4,\"nullable\":true,\"comment\":\"Always NULL, reserved for future use.\"},{\"name\":\"comment\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":5,\"nullable\":true}]},{\"name\":\"column_masks\",\"catalog_name\":\"samples\",\"schema_name\":\"information_schema\",\"table_type\":\"VIEW\",\"view_definition\":\"SELECT * FROM system.information_schema.column_masks WHERE table_catalog = 'samples'\",\"columns\":[{\"name\":\"table_catalog\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"nullable\":false},{\"name\":\"table_schema\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":1,\"nullable\":false},{\"name\":\"table_name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":2,\"nullable\":false},{\"name\":\"column_name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":3,\"nullable\":false},{\"name\":\"mask_name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":4,\"nullable\":true},{\"name\":\"using_columns\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":5,\"nullable\":true}]},{\"name\":\"column_tags\",\"catalog_name\":\"samples\",\"schema_name\":\"information_schema\",\"table_type\":\"VIEW\",\"view_definition\":\"SELECT * FROM system.information_schema.column_tags WHERE catalog_name = 'samples'\",\"columns\":[{\"name\":\"catalog_name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"nullable\":false},{\"name\":\"schema_name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":1,\"nullable\":false},{\"name\":\"table_name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":2,\"nullable\":false},{\"name\":\"column_name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":3,\"nullable\":false},{\"name\":\"tag_name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":4,\"nullable\":false},{\"name\":\"tag_value\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":5,\"nullable\":false}]},{\"name\":\"columns\",\"catalog_name\":\"samples\",\"schema_name\":\"information_schema\",\"table_type\":\"VIEW\",\"view_definition\":\"SELECT * FROM system.information_schema.columns WHERE table_catalog = 'samples'\",\"comment\":\"Describes columns of tables and views in the catalog.\",\"columns\":[{\"name\":\"table_catalog\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"nullable\":false,\"comment\":\"Catalog that contains the relation.\"},{\"name\":\"table_schema\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":1,\"nullable\":false,\"comment\":\"Schema that contains the relation.\"},{\"name\":\"table_name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":2,\"nullable\":false,\"comment\":\"Name of the relation the column is part of.\"},{\"name\":\"column_name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":3,\"nullable\":false,\"comment\":\"Name of the column.\"},{\"name\":\"ordinal_position\",\"type_text\":\"int\",\"type_name\":\"INT\",\"position\":4,\"nullable\":false,\"comment\":\"The position (0-based) of the column within the relation.\"},{\"name\":\"column_default\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":5,\"nullable\":true,\"comment\":\"The default value used when the column is not specified in an INSERT, NULL if undefined.\"},{\"name\":\"is_nullable\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":6,\"nullable\":false,\"comment\":\"YES if column is nullable, NO otherwise.\"},{\"name\":\"full_data_type\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":7,\"nullable\":false,\"comment\":\"The data type as specified in the column definition.\"},{\"name\":\"data_type\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":8,\"nullable\":false,\"comment\":\"The simple data type name of the column, or STRUCT, or ARRAY.\"},{\"name\":\"character_maximum_length\",\"type_text\":\"long\",\"type_name\":\"LONG\",\"position\":9,\"nullable\":true,\"comment\":\"Always NULL, reserved for future use.\"},{\"name\":\"character_octet_length\",\"type_text\":\"long\",\"type_name\":\"LONG\",\"position\":10,\"nullable\":true,\"comment\":\"Always NULL, reserved for future use.\"},{\"name\":\"numeric_precision\",\"type_text\":\"int\",\"type_name\":\"INT\",\"position\":11,\"nullable\":true,\"comment\":\"For base-2 integral numeric types, FLOAT, and DOUBLE, the number of supported bits. For DECIMAL the number of digits, NULL otherwise.\"},{\"name\":\"numeric_precision_radix\",\"type_text\":\"int\",\"type_name\":\"INT\",\"position\":12,\"nullable\":true,\"comment\":\"For DECIMAL 10, for all other numeric types 2, NULL otherwise.\"},{\"name\":\"numeric_scale\",\"type_text\":\"int\",\"type_name\":\"INT\",\"position\":13,\"nullable\":true,\"comment\":\"For integral numeric types 0, for DECIMAL the number of digits to the right of the decimal point, NULL otherwise.\"},{\"name\":\"datetime_precision\",\"type_text\":\"int\",\"type_name\":\"INT\",\"position\":14,\"nullable\":true,\"comment\":\"For DATE 0, for TIMESTAMP, and INTERVAL … SECOND 6, any other INTERVAL 0, NULL otherwise.\"},{\"name\":\"interval_type\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":15,\"nullable\":true,\"comment\":\"For INTERVAL the unit portion of the interval, for example 'YEAR TO MONTH', NULL otherwise.\"},{\"name\":\"interval_precision\",\"type_text\":\"int\",\"type_name\":\"INT\",\"position\":16,\"nullable\":true,\"comment\":\"Always NULL, reserved for future use.\"},{\"name\":\"maximum_cardinality\",\"type_text\":\"long\",\"type_name\":\"LONG\",\"position\":17,\"nullable\":true,\"comment\":\"Always NULL, reserved for future use.\"},{\"name\":\"is_identity\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":18,\"nullable\":false,\"comment\":\"Always 'NO', reserved for future use.\"},{\"name\":\"identity_generation\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":19,\"nullable\":true,\"comment\":\"Always NULL, reserved for future use.\"},{\"name\":\"identity_start\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":20,\"nullable\":true,\"comment\":\"Always NULL, reserved for future use.\"},{\"name\":\"identity_increment\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":21,\"nullable\":true,\"comment\":\"Always NULL, reserved for future use.\"},{\"name\":\"identity_maximum\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":22,\"nullable\":true,\"comment\":\"Always NULL, reserved for future use.\"},{\"name\":\"identity_minimum\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":23,\"nullable\":true,\"comment\":\"Always NULL, reserved for future use.\"},{\"name\":\"identity_cycle\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":24,\"nullable\":true,\"comment\":\"Always NULL, reserved for future use.\"},{\"name\":\"is_generated\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":25,\"nullable\":false,\"comment\":\"Always NULL, reserved for future use.\"},{\"name\":\"generation_expression\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":26,\"nullable\":true,\"comment\":\"Always NULL, reserved for future use.\"},{\"name\":\"is_system_time_period_start\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":27,\"nullable\":false,\"comment\":\"Always NO, reserved for future use.\"},{\"name\":\"is_system_time_period_end\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":28,\"nullable\":false,\"comment\":\"Always NO, reserved for future use.\"},{\"name\":\"system_time_period_timestamp_generation\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":29,\"nullable\":true,\"comment\":\"Always NULL, reserved for future use.\"},{\"name\":\"is_updatable\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":30,\"nullable\":false,\"comment\":\"YES if column is updatable, NO otherwise.\"},{\"name\":\"partition_index\",\"type_text\":\"int\",\"type_name\":\"INT\",\"position\":31,\"nullable\":true,\"comment\":\"Position (0-based) of the column in the partition, NULL if not a partitioning column.\"},{\"name\":\"comment\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":32,\"nullable\":true,\"comment\":\"Optional description of the column.\"},{\"name\":\"collation_catalog\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":33,\"nullable\":true,\"comment\":\"For string columns, always SYSTEM. Reserved for future use, NULL if not a string column.\"},{\"name\":\"collation_schema\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":34,\"nullable\":true,\"comment\":\"For string columns, always BUILTIN. Reserved for future use, NULL if not a string column.\"},{\"name\":\"collation_name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":35,\"nullable\":true,\"comment\":\"For string columns, the name of the collation, NULL if not a string column.\"}]},{\"name\":\"constraint_column_usage\",\"catalog_name\":\"samples\",\"schema_name\":\"information_schema\",\"table_type\":\"VIEW\",\"view_definition\":\"SELECT * FROM system.information_schema.constraint_column_usage WHERE constraint_catalog = 'samples'\",\"comment\":\"Describes the constraints referencing columns in the catalog.\",\"columns\":[{\"name\":\"table_catalog\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"nullable\":false,\"comment\":\"Catalog containing the relation.\"},{\"name\":\"table_schema\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":1,\"nullable\":false,\"comment\":\"Schema containing the relation.\"},{\"name\":\"table_name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":2,\"nullable\":false,\"comment\":\"Name of the relation.\