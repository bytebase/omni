e\":\"LONG\",\"position\":9,\"nullable\":true,\"comment\":\"Always NULL, reserved for future use.\"},{\"name\":\"character_octet_length\",\"type_text\":\"long\",\"type_name\":\"LONG\",\"position\":10,\"nullable\":true,\"comment\":\"Always NULL, reserved for future use.\"},{\"name\":\"numeric_precision\",\"type_text\":\"int\",\"type_name\":\"INT\",\"position\":11,\"nullable\":true,\"comment\":\"For base-2 integral numeric types, FLOAT, and DOUBLE, the number of supported bits. For DECIMAL the number of digits, NULL otherwise.\"},{\"name\":\"numeric_precision_radix\",\"type_text\":\"int\",\"type_name\":\"INT\",\"position\":12,\"nullable\":true,\"comment\":\"For DECIMAL 10, for all other numeric types 2, NULL otherwise.\"},{\"name\":\"numeric_scale\",\"type_text\":\"int\",\"type_name\":\"INT\",\"position\":13,\"nullable\":true,\"comment\":\"For integral numeric types 0, for DECIMAL the number of digits to the right of the decimal point, NULL otherwise.\"},{\"name\":\"datetime_precision\",\"type_text\":\"int\",\"type_name\":\"INT\",\"position\":14,\"nullable\":true,\"comment\":\"For DATE 0, for TIMESTAMP, and INTERVAL … SECOND 6, any other INTERVAL 0, NULL otherwise.\"},{\"name\":\"interval_type\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":15,\"nullable\":true,\"comment\":\"For INTERVAL the unit portion of the interval, for example 'YEAR TO MONTH', NULL otherwise.\"},{\"name\":\"interval_precision\",\"type_text\":\"int\",\"type_name\":\"INT\",\"position\":16,\"nullable\":true,\"comment\":\"Always NULL, reserved for future use.\"},{\"name\":\"maximum_cardinality\",\"type_text\":\"long\",\"type_name\":\"LONG\",\"position\":17,\"nullable\":true,\"comment\":\"Always NULL, reserved for future use.\"},{\"name\":\"is_identity\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":18,\"nullable\":false,\"comment\":\"Always 'NO', reserved for future use.\"},{\"name\":\"identity_generation\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"positio