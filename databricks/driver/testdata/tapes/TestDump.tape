 string column.\"},{\"name\":\"collation_schema\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":18,\"nullable\":true,\"comment\":\"For string columns, always BUILTIN. Reserved for future use, NULL if not a string column.\"},{\"name\":\"collation_name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":19,\"nullable\":true,\"comment\":\"For string columns, the name of the collation, NULL if not a string column.\"}]},{\"name\":\"routine_privileges\",\"catalog_name\":\"system\",\"schema_name\":\"information_schema\",\"table_type\":\"EXTERNAL\",\"comment\":\"Lists principals that have privileges on the routines in the catalog.\",\"columns\":[{\"name\":\"grantor\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"nullable\":false,\"comment\":\"Principal who granted the privilege.\"},{\"name\":\"grantee\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":1,\"nullable\":false,\"comment\":\"Principal to which the privilege is granted.\"},{\"name\":\"specific_catalog\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":2,\"nullable\":false,\"comment\":\"Catalog of routine on which the privilege is granted.\"},{\"name\":\"specific_schema\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":3,\"nullable\":false,\"comment\":\"Database of routine on which the privilege is granted.\"},{\"name\":\"specific_name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":4,\"nullable\":false,\"comment\":\"Schema unique (specific) name of routine on which the privilege is granted.\"},{\"name\":\"routine_catalog\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":5,\"nullable\":false,\"comment\":\"Matches SPECIFIC_CATALOG.\"},{\"name\":\"routine_schema\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":6,\"nullable\":false,\"comment\":\"Matches SPECIFIC_SCHEMA.\"},{\"name\":\"routine_name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":7,\"nullable\":false,\"comment\":\"Name of routine on which the privilege is granted.\"},{\"name\":\"privilege_type\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":8,\"nullable\":false,\"comment\":\"Privilege being granted.\"},{\"name\":\"is_grantable\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":9,\"nullable\":false,\"comment\":\"Always NO. Reserved for future use.\"},{\"name\":\"inherited_from\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":10,\"nullable\":false,\"comment\":\"The ancestor relation that the privilege is inherited from.\"}]},{\"name\":\"routines\",\"catalog_name\":\"system\",\"schema_name\":\"information_schema\",\"table_type\":\"EXTERNAL\",\"comment\":\"Describes routines (functions) in the catalog.\",\"columns\":[{\"name\":\"specific_catalog\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"nullable\":false,\"comment\":\"Catalog containing the routine.\"},{\"name\":\"specific_schema\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":1,\"nullable\":false,\"comment\":\"Database (schema) containing the routine.\"},{\"name\":\"specific_name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":2,\"nullable\":false,\"comment\":\"Schema unique (specific) name of the routine.\"},{\"name\":\"routine_catalog\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":3,\"nullable\":false,\"comment\":\"Matches SPECIFIC_CATALOG.\"},{\"name\":\"routine_schema\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":4,\"nullable\":false,\"comment\":\"Matches SPECIFIC_SCHEMA.\"},{\"name\":\"routine_name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":5,\"nullable\":false,\"comment\":\"Name of the routine.\"},{\"name\":\"routine_owner\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":6,\"nullable\":false},{\"name\":\"routine_type\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":7,\"nullable\":false,\"comment\":\"The routine type, 'FUNCTION' or 'PROCEDURE'.\"},{\"name\":\"data_type\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":8,\"nullable\":false,\"comment\":\"The result data type name, or 'TABLE' for a table valued function, 'NULL' for procedures.\"},{\"name\":\"full_data_type\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":9,\"nullable\":false,\"comment\":\"The result data type definition, for example 'DECIMAL(10, 4)', 'NULL' for procedures.\"},{\"name\":\"character_maximum_length\",\"type_text\":\"long\",\"type_name\":\"LONG\",\"position\":10,\"nullable\":true,\"comment\":\"Always NULL, reserved for future use.\"},{\"name\":\"character_octet_length\",\"type_text\":\"long\",\"type_name\":\"LONG\",\"position\":11,\"nullable\":true,\"comment\":\"Always NULL, reserved for future use.\"},{\"name\":\"numeric_precision\",\"type_text\":\"int\",\"type_name\":\"INT\",\"position\":12,\"nullable\":true,\"comment\":\"For base-2 integral numeric types, FLOAT, and DOUBLE, the number of supported bits. For DECIMAL the number of digits, NULL otherwise.\"},{\"name\":\"numeric_precision_radix\",\"type_text\":\"int\",\"type_name\":\"INT\",\"position\":13,\"nullable\":true,\"comment\":\"For DECIMAL 10, for all other numeric types 2, NULL otherwise.\"},{\"name\":\"numeric_scale\",\"type_text\":\"int\",\"type_name\":\"INT\",\"position\":14,\"nullable\":true,\"comment\":\"For integral numeric types 0, for DECIMAL the number of digits to the right of the decimal point, NULL otherwise.\"},{\"name\":\"datetime_precision\",\"type_text\":\"int\",\"type_name\":\"INT\",\"position\":15,\"nullable\":true,\"comment\":\"For DATE 0, for TIMESTAMP, and INTERVAL … SECOND 6, any other INTERVAL 0, NULL otherwise.\"},{\"name\":\"interval_type\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":16,\"nullable\":true,\"comment\":\"For INTERVAL the unit portion of the interval, e.g. 'YEAR TO MONTH', NULL otherwise.\"},{\"name\":\"interval_precision\",\"type_text\":\"int\",\"type_name\":\"INT\",\"position\":