| {"status":200,"contentType":"application/json","body":"{\"tables\":[{\"name\":\"assistant_events\",\"catalog_name\":\"system\",\"schema_name\":\"access\",\"table_type\":\"MANAGED\",\"comment\":\"Records all chat or inline Assistant interactions in order to see engagement and adoption.\",\"columns\":[{\"name\":\"account_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"nullable\":true,\"comment\":\"ID of the account.\"},{\"name\":\"workspace_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":1,\"nullable\":true,\"comment\":\"ID of the workspace.\"},{\"name\":\"event_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":2,\"nullable\":true,\"comment\":\"A unique ID for this event.\"},{\"name\":\"event_time\",\"type_text\":\"timestamp\",\"type_name\":\"TIMESTAMP\",\"position\":3,\"nullable\":true,\"comment\":\"Time that the event happened. Timezone information is recorded at the end of the value with +00:00 representing UTC.\"},{\"name\":\"event_date\",\"type_text\":\"date\",\"type_name\":\"DATE\",\"position\":4,\"nullable\":true,\"comment\":\"Date that the event happened.\"},{\"name\":\"user_agent\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":5,\"nullable\":true,\"comment\":\"Origination of request.\"},{\"name\":\"initiated_by\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":6,\"nullable\":true,\"comment\":\"Email of the user initiating the request.\"}]},{\"name\":\"audit\",\"catalog_name\":\"system\",\"schema_name\":\"access\",\"table_type\":\"MANAGED\",\"comment\":\"The audit logs table records detailed information about actions and events occurring within a Databricks workspace or account. It is used for security auditing, compliance, and monitoring user and system activity. Each row represents a single event, such as a user login, data access, permission change, or system operation. See documentation of services and actions at https://docs.databricks.com/aws/admin/account-settings/audit-logs\",\"columns\":[{\"name\":\"account_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"nullable\":true,\"comment\":\"The Databricks account identifier associated with the audit event.\"},{\"name\":\"workspace_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":1,\"nullable\":true,\"comment\":\"The Databricks workspace in which the audit event took place. For account-level events, the workspace_id will be 0.\"},{\"name\":\"version\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":2,\"nullable\":true,\"comment\":\"Audit log schema version\"},{\"name\":\"event_time\",\"type_text\":\"timestamp\",\"type_name\":\"TIMESTAMP\",\"position\":3,\"nullable\":true,\"comment\":\"Timestamp of the event\"},{\"name\":\"event_date\",\"type_text\":\"date\",\"type_name\":\"DATE\",\"position\":4,\"nullable\":true,\"comment\":\"The calendar date when the event or action occurred. Useful for filtering and aggregating events by day.\"},{\"name\":\"source_ip_address\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":5,\"nullable\":true,\"comment\":\"The IP address from which the request originated.\"},{\"name\":\"user_agent\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":6,\"nullable\":true,\"comment\":\"The user agent string or identifier describing the client, browser, or tool that initiated the request (e.g., web browser, API client, CLI)\"},{\"name\":\"session_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":7,\"nullable\":true,\"comment\":\"Unique identifier for the session in which the request was made. Sessions group related actions by a user or service over a period of time\"},{\"name\":\"user_identity\",\"type_text\":\"struct\\u003cemail:string,subject_name:string\\u003e\",\"type_name\":\"STRUCT\",\"position\":8,\"nullable\":true,\"comment\":\"A map of key/value pairs that can be used to identify the person or service principal that initiated the request. Contains keys such as email and subject_name. An email of System-User is used for background system tasks.\"},{\"name\":\"service_name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":9,\"nullable\":true,\"comment\":\"The name of the Databricks service that generated the audit event. See [service documentation](https://docs.databricks.com/aws/admin/account-settings/audit-logs#audit-log-services) for details.\"},{\"name\":\"action_name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":10,\"nullable\":true,\"comment\":\"The name of the action that has been performed as part of the audit event. Action names vary depending on the Databricks service (service_name). See [documentation of actions per service](https://docs.databricks.com/aws/admin/account-settings/audit-logs) for details.\"},{\"name\":\"request_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":11,\"nullable\":true,\"comment\":\"A unique identifier of the request.\"},{\"name\":\"request_params\",\"type_text\":\"map\\u003cstring,string\\u003e\",\"type_name\":\"MAP\",\"position\":12,\"nullable\":true,\"comment\":\"A map of key/value pairs with the request parameters. Request parameters vary by request type. See [documentation of request parameters per action](https://docs.databricks.com/aws/admin/account-settings/audit-logs) for details.\"},{\"name\":\"response\",\"type_text\":\"struct\\u003cstatus_code:int,error_message:string,result:string\\u003e\",\"type_name\":\"STRUCT\",\"position\":13,\"nullable\":true,\"comment\":\"Struct of response, includes status_code, error_messages, and where applicable a result string. status_code is an HTTP status code.\"},{\"name\":\"audit_level\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":14,\"nullable\":true,\"comment\":\"Indicates whether the audit event is at the workspace or account level. Either `ACCOUNT_LEVEL` or `WORKSPACE_LEVEL`.\"},{\"name\":\"event_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":15,\"nullable\":true,\"comment\":\"A unique identifier of the audit event.\"},{\"name\":\"identity_metadata\",\"type_text\":\"struct\\u003crun_by:string,run_as:string,acting_resource:string,run_by_display_name:string,run_as_display_name:string,acting_resource_display_name:string,acting_resource_type:string\\u003e\",\"type_name\":\"STRUCT\",\"position\":16,\"nullable\":true,\"comment\":\"A struct with the identities from the audit event. This includes `run_by` (the identity who initiated the event) and `run_as` (the identity being used for authorisation purposes). See [Auditing group dedicated compute activity documentation](https://docs.databricks.com/aws/compute/group-access#auditing-group-dedicated-compute-activity) for more details.\"}]},{\"name\":\"clean_room_events\",\"catalog_name\":\"system\",\"schema_name\":\"access\",\"table_type\":\"MANAGED\",\"comment\":\"The clean_room_events table records actions taken by you or your collaborators on clean rooms (Public Preview) in your account. This table includes regional data from across your account.\",\"columns\":[{\"name\":\"account_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"nullable\":true,\"comment\":\"The ID of the Databricks account.\"},{\"name\":\"metastore_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":1,\"nullable\":true,\"comment\":\"The ID of the Unity Catalog metastore.\"},{\"name\":\"event_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":2,\"nullable\":true,\"comment\":\"The ID of the clean room event\"},{\"name\":\"clean_room_name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":3,\"nullable\":true,\"comment\":\"Name of the clean room associated with the event\"},{\"name\":\"central_clean_room_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":4,\"nullable\":true,\"comment\":\"The ID of central clean room\"},{\"name\":\"initiator_global_metastore_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":5,\"nullable\":true,\"comment\":\"Global metastore ID of the collaborator who initiated the event\"},{\"name\":\"event_type\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":6,\"nullable\":true,\"comment\":\"The type of the event. See [Logged clean room events](https://docs.databricks.com/en/admin/system-tables/clean-rooms.html#events).\"},{\"name\":\"clean_room_created_metadata\",\"type_text\":\"struct\\u003ccollaborators:array\\u003cstruct\\u003ccollaborator_global_metastore_id:string,collaborator_alias:string\\u003e\\u003e,egress_network_policy:struct\\u003cinternet_access:struct\\u003crestriction_mode:string,allowed_internet_destinations:array\\u003cstruct\\u003cdestination:string,type:string,protocol:string\\u003e\\u003e\\u003e\\u003e,compliance_profile:struct\\u003cis_enabled:boolean,compliance_standards:array\\u003cstring\\u003e\\u003e\\u003e\",\"type_name\":\"STRUCT\",\"position\":7,\"nullable\":true,\"comment\":\"The metadata of the event type CLEAN_ROOM_CREATED\"},{\"name\":\"clean_room_deleted_metadata\",\"type_text\":\"struct\\u003ccentral_clean_room_id:string\\u003e\",\"type_name\":\"STRUCT\",\"position\":8,\"nullable\":true,\"comment\":\"The metadata of the event type CLEAN_ROOM_DELETED\"},{\"name\":\"run_notebook_started_metadata\",\"type_text\":\"struct\\u003cnotebook_name:string,notebook_checksum:string,run_id:string,notebook_etag:string,notebook_update_time:timestamp\\u003e\",\"type_name\":\"STRUCT\",\"position\":9,\"nullable\":true,\"comment\":\"The metadata of the event type RUN_NOTEBOOK_STARTED\"},{\"name\":\"run_notebook_completed_metadata\",\"type_text\":\"struct\\u003cnotebook_name:string,run_id:string,state:string,duration_in_seconds:int,output_schema:struct\\u003cname:string,owner_global_metastore_id:string,action:string,expire_time:timestamp,assets_added:array\\u003cstruct\\u003cname:string,data_object_type:string\\u003e\\u003e\\u003e,shared_output_schema:struct\\u003cname:string,owner_global_metastore_id:string,action:string,expire_time:timestamp,assets_added:array\\u003cstruct\\u003cname:string,data_object_type:string\\u003e\\u003e\\u003e\\u003e\",\"type_name\":\"STRUCT\",\"position\":10,\"nullable\":true,\"comment\":\"The metadata of the event type RUN_NOTEBOOK_COMPLETED\"},{\"name\":\"clean_room_assets_updated_metadata\",\"type_text\":\"struct\\u003cadded_assets:array\\u003cstruct\\u003cdata_object_type:string,catalog:string,name:string,notebook_metadata:struct\\u003cetag:string,checksum:string,runner_collaborator_aliases:array\\u003cstring\\u003e\\u003e,jar_metadata:struct\\u003cetag:string,runner_collaborator_aliases:array\\u003cstring\\u003e\\u003e\\u003e\\u003e,updated_assets:array\\u003cstruct\\u003cdata_object_type:string,catalog:string,name:string,notebook_metadata:struct\\u003cetag:string,checksum:string,runner_collaborator_aliases:array\\u003cstring\\u003e\\u003e,jar_metadata:struct\\u003cetag:string,runner_collaborator_aliases:array\\u003cstring\\u003e\\u003e\\u003e\\u003e,removed_assets:array\\u003cstruct\\u003cdata_object_type:string,catalog:string,name:string,notebook_metadata:struct\\u003cetag:string,checksum:string,runner_collaborator_aliases:array\\u003cstring\\u003e\\u003e,jar_metadata:struct\\u003cetag:string,runner_collaborator_aliases:array\\u003cstring\\u003e\\u003e\\u003e\\u003e\\u003e\",\"type_name\":\"STRUCT\",\"position\":11,\"nullable\":true,\"comment\":\"The metadata of the event type CLEAN_ROOM_ASSETS_UPDATED\"},{\"name\":\"event_time\",\"type_text\":\"timestamp\",\"type_name\":\"TIMESTAMP\",\"position\":12,\"nullable\":true,\"comment\":\"Timestamp when the event took place\"},{\"name\":\"output_schema_deleted_metadata\",\"type_text\":\"struct\\u003cname:string,owner_global_metastore_id:string,action:string,expire_time:timestamp\\u003e\",\"type_name\":\"STRUCT\",\"position\":13,\"nullable\":true,\"comment\":\"The metadata of the event type OUTPUT_SCHEMA_DELETED\"},{\"name\":\"initiator_collaborator_alias\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":14,\"nullable\":true,\"comment\":\"The alias of the collaborator who initiated the event\"},{\"name\":\"asset_review_created_metadata\",\"type_text\":\"struct\\u003casset_name:string,data_object_type:string,review_state:string,review_sub_reason:string,auto_approval_rule_id:string,notebook_metadata:struct\\u003cetag:string\\u003e\\u003e\",\"type_name\":\"STRUCT\",\"position\":15,\"nullable\":true,\"comment\":\"The metadata of the event type ASSET_REVIEW_CREATED\"},{\"name\":\"run_jar_started_metadata\",\"type_text\":\"struct\\u003cjar_analysis_name:string,run_id:string,jar_analysis_etag:string,jar_analysis_update_time:timestamp\\u003e\",\"type_name\":\"STRUCT\",\"position\":16,\"nullable\":true,\"comment\":\"The metadata of the event type RUN_JAR_STARTED\"},{\"name\":\"run_jar_completed_metadata\",\"type_text\":\"struct\\u003cjar_analysis_name:string,run_id:string,state:string,duration_in_seconds:int,output_schema:struct\\u003cname:string,owner_global_metastore_id:string,action:string,expire_time:timestamp,assets_added:array\\u003cstruct\\u003cname:string,data_object_type:string\\u003e\\u003e\\u003e,shared_output_schema:struct\\u003cname:string,owner_global_metastore_id:string,action:string,expire_time:timestamp,assets_added:array\\u003cstruct\\u003cname:string,data_object_type:string\\u003e\\u003e\\u003e\\u003e\",\"type_name\":\"STRUCT\",\"position\":17,\"nullable\":true,\"comment\":\"The metadata of the event type RUN_JAR_COMPLETED\"}]},{\"name\":\"column_lineage\",\"catalog_name\":\"system\",\"schema_name\":\"access\",\"table_type\":\"MANAGED\",\"comment\":\"The column lineage system table includes a record for each write event (Spark operation) on a Unity Catalog table or path. This includes but is not limited to job, notebook, and dashboard runs. The column lineage table does not include events that do not have a source (e.g. inserting explicit values). Please refer to the [documentation](https://docs.databricks.com/en/data-governance/unity-catalog/data-lineage.html#limitations) for limitations.\",\"columns\":[{\"name\":\"account_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"nullable\":true,\"comment\":\"The id of the Databricks account.\"},{\"name\":\"metastore_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":1,\"nullable\":true,\"comment\":\"The id of the Unity Catalog metastore.\"},{\"name\":\"workspace_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":2,\"nullable\":true,\"comment\":\"The id of the workspace\"},{\"name\":\"entity_type\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":3,\"nullable\":true,\"comment\":\"The type of entity the lineage transaction was captured from. The supported value is NOTEBOOK, JOB, PIPELINE, DASHBOARD_V3 (AI/BI Dashboard), DBSQL_DASHBOARD (Legacy dashboard), DBSQL_QUERY, OR NULL.\"},{\"name\":\"entity_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":4,\"nullable\":true,\"comment\":\"The id of the entity the lineage transaction was captured from. If entity_type is NULL, entity_id is NULL.\"},{\"name\":\"entity_run_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":5,\"nullable\":true,\"comment\":\"id to describe the unique run of the entity, or NULL. This differs for each entity type:\\n\\nNotebook: command_run_id\\n\\nJob: job_run_id\\n\\nDatabricks SQL query: statement_id\\n\\nDashboard: statement_id\\n\\nLegacy dashboard: statement_id\\n\\nPipeline: pipeline_update_id\\n\\nIf entity_type is NULL, entity_run_id is NULL. Records with statement_id and job_run_id can be joined with the query history and jobs system tables respectively.\"},{\"name\":\"source_table_full_name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":6,\"nullable\":true,\"comment\":\"Three-level name to identify the source table.\"},{\"name\":\"source_table_catalog\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":7,\"nullable\":true,\"comment\":\"The catalog of the source table.\"},{\"name\":\"source_table_schema\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":8,\"nullable\":true,\"comment\":\"The schema of the source table.\"},{\"name\":\"source_table_name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":9,\"nullable\":true,\"comment\":\"The name of the source table.\"},{\"name\":\"source_path\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":10,\"nullable\":true,\"comment\":\"Location in cloud storage of the source table, or the path if it's reading from cloud storage directly.\"},{\"name\":\"source_type\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":11,\"nullable\":true,\"comment\":\"The type of the source. The value is TABLE, PATH, VIEW, MATERIALIZED_VIEW, METRIC_VIEW, or STREAMING_TABLE.\"},{\"name\":\"source_column_name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":12,\"nullable\":true,\"comment\":\"The name of the source column.\"},{\"name\":\"target_table_full_name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":13,\"nullable\":true,\"comment\":\"Three-level name to identify the target table.\"},{\"name\":\"target_table_catalog\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":14,\"nullable\":true,\"comment\":\"The catalog of the target table.\"},{\"name\":\"target_table_schema\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":15,\"nullable\":true,\"comment\":\"The schema of the target table.\"},{\"name\":\"target_table_name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":16,\"nullable\":true,\"comment\":\"The name of the target table.\"},{\"name\":\"target_path\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":17,\"nullable\":true,\"comment\":\"Location in cloud storage of the target table.\"},{\"name\":\"target_type\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":18,\"nullable\":true,\"comment\":\"The type of the target. The value is TABLE, PATH, VIEW, MATERIALIZED_VIEW, METRIC_VIEW, or STREAMING_TABLE.\"},{\"name\":\"target_column_name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":19,\"nullable\":true,\"comment\":\"The name of the target column.\"},{\"name\":\"created_by\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":20,\"nullable\":true,\"comment\":\"The user who generated this lineage. This can be a Databricks username, a Databricks service principal ID, a Databricks group name, 'System-User', or NULL if the user information cannot be captured.\"},{\"name\":\"event_time\",\"type_text\":\"timestamp\",\"type_name\":\"TIMESTAMP\",\"position\":21,\"nullable\":true,\"comment\":\"The timestamp when the lineage was generated. Timezone information is recorded at the end of the value with +00:00 representing UTC.\"},{\"name\":\"event_date\",\"type_text\":\"date\",\"type_name\":\"DATE\",\"position\":22,\"nullable\":true,\"comment\":\"The date when the lineage was generated. This is a partitioned column.\"},{\"name\":\"record_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":23,\"nullable\":true,\"comment\":\"Primary key of each row, it is auto-generated and cannot be joined with any tables\"},{\"name\":\"event_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":24,\"nullable\":true,\"comment\":\"One query or one spark job run could append multiple lineage rows, this event_id is a unique id to group the rows that belong to the same event. This is generated in the pipeline and cannot be joined with any tables.\"},{\"name\":\"statement_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":25,\"nullable\":true,\"comment\":\"A foreign key to join with query history system table. It is set when a query is from a warehouse or serverless warehouse.\"},{\"name\":\"entity_metadata\",\"type_text\":\"struct\\u003cjob_info:struct\\u003cjob_id:string,job_run_id:string\\u003e,dashboard_id:string,legacy_dashboard_id:string,notebook_id:string,sql_query_id:string,dlt_pipeline_info:struct\\u003cdlt_pipeline_id:string,dlt_update_id:string\\u003e,genie_space_id:string,alert_id:string,app_id:string\\u003e\",\"type_name\":\"STRUCT\",\"position\":26,\"nullable\":true,\"comment\":\"It is a list of ids of the query context which is joinable with other system tables.\"},{\"name\":\"direct_access\",\"type_text\":\"boolean\",\"type_name\":\"BOOLEAN\",\"position\":27,\"nullable\":true,\"comment\":\"Indicates whether the lineage relationship is a direct access. False if the access is indirect (e.g. via view expansion).\"}]},{\"name\":\"inbound_network\",\"catalog_name\":\"system\",\"schema_name\":\"access\",\"table_type\":\"MANAGED\",\"comment\":\"The inbound network access control table records policy evaluation events for incoming network requests. Each row represents a single access control policy evaluation.\",\"columns\":[{\"name\":\"account_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"nullable\":true,\"comment\":\"The ID of the Databricks account\"},{\"name\":\"workspace_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":1,\"nullable\":true,\"comment\":\"The ID of the workspace where the event occurred\"},{\"name\":\"event_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":2,\"nullable\":true,\"comment\":\"The ID of the event\"},{\"name\":\"request_path\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":3,\"nullable\":true,\"comment\":\"The destination of the request\"},{\"name\":\"source\",\"type_text\":\"struct\\u003cip:string\\u003e\",\"type_name\":\"STRUCT\",\"position\":4,\"nullable\":true,\"comment\":\"The source of the request\"},{\"name\":\"authenticated_as\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":5,\"nullable\":true,\"comment\":\"The authenticated identity of the request. Can be a user email, service principal application ID, group name, 'users', or 'account users'\"},{\"name\":\"event_time\",\"type_text\":\"timestamp\",\"type_name\":\"TIMESTAMP\",\"position\":6,\"nullable\":true,\"comment\":\"Timestamp when the event took place\"},{\"name\":\"policy_outcome\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":7,\"nullable\":true,\"comment\":\"Type of access event that occurred: 'DENIED', 'DRY_RUN_DENIAL', or 'ALLOWED'. ALLOWED events are sampled, so they are not a complete record of allowed traffic.\"},{\"name\":\"rule_label\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":8,\"nullable\":true,\"comment\":\"The label of the ingress rule that denied the request.\"}]},{\"name\":\"outbound_network\",\"catalog_name\":\"system\",\"schema_name\":\"access\",\"table_type\":\"MANAGED\",\"comment\":\"The network access events table records network access events including allowed and denied traffic. Each row represents an individual event. For example, if a user attempts to access \\\"google.com\\\" from a notebook, the access attempt (allowed or denied) would be logged as an event.\",\"columns\":[{\"name\":\"account_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"nullable\":true,\"comment\":\"The ID of the Databricks account\"},{\"name\":\"workspace_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":1,\"nullable\":true,\"comment\":\"The ID of the workspace where the event occurred\"},{\"name\":\"destination_type\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":2,\"nullable\":true,\"comment\":\"The type of destination. Possible values are DNS, IP, and STORAGE\"},{\"name\":\"destination\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":3,\"nullable\":true,\"comment\":\"Details of the destination. Depending on the destination type, the value could be a domain name, IP address, or storage location.\"},{\"name\":\"dns_event\",\"type_text\":\"struct\\u003cdomain_name:string,rcode:int,rdata:array\\u003cstring\\u003e\\u003e\",\"type_name\":\"STRUCT\",\"position\":4,\"nullable\":true,\"comment\":\"Details about the DNS destination. Only populates for DNS destinations, otherwise the field is NULL.\"},{\"name\":\"storage_event\",\"type_text\":\"struct\\u003chostname:string,path:string,rejection_reason:string,rdata:array\\u003cstring\\u003e\\u003e\",\"type_name\":\"STRUCT\",\"position\":5,\"nullable\":true,\"comment\":\"Details about the storage destination. Only populates for storage destinations, otherwise the field is NULL.\"},{\"name\":\"event_time\",\"type_text\":\"timestamp\",\"type_name\":\"TIMESTAMP\",\"position\":6,\"nullable\":true,\"comment\":\"Timestamp when the event took place\"},{\"name\":\"access_type\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":7,\"nullable\":true,\"comment\":\"Type of access event that occurred.\"},{\"name\":\"event_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":8,\"nullable\":true,\"comment\":\"The ID of the event\"},{\"name\":\"network_source_type\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":9,\"nullable\":true,\"comment\":\"The source type of the network event, mainly for customer debugging\"}]},{\"name\":\"table_lineage\",\"catalog_name\":\"system\",\"schema_name\":\"access\",\"table_type\":\"MANAGED\",\"comment\":\"The table lineage system table includes a record for each read or write event (Spark operation) on a UC table or path. This includes but is not limited to job, notebook, and dashboard runs. This table can be joined with other system tables such as Query History and Jobs to get additional information about the read/write operation. Please refer to the [documentation](https://docs.databricks.com/en/data-governance/unity-catalog/data-lineage.html#limitations) for limitations.\",\"columns\":[{\"name\":\"account_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"nullable\":true,\"comment\":\"The id of the Databricks account.\"},{\"name\":\"metastore_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":1,\"nullable\":true,\"comment\":\"The id of the Unity Catalog metastore.\"},{\"name\":\"workspace_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":2,\"nullable\":true,\"comment\":\"The id of the workspace\"},{\"name\":\"entity_type\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":3,\"nullable\":true,\"comment\":\"The type of entity the lineage transaction was captured from. The value is NOTEBOOK, JOB, PIPELINE, DASHBOARD_V3 (Dashboard), DBSQL_DASHBOARD (Legacy dashboard), DBSQL_QUERY, OR NULL.\"},{\"name\":\"entity_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":4,\"nullable\":true,\"comment\":\"The ID of the entity the lineage transaction was captured from. If entity_type is NULL, entity_id is NULL.\"},{\"name\":\"entity_run_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":5,\"nullable\":true,\"comment\":\"id to describe the unique run of the entity, or NULL. This differs for each entity type:\\n\\nNotebook: command_run_id\\n\\nJob: job_run_id\\n\\nDatabricks SQL query: statement_id\\n\\nDashboard: statement_id\\n\\nLegacy dashboard: statement_id\\n\\nPipeline: pipeline_update_id\\n\\nIf entity_type is NULL, entity_run_id is NULL. Records with statement_id and job_run_id can be joined with the query history and jobs system tables respectively.\"},{\"name\":\"source_table_full_name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":6,\"nullable\":true,\"comment\":\"Three-part name to identify the source table.\"},{\"name\":\"source_table_catalog\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":7,\"nullable\":true,\"comment\":\"The catalog of the source table.\"},{\"name\":\"source_table_schema\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":8,\"nullable\":true,\"comment\":\"The schema of the source table.\"},{\"name\":\"source_table_name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":9,\"nullable\":true,\"comment\":\"The name of the source table.\"},{\"name\":\"source_path\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":10,\"nullable\":true,\"comment\":\"Location in cloud storage of the source table, or the path if it's reading from cloud storage directly.\"},{\"name\":\"source_type\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":11,\"nullable\":true,\"comment\":\"The type of the source. The value is TABLE, PATH, VIEW, MATERIALIZED_VIEW, METRIC_VIEW, or STREAMING_TABLE.\"},{\"name\":\"target_table_full_name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":12,\"nullable\":true,\"comment\":\"Three-part name to identify the target table.\"},{\"name\":\"target_table_catalog\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":13,\"nullable\":true,\"comment\":\"The catalog of the target table.\"},{\"name\":\"target_table_schema\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":14,\"nullable\":true,\"comment\":\"The schema of the target table.\"},{\"name\":\"target_table_name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":15,\"nullable\":true,\"comment\":\"The name of the target table.\"},{\"name\":\"target_path\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":16,\"nullable\":true,\"comment\":\"Location in cloud storage of the target table.\"},{\"name\":\"target_type\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":17,\"nullable\":true,\"comment\":\"The type of the target. The value is TABLE, PATH, VIEW, MATERIALIZED_VIEW, METRIC_VIEW, or STREAMING_TABLE.\"},{\"name\":\"created_by\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":18,\"nullable\":true,\"comment\":\"The user who generated this lineage. This can be a Databricks username, a Databricks service principal ID, a Databricks group name, 'System-User', or NULL if the user information cannot be captured.\"},{\"name\":\"event_time\",\"type_text\":\"timestamp\",\"type_name\":\"TIMESTAMP\",\"position\":19,\"nullable\":true,\"comment\":\"The timestamp when the lineage was generated. Timezone information is recorded at the end of the value with +00:00 representing UTC.\"},{\"name\":\"event_date\",\"type_text\":\"date\",\"type_name\":\"DATE\",\"position\":20,\"nullable\":true,\"comment\":\"The date when the lineage was generated. This is a partitioned column.\"},{\"name\":\"record_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":21,\"nullable\":true,\"comment\":\"Primary key of each row, it is auto-generated and cannot be joined with any tables\"},{\"name\":\"event_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":22,\"nullable\":true,\"comment\":\"One query or one spark job run could append multiple lineage rows, this event_id is a unique id to group the rows that belong to the same event. This is generated in the pipeline and cannot be joined with any tables.\"},{\"name\":\"statement_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":23,\"nullable\":true,\"comment\":\"A foreign key to join with query history system table. It is set when a query is from a warehouse or serverless warehouse.\"},{\"name\":\"entity_metadata\",\"type_text\":\"struct\\u003cjob_info:struct\\u003cjob_id:string,job_run_id:string\\u003e,dashboard_id:string,legacy_dashboard_id:string,notebook_id:string,sql_query_id:string,dlt_pipeline_info:struct\\u003cdlt_pipeline_id:string,dlt_update_id:string\\u003e,genie_space_id:string,alert_id:string,app_id:string\\u003e\",\"type_name\":\"STRUCT\",\"position\":24,\"nullable\":true,\"comment\":\"It is a list of ids of the query context which is joinable with other system tables.\"},{\"name\":\"direct_access\",\"type_text\":\"boolean\",\"type_name\":\"BOOLEAN\",\"position\":25,\"nullable\":true,\"comment\":\"Indicates whether the lineage relationship is a direct access. False if the access is indirect (e.g. via view expansion).\"}]},{\"name\":\"workspaces_latest\",\"catalog_name\":\"system\",\"schema_name\":\"access\",\"table_type\":\"MANAGED\",\"comment\":\"The workspaces system table is a slow-changing dimension table of metadata for all the workspaces in your account.\",\"columns\":[{\"name\":\"account_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"nullable\":true,\"comment\":\"The ID of the parent account of this workspace.\"},{\"name\":\"workspace_id\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":1,\"nullable\":true,\"comment\":\"The ID of the workspace.\"},{\"name\":\"workspace_name\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":2,\"nullable\":true,\"comment\":\"The human-readable name of the workspace.\"},{\"name\":\"workspace_url\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":3,\"nullable\":true,\"comment\":\"URL of the databricks workspace.\"},{\"name\":\"create_time\",\"type_text\":\"timestamp\",\"type_name\":\"TIMESTAMP\",\"position\":4,\"nullable\":true,\"comment\":\"Timestamp of when the workspace was created.\"},{\"name\":\"status\",\"type_text\":\"string\",\"type_name\":\"STRING\",\"position\":5,\"nullable\":true,\"comment\":\"Lifecycle status of the workspace: NOT_PROVISIONED | PROVISIONING | RUNNING | FAILED | BANNED\"}]}]}"}
