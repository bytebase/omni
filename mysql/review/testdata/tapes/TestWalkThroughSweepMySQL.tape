| UNION ALL SELECT CONCAT_WS('\t', 'event', EVENT_SCHEMA, '', EVENT_NAME, ''), EVENT_SCHEMA FROM information_schema.EVENTS
| ) o WHERE o.db NOT IN ('mysql', 'information_schema', 'performance_schema', 'sys')
