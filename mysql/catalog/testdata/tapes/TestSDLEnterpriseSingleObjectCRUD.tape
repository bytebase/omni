| CREATE ALGORITHM=UNDEFINED DEFINER=`root`@`%` SQL SECURITY DEFINER VIEW `ent_v_users` AS select `users`.`userid` AS `userid`,`users`.`username` AS `username`,`users`.`name` AS `name` from `users`
