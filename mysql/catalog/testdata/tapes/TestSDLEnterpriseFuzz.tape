| CREATE TABLE `ent_fz_part` (
|   `id` bigint unsigned NOT NULL,
|   `bucket` int NOT NULL,
|   `note` varchar(40) NOT NULL DEFAULT '',
|   PRIMARY KEY (`id`,`bucket`)
| ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
| /*!50100 PARTITION BY HASH (`bucket`)
| PARTITIONS 4 */
