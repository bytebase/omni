          "definition": "CREATE PROCEDURE `sp_touch_order`(IN p_id BIGINT, OUT p_total INT)\n    READS SQL DATA\n    COMMENT 'reads order total'\nBEGIN\n\tSELECT total INTO p_total FROM orders WHERE id = p_id;\nEND",
