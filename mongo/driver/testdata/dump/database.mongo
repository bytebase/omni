// MongoDB schema dump of database "omni_driver"
db.createCollection("empty");
db.runCommand({"createIndexes": "empty", "indexes": [{"key": {"_id":1}, "name": "_id_", "v": 2}]});
db.createCollection("events");
db.runCommand({"createIndexes": "events", "indexes": [{"key": {"_id":1}, "name": "_id_", "v": 2}]});
db.runCommand({"createIndexes": "events", "indexes": [{"key": {"kind":1,"_id":-1}, "name": "kind_1__id_-1", "v": 2}]});
db.createCollection("nested");
db.runCommand({"createIndexes": "nested", "indexes": [{"key": {"_id":1}, "name": "_id_", "v": 2}]});
db.createCollection("orders");
db.runCommand({"createIndexes": "orders", "indexes": [{"key": {"_id":1}, "name": "_id_", "v": 2}]});
db.runCommand({"createIndexes": "orders", "indexes": [{"key": {"customer_id":1,"created_at":-1}, "name": "customer_id_1_created_at_-1", "v": 2}]});
db.createCollection("sessions");
db.runCommand({"createIndexes": "sessions", "indexes": [{"key": {"_id":1}, "name": "_id_", "v": 2}]});
db.runCommand({"createIndexes": "sessions", "indexes": [{"key": {"created_at":1}, "name": "created_at_1", "expireAfterSeconds": 3600, "v": 2}]});
db.runCommand({"create": "telemetry", "timeseries": {"timeField": "at", "metaField": "sensor", "granularity": "seconds", "bucketMaxSpanSeconds": 3600}});
db.runCommand({"createIndexes": "telemetry", "indexes": [{"key": {"sensor":1,"at":1}, "name": "sensor_1_at_1", "v": 2}]});
db.createCollection("users");
db.runCommand({"createIndexes": "users", "indexes": [{"key": {"_id":1}, "name": "_id_", "v": 2}]});
db.runCommand({"createIndexes": "users", "indexes": [{"key": {"age":-1,"name":1}, "name": "age_-1_name_1", "v": 2}]});
db.runCommand({"createIndexes": "users", "indexes": [{"key": {"name":1}, "name": "name_1", "unique": true, "v": 2}]});
db.runCommand({"create": "v_adults", "viewOn": "users", "pipeline": [{"$match": {"age": {"$gte": 18}}}]});
