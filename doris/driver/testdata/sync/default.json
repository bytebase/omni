          "name": "v_open_accounts",
          "definition": "SELECT `internal`.`omni_sync_corpus`.`accounts`.`id` AS `acct_id`, `internal`.`omni_sync_corpus`.`accounts`.`email` AS `acct_email` FROM `internal`.`omni_sync_corpus`.`accounts` WHERE `internal`.`omni_sync_corpus`.`accounts`.`status` = 'open'",
