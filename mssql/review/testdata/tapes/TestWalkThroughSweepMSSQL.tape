| SELECT ss.name, so.name, so.type, st.name FROM shop2.sys.triggers st JOIN shop2.sys.sql_modules m ON m.object_id = st.object_id
| 		JOIN shop2.sys.objects so ON so.object_id = st.parent_id JOIN shop2.sys.schemas ss ON ss.schema_id = so.schema_id
| 		WHERE st.is_disabled = 0 AND st.is_ms_shipped = 0 AND st.parent_id <> 0 AND so.type IN ('U', 'V')
| 		ORDER BY ss.name, so.name, st.name
