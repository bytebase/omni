| SELECT s.name, o.name, c.name, ISNULL(dc.name, ''), CASE WHEN c.is_computed = 1 THEN 'AS ' + ISNULL(cc.definition, '') ELSE ISNULL(ty.name, '') END, c.is_nullable FROM shop0.sys.columns c
| 		JOIN shop0.sys.objects o ON o.object_id = c.object_id JOIN shop0.sys.schemas s ON s.schema_id = o.schema_id
| 		LEFT JOIN shop0.sys.computed_columns cc ON cc.object_id = c.object_id AND cc.column_id = c.column_id
| 		LEFT JOIN shop0.sys.types ty ON ty.user_type_id = c.user_type_id
| 		LEFT JOIN shop0.sys.default_constraints dc ON dc.object_id = c.default_object_id
| 		WHERE o.type = 'U'
| 		ORDER BY s.name, o.name, c.column_id
