> query
| SELECT s.name, t.name, o.name, o.type FROM sim.sys.objects o JOIN sim.sys.tables t ON t.object_id = o.parent_object_id JOIN sim.sys.schemas s ON s.schema_id = t.schema_id WHERE o.type IN ('PK', 'UQ', 'F', 'C', 'D', 'EC') ORDER BY s.name, t.name, o.name
< result
