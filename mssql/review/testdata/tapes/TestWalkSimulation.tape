| SELECT s.name, t.name, i.name, CASE WHEN i.is_primary_key = 1 THEN 'pk' WHEN i.is_unique_constraint = 1 THEN 'uq' ELSE 'index' END FROM sim.sys.indexes i JOIN sim.sys.tables t ON t.object_id = i.object_id JOIN sim.sys.schemas s ON s.schema_id = t.schema_id WHERE i.name IS NOT NULL ORDER BY s.name, t.name, i.name
