> query
| SELECT s.name, t.name FROM sim.sys.key_constraints k JOIN sim.sys.tables t ON t.object_id = k.parent_object_id JOIN sim.sys.schemas s ON s.schema_id = t.schema_id WHERE k.type = 'PK' ORDER BY s.name, t.name
