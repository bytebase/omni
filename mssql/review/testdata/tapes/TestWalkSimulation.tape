| 		JOIN sim.sys.objects o ON o.object_id = c.object_id JOIN sim.sys.schemas s ON s.schema_id = o.schema_id
| 		LEFT JOIN sim.sys.computed_columns cc ON cc.object_id = c.object_id AND cc.column_id = c.column_id
| 		LEFT JOIN sim.sys.types ty ON ty.user_type_id = c.user_type_id
| 		LEFT JOIN sim.sys.default_constraints dc ON dc.object_id = c.default_object_id
| 		WHERE o.type = 'U'
