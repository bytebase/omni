| SELECT s.name, o.name, i.name, i.is_primary_key, i.is_unique, i.is_unique_constraint, i.type_desc FROM sim.sys.indexes i
| 		JOIN sim.sys.objects o ON o.object_id = i.object_id JOIN sim.sys.schemas s ON s.schema_id = o.schema_id
| 		WHERE i.index_id > 0 AND i.name IS NOT NULL AND o.type = 'U'
| 		AND (i.is_primary_key = 1 OR i.is_unique_constraint = 1 OR EXISTS (SELECT 1 FROM sim.sys.index_columns ic JOIN sim.sys.all_columns c ON c.object_id = ic.object_id AND c.column_id = ic.column_id WHERE ic.object_id = i.object_id AND ic.index_id = i.index_id))
| 		ORDER BY s.name, o.name, i.name
