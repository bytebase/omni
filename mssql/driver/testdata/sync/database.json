              "body":  "CREATE TRIGGER app.trg_orders_bi ON app.orders AFTER INSERT AS\nBEGIN\n\tUPDATE app.orders SET total = 0 WHERE total < 0 AND id IN (SELECT id FROM inserted);\nEND;"
