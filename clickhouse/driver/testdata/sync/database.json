{
  "name": "omni_testsyncdatabase",
  "schemas": [
    {
      "tables": [
        {
          "name": "events",
          "columns": [
            {
              "name": "id",
              "position": 1,
              "default": "NULL",
              "type": "UInt64"
            },
            {
              "name": "name",
              "position": 2,
              "default": "NULL",
              "type": "String",
              "comment": "the event name"
            },
            {
              "name": "at",
              "position": 3,
              "default": "NULL",
              "type": "DateTime64(3, 'UTC')"
            },
            {
              "name": "amount",
              "position": 4,
              "default": "NULL",
              "nullable": true,
              "type": "Nullable(Decimal(12, 2))"
            },
            {
              "name": "tags",
              "position": 5,
              "default": "NULL",
              "type": "Array(String)"
            },
            {
              "name": "attrs",
              "position": 6,
              "default": "NULL",
              "type": "Map(String, String)"
            },
            {
              "name": "fixed",
              "position": 7,
              "default": "NULL",
              "type": "FixedString(4)"
            },
            {
              "name": "flag",
              "position": 8,
              "default": "NULL",
              "type": "Bool"
            },
            {
              "name": "level",
              "position": 9,
              "default": "NULL",
              "type": "Enum8('info' = 1, 'warn' = 2)"
            },
            {
              "name": "seen",
              "position": 10,
              "default": "'2026-01-02'",
              "type": "Date"
            },
            {
              "name": "ref",
              "position": 11,
              "default": "generateUUIDv4()",
              "type": "UUID"
            },
            {
              "name": "price",
              "position": 12,
              "default": "1.5",
              "type": "Decimal(18, 4)"
            },
            {
              "name": "point",
              "position": 13,
              "default": "(0, NULL)",
              "type": "Tuple(x Float64, y Nullable(Float64))"
            },
            {
              "name": "matrix",
              "position": 14,
              "default": "NULL",
              "type": "Array(Array(Nullable(Decimal(9, 3))))"
            },
            {
              "name": "counts",
              "position": 15,
              "default": "map('a', [1, 2])",
              "type": "Map(LowCardinality(String), Array(UInt64))"
            },
            {
              "name": "label",
              "position": 16,
              "default": "concat(name, '!')",
              "type": "String",
              "generation": {
                "type": "TYPE_VIRTUAL",
                "expression": "concat(name, '!')"
              }
            },
            {
              "name": "doubled",
              "position": 17,
              "default": "id * 2",
              "type": "UInt64",
              "generation": {
                "type": "TYPE_STORED",
                "expression": "id * 2"
              }
            }
          ],
          "indexes": [
            {
              "expressions": [
                "id"
              ],
              "primary": true
            }
          ],
          "engine": "MergeTree",
          "comment": "events the sync reads",
          "sortingKeys": [
            "id",
            "name"
          ]
        },
        {
          "name": "skipped",
          "columns": [
            {
              "name": "url",
              "position": 1,
              "default": "NULL",
              "type": "String"
            },
            {
              "name": "body",
              "position": 2,
              "default": "NULL",
              "type": "String"
            }
          ],
          "indexes": [
            {
              "name": "url_bloom",
              "expressions": [
                "url"
              ],
              "type": "bloom_filter",
              "granularity": "4"
            },
            {
              "expressions": [
                "url"
              ],
              "primary": true
            }
          ],
          "engine": "MergeTree",
          "sortingKeys": [
            "url"
          ]
        }
      ],
      "views": [
        {
          "name": "event_names",
          "definition": "CREATE VIEW omni_testsyncdatabase.event_names (`id` UInt64, `name` String) AS SELECT id, name FROM omni_testsyncdatabase.events",
          "columns": [
            {
              "name": "id",
              "position": 1,
              "default": "NULL",
              "type": "UInt64"
            },
            {
              "name": "name",
              "position": 2,
              "default": "NULL",
              "type": "String"
            }
          ]
        }
      ]
    }
  ]
}
