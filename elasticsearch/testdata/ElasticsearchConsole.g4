// Kibana Dev Console relative paths without leading slash (25 paths)
relativePath
    : '_aliases'
    | '_bulk'
    | '_cat/health'
    | '_cat/indices'
    | '_cat/nodes'
    | '_cluster/health'
    | '_cluster/settings'
    | '_cluster/state'
    | '_count'
    | '_mget'
    | '_msearch'
    | '_nodes/stats'
    | '_refresh'
    | '_search'
    | '_sql'
    | 'my_index'
    | 'my_index/_count'
    | 'my_index/_doc'
    | 'my_index/_doc/a'
    | 'my_index/_mapping'
    | 'my_index/_refresh'
    | 'my_index/_search'
    | 'my_index/_settings'
    | 'my_index/_source/a'
    | 'my_index/_update/a'
    ;

// Elasticsearch REST paths with wildcards, multi-targets, cross-cluster colons, and encoding (8 paths)
specialPath
    : '/%3Clogs-%7Bnow%2Fd%7D%3E/_search'
    | '/index1,index2/_search'
    | '/logs-2026.*/_search'
    | '/logs.2026.11/_search'
    | '/my_index/_doc/a+b'
    | '/my_index/_doc/a~1'
    | '/my_index/_doc/user%40example.com'
    | '/remote:my_index/_search'
    ;

// Kibana Dev Console HTTP methods (case-insensitive in parser.go).
GET    : [Gg] [Ee] [Tt] ;
POST   : [Pp] [Oo] [Ss] [Tt] ;
PUT    : [Pp] [Uu] [Tt] ;
DELETE : [Dd] [Ee] [Ll] [Ee] [Tt] [Ee] ;
HEAD   : [Hh] [Ee] [Aa] [Dd] ;
PATCH  : [Pp] [Aa] [Tt] [Cc] [Hh] ;
