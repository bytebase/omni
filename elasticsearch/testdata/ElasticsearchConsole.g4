// Official HEAD endpoints (9 paths)
headEndpoint
    : HEAD '/' // ping
    | HEAD '/_alias/a' // indices.exists_alias
    | HEAD '/_component_template/a' // cluster.exists_component_template
    | HEAD '/_index_template/a' // indices.exists_index_template
    | HEAD '/_template/a' // indices.exists_template
    | HEAD '/my_index' // indices.exists
    | HEAD '/my_index/_alias/a' // indices.exists_alias
    | HEAD '/my_index/_doc/a' // exists
    | HEAD '/my_index/_source/a' // exists_source
    ;

