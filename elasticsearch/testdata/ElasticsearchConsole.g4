    | sqlPath
    | sslPath
    | streamsPath
    | synonymsPath
    | tasksPath
    | textStructurePath
    | transformPath
    | watcherPath
    | xpackPath
    ;

// Namespace: root (54 paths)
rootPath
    : '/' // info, ping
    | '/_bulk' // bulk
    | '/_capabilities' // capabilities
    | '/_count' // count
    | '/_delete_by_query/a/_rethrottle' // delete_by_query_rethrottle
