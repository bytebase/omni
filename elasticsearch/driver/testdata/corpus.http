PUT /alpha
{
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 0
  }
}

POST /alpha/_doc/1
{"name": "row 1", "n": 1}

POST /alpha/_doc/2
{"name": "row 2", "n": 2}

POST /alpha/_doc/3
{"name": "row 3", "n": 3}

POST /alpha/_doc/big
{"big": 9007199254740993, "name": "big"}

POST /alpha/_doc/app-errors
{"errors": true, "items": [{"update": {"error": {"reason": "logged application error"}}}]}

POST /alpha/_refresh

