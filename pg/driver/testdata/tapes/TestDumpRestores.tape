| CREATE INDEX "Own Measure 2025_Id_idx" ON "app"."Own Measure 2025" ("Id");
|
| ALTER INDEX "app"."own_measure_id" ATTACH PARTITION "app"."Own Measure 2025_Id_idx";
|
| CREATE OR REPLACE FUNCTION app.add(a integer, b integer DEFAULT 1)
|  RETURNS integer
|  LANGUAGE sql
|  IMMUTABLE STRICT
| AS $function$ SELECT a + b $function$
| ;
|
| COMMENT ON FUNCTION "app".add(integer, integer) IS 'adds integers';
|
| CREATE OR REPLACE FUNCTION app.add(a numeric, b numeric)
|  RETURNS numeric
|  LANGUAGE sql
|  IMMUTABLE
| AS $function$ SELECT a + b $function$
| ;
|
| CREATE TABLE "app"."animal" (
|     "name" text,
|     "legs" integer,
|     CONSTRAINT "animal_legs_check" CHECK (legs >= 0)
| );
|
| ALTER TABLE "app"."animal" OWNER TO "postgres";
|
| CREATE TABLE "app"."attached" (
|     "id" integer NOT NULL,
|     "v" text
| ) PARTITION BY LIST (v);
|
| ALTER TABLE "app"."attached" OWNER TO "postgres";
|
| CREATE TABLE "app"."attached_x" (
|     "id" integer NOT NULL,
|     "v" text,
|     CONSTRAINT "attached_x_positive" CHECK (id > 0)
| );
|
| ALTER TABLE ONLY "app"."attached" ATTACH PARTITION "app"."attached_x" FOR VALUES IN ('x');
|
| CREATE INDEX "attached_x_id" ON "app"."attached_x" (id);
|
| CREATE TABLE "app"."booking" (
|     "room" integer,
|     "during" tstzrange,
|     CONSTRAINT "booking_no_overlap" EXCLUDE USING gist (room WITH =, during WITH &&)
| );
|
| ALTER TABLE "app"."booking" OWNER TO "postgres";
|
| CREATE TABLE "app"."cross_schema" (
|     "id" integer NOT NULL,
|     "v" text NOT NULL
| ) PARTITION BY LIST (v);
|
| ALTER TABLE "app"."cross_schema" OWNER TO "postgres";
|
| CREATE TABLE "audit"."cross_schema_a" (
|     "id" integer NOT NULL,
|     "v" text NOT NULL
| );
|
| COMMENT ON TABLE "audit"."cross_schema_a" IS 'remote';
|
| ALTER TABLE ONLY "app"."cross_schema" ATTACH PARTITION "audit"."cross_schema_a" FOR VALUES IN ('a');
|
| CREATE TABLE "app"."customer" (
|     "id" bigint NOT NULL,
|     "alt_id" integer NOT NULL,
|     "email" public.citext NOT NULL,
|     "name" text COLLATE "C" DEFAULT 'anon'::text NOT NULL,
|     "nick" text COLLATE "app"."ci",
|     "mood" app.mood DEFAULT 'happy'::app.mood,
|     "home" app.address,
|     "tags" _text DEFAULT '{}'::text[],
|     "matrix" _int4,
|     "attrs" public.hstore,
|     "doc" jsonb DEFAULT '{"a": [1, 2]}'::jsonb,
|     "balance" numeric(12,2) DEFAULT 0,
|     "ratio" double precision,
|     "score" real,
|     "small" smallint,
|     "flag" boolean DEFAULT true,
|     "ts" timestamp(3) without time zone DEFAULT now(),
|     "tstz" timestamp(6) with time zone,
|     "born" date,
|     "alarm" time(2) with time zone,
|     "span" interval,
|     "bits" bit(3),
|     "vbits" bit varying(8),
|     "ip" inet,
|     "mac" macaddr,
|     "pt" point,
|     "words" tsvector,
|     "uid" uuid,
|     "raw" bytea DEFAULT '\xdeadbeef'::bytea,
|     "counter" integer DEFAULT nextval('app.counter'::regclass),
|     "owned" bigint DEFAULT nextval('app.owned_seq'::regclass),
|     "full_name" text GENERATED ALWAYS AS ((((name || ' <'::text) || (email)::text) || '>'::text)) STORED,
|     "Quoted Col" text,
|     "updated_at" timestamp(6) with time zone,
|     "moods" app._mood,
|     CONSTRAINT "customer_balance_check" CHECK (balance >= 0::numeric),
|     CONSTRAINT "customer_name_check" CHECK (length(name) > 0)
