| CREATE TABLE "app"."customer" (
|     "id" bigint NOT NULL,
|     "alt_id" integer NOT NULL,
|     "email" public.citext NOT NULL,
|     "name" text COLLATE "C" DEFAULT 'anon'::text NOT NULL,
|     "nick" text COLLATE "app"."ci",
