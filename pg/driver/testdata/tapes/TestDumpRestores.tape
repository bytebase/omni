> exec
|
| SET statement_timeout = 0;
| SET lock_timeout = 0;
| SET idle_in_transaction_session_timeout = 0;
| SET client_encoding = 'UTF8';
| SET standard_conforming_strings = on;
| SELECT pg_catalog.set_config('search_path', '', false);
| SET check_function_bodies = false;
| SET xmloption = content;
| SET client_min_messages = warning;
| SET row_security = off;
|
| CREATE SCHEMA IF NOT EXISTS "Mixed Case";
|
| ALTER SCHEMA "Mixed Case" OWNER TO "postgres";
|
| CREATE SCHEMA IF NOT EXISTS "app";
|
| ALTER SCHEMA "app" OWNER TO "corpus_owner";
|
| COMMENT ON SCHEMA "app" IS 'the application';
|
| CREATE SCHEMA IF NOT EXISTS "audit";
|
| ALTER SCHEMA "audit" OWNER TO "postgres";
|
| COMMENT ON SCHEMA "public" IS 'standard public schema';
|
| CREATE EXTENSION IF NOT EXISTS "btree_gist" WITH SCHEMA "public" VERSION '1.5';
|
| COMMENT ON EXTENSION "btree_gist" IS 'support for indexing common datatypes in GiST';
|
| CREATE EXTENSION IF NOT EXISTS "citext" WITH SCHEMA "public" VERSION '1.6';
|
| COMMENT ON EXTENSION "citext" IS 'data type for case-insensitive character strings';
|
| CREATE EXTENSION IF NOT EXISTS "hstore" WITH SCHEMA "public" VERSION '1.6';
|
| COMMENT ON EXTENSION "hstore" IS 'key/value pairs';
|
| CREATE EXTENSION IF NOT EXISTS "postgres_fdw" WITH SCHEMA "public" VERSION '1.0';
|
| COMMENT ON EXTENSION "postgres_fdw" IS 'foreign-data wrapper for remote PostgreSQL servers';
|
| CREATE COLLATION "app"."ci" (provider = icu, locale = 'und-u-ks-level2', deterministic = false);
|
| CREATE TYPE "app"."mood" AS ENUM (
|     'happy',
|     'sad',
|     'it''s complicated'
| );
|
| COMMENT ON TYPE "app"."mood" IS 'how it feels';
|
| CREATE TYPE "app"."address" AS (
|     "street" text COLLATE "C",
|     "city" character varying(50),
|     "zip" integer
| );
|
| COMMENT ON TYPE "app"."address" IS 'postal address';
|
| COMMENT ON COLUMN "app"."address"."street" IS 'street line';
|
| CREATE TYPE "app"."addresses" AS (
|     "home" app.address,
|     "others" app.address[]
| );
|
| CREATE TYPE "app"."empty_type" AS (
|
| );
|
| CREATE TYPE "app"."float_range" AS RANGE (
|     subtype = double precision
| );
|
| CREATE SEQUENCE "app"."counter"
|     AS integer
| 	START WITH 10
| 	INCREMENT BY 5
| 	MINVALUE -100
| 	MAXVALUE 1000
| 	CACHE 3
| 	CYCLE;
|
| COMMENT ON SEQUENCE "app"."counter" IS 'counts by five';
|
| CREATE SEQUENCE "app"."orders_id_seq"
|     AS bigint
| 	START WITH 1
| 	INCREMENT BY 1
| 	MINVALUE 1
| 	MAXVALUE 9223372036854775807
| 	CACHE 1
| 	NO CYCLE;
|
| CREATE SEQUENCE "app"."owned_seq"
|     AS bigint
| 	START WITH 1
| 	INCREMENT BY 1
| 	MINVALUE 1
| 	MAXVALUE 9223372036854775807
| 	CACHE 1
| 	NO CYCLE;
|
| CREATE SEQUENCE "app"."seq_owner_id_seq"
|     AS integer
| 	START WITH 1
| 	INCREMENT BY 1
| 	MINVALUE 1
| 	MAXVALUE 2147483647
| 	CACHE 1
| 	NO CYCLE;
|
| CREATE SEQUENCE "audit"."big_seq"
|     AS bigint
| 	START WITH 1
| 	INCREMENT BY 1
| 	MINVALUE 1
| 	MAXVALUE 9223372036854775807
| 	CACHE 1
| 	NO CYCLE;
|
| CREATE SEQUENCE "public"."plain_a_seq"
|     AS integer
| 	START WITH 1
| 	INCREMENT BY 1
| 	MINVALUE 1
| 	MAXVALUE 2147483647
| 	CACHE 1
| 	NO CYCLE;
|
| SET default_tablespace = '';
|
| CREATE SERVER "loopback" FOREIGN DATA WRAPPER "postgres_fdw" OPTIONS (host 'localhost', dbname 'postgres');
|
| CREATE TABLE "Mixed Case"."Table" (
|     "Id" integer NOT NULL,
|     "Value" text
| );
|
| ALTER TABLE "Mixed Case"."Table" OWNER TO "postgres";
|
| ALTER TABLE ONLY "Mixed Case"."Table" ADD CONSTRAINT "Table_pkey" PRIMARY KEY ("Id");
|
| CREATE TABLE "app"."Own Measure" (
|     "Id" integer NOT NULL,
|     "On" date NOT NULL
| ) PARTITION BY RANGE ("On");
|
| ALTER TABLE "app"."Own Measure" OWNER TO "postgres";
|
| CREATE TABLE "app"."Own Measure 2025" (
|     "Id" integer NOT NULL,
|     "On" date NOT NULL
| );
|
| ALTER TABLE ONLY "app"."Own Measure" ATTACH PARTITION "app"."Own Measure 2025" FOR VALUES FROM ('2025-01-01') TO ('2026-01-01');
