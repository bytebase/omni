| 	  AND tbl.schemaname NOT LIKE 'pg_temp%'
| 	  AND tbl.schemaname NOT LIKE 'pg_toast%' AND pc.relispartition IS FALSE
| 	ORDER BY tbl.schemaname, tbl.tablename;
