< column "schema_name" "NAME"
< column "type_name" "NAME"
< column "subtype" "TEXT"
< column "subtype_opclass" "TEXT"
< column "collation" "TEXT"
< column "canonical" "TEXT"
< column "subtype_diff" "TEXT"
< column "multirange_name" "TEXT"
< column "comment" "TEXT"
