< column "oid" "OID"
< column "schema_name" "NAME"
< column "type_name" "NAME"
< column "type_comment" "TEXT"
< column "attribute_name" "NAME"
< column "attribute_type" "TEXT"
< column "attribute_collation" "TEXT"
< column "attribute_comment" "TEXT"
