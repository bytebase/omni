|   		LEFT JOIN pg_depend d ON
|   			(c.relkind =  'S' AND
|                 d.classid = 'pg_class'::regclass AND d.objid = c.oid AND
|                 d.objsubid = 0 AND
|                 d.refclassid = 'pg_class'::regclass AND d.deptype IN ('a', 'i'))
| 	WHERE refobjid is NOT NULL and refobjsubid is NOT NULL
| 	ORDER BY c.oid;
