< column "index_definition" "TEXT"
< column "key_expressions" "_TEXT"
< column "key_opclass_names" "_NAME"
< column "key_opclass_defaults" "_BOOL"
< column "is_constraint" "BOOL"
< column "comment" "TEXT"
< column "index_options" "-"
