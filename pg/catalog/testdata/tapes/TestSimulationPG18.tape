| 			FROM pg_catalog.pg_constraint k WHERE k.contypid = t.oid AND k.contype = 'c'), '')
| 		|| coalesce((SELECT format(E'COMMENT ON DOMAIN %I IS %L;\n', t.typname, pg_catalog.obj_description(t.oid, 'pg_type'))
