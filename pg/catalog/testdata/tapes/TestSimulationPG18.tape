| 	SELECT 'TYPE', t.typname,
| 		format(E'CREATE TYPE %I;\n', t.typname)
| 		|| coalesce((SELECT format(E'COMMENT ON TYPE %I IS %L;\n', t.typname, pg_catalog.obj_description(t.oid, 'pg_type'))
