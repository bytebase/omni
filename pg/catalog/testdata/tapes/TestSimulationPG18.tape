| 			WHERE pg_catalog.obj_description(t.oid, 'pg_type') IS NOT NULL), '')
| 		FROM pg_catalog.pg_type t
| 		WHERE t.typnamespace = 'public'::pg_catalog.regnamespace AND t.typtype = 'p' AND NOT t.typisdefined
