| WITH rel AS (
| 	SELECT c.oid, c.relname, c.relkind, c.relpersistence, c.relispartition, c.relispopulated, c.relpartbound,
| 		c.relreplident, c.relrowsecurity, c.relforcerowsecurity, c.reltype,
