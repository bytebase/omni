| 	UNION ALL
| 	SELECT CASE r.relkind WHEN 'v' THEN 'VIEW' ELSE 'MATERIALIZED VIEW' END, r.relname,
| 		format(E'CREATE %s %I%s AS %s%s;\n', CASE r.relkind WHEN 'v' THEN 'VIEW' ELSE 'MATERIALIZED VIEW' END, r.relname, r.options,
