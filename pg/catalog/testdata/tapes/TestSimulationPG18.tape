| 			WHERE pg_catalog.obj_description(t.oid, 'pg_type') IS NOT NULL), '')
| 		FROM pg_catalog.pg_type t
| 		WHERE t.typnamespace = 'public'::pg_catalog.regnamespace AND t.typtype = 'e'
| 	UNION ALL
| 	SELECT 'DOMAIN', t.typname,
