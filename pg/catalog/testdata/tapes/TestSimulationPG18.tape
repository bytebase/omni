| 			WHERE d.classid = 'pg_catalog.pg_class'::pg_catalog.regclass AND d.refobjid = r.oid AND d.deptype = 'a' AND s.relkind = 'S'), '')
| 		|| coalesce(tr.text, '')
| 		|| coalesce(po.text, '')
| 		FROM rel r JOIN comments m ON m.oid = r.oid LEFT JOIN indexes x ON x.oid = r.oid
