| 			|| E';\n'
| 			|| coalesce((SELECT format(E'COMMENT ON POLICY %I ON %I IS %L;\n', pol.polname, r.relname, pg_catalog.obj_description(pol.oid, 'pg_policy'))
| 				WHERE pg_catalog.obj_description(pol.oid, 'pg_policy') IS NOT NULL), ''),
