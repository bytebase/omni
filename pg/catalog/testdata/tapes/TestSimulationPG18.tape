| 		WHERE t.typnamespace = 'public'::pg_catalog.regnamespace AND t.typtype = 'r'
| 	UNION ALL
| 	SELECT 'TYPE', t.typname,
| 		format(E'CREATE TYPE %I;\n', t.typname)
