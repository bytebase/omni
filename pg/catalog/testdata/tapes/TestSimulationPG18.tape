| 		AND NOT EXISTS (SELECT 1 FROM pg_catalog.pg_inherits h WHERE h.inhrelid = x.indexrelid)
| 	GROUP BY r.oid
| ), triggers AS (
| 	SELECT r.oid, coalesce(string_agg(
| 			pg_catalog.pg_get_triggerdef(tg.oid) || E';\n'
