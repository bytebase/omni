| 		|| coalesce((SELECT string_agg(format(E'COMMENT ON CONSTRAINT %I ON DOMAIN %I IS %L;\n', k.conname, t.typname, pg_catalog.obj_description(k.oid, 'pg_constraint')), '' ORDER BY k.conname COLLATE "C")
