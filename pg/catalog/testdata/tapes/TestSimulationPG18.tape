| 			FROM pg_catalog.pg_constraint k WHERE k.contypid = t.oid AND pg_catalog.obj_description(k.oid, 'pg_constraint') IS NOT NULL), '')
| 		FROM pg_catalog.pg_type t JOIN pg_catalog.pg_type bt ON bt.oid = t.typbasetype
