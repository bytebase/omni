| 				WHEN 'D' THEN format(E'ALTER TABLE %I DISABLE TRIGGER %I;\n', r.relname, tg.tgname)
| 				WHEN 'A' THEN format(E'ALTER TABLE %I ENABLE ALWAYS TRIGGER %I;\n', r.relname, tg.tgname)
