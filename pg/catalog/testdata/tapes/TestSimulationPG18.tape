| 	UNION ALL
| 	SELECT CASE p.prokind WHEN 'p' THEN 'PROCEDURE' ELSE 'FUNCTION' END,
| 		p.proname || '(' || pg_catalog.pg_get_function_identity_arguments(p.oid) || ')',
