| 			WHERE d.classid = 'pg_catalog.pg_class'::pg_catalog.regclass AND d.objid = c.oid AND d.deptype = 'i')
| ), comments AS (
| 	SELECT r.oid, coalesce((SELECT format(E'COMMENT ON %s %I IS %L;\n',
