| 		|| coalesce(x.text, '') || m.text
| 		FROM rel r JOIN comments m ON m.oid = r.oid LEFT JOIN indexes x ON x.oid = r.oid
| 		WHERE r.relkind IN ('v', 'm')
| ) o ORDER BY relname COLLATE "C", kind
