| ), comments AS (
| 	SELECT r.oid, coalesce((SELECT format(E'COMMENT ON %s %I IS %L;\n',
| 				CASE r.relkind WHEN 'v' THEN 'VIEW' WHEN 'm' THEN 'MATERIALIZED VIEW' WHEN 'S' THEN 'SEQUENCE' ELSE 'TABLE' END,
