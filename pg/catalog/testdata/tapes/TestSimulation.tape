| 			FROM pg_catalog.pg_index x JOIN pg_catalog.pg_class i ON i.oid = x.indexrelid
| 			WHERE x.indrelid = r.oid AND pg_catalog.obj_description(i.oid, 'pg_class') IS NOT NULL), '') AS text
| 	FROM rel r
| ), indexes AS (
