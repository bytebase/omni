| 				pg_catalog.pg_get_expr(r.relpartbound, r.oid))
| 			ELSE format('CREATE %sTABLE %I (%s)', CASE r.relpersistence WHEN 'u' THEN 'UNLOGGED ' ELSE '' END, r.relname,
