| 			FROM pg_catalog.pg_constraint k WHERE k.conrelid = r.oid AND k.conislocal AND k.contype IN ('c', 'f', 'p', 'u', 'x')), '')
| 		|| coalesce(x.text, '')
| 		|| CASE r.relreplident
