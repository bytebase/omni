| 				WHERE a.attrelid = c.oid AND a.attnum > 0 AND NOT a.attisdropped), ''))
| 		|| coalesce((SELECT format(E'COMMENT ON TYPE %I IS %L;\n', c.relname, pg_catalog.obj_description(c.reltype, 'pg_type'))
