| 			THEN ' COLLATE ' || (SELECT format('%I', l.collname) FROM pg_catalog.pg_collation l WHERE l.oid = t.typcollation) ELSE '' END
| 		|| CASE WHEN t.typdefaultbin IS NOT NULL THEN ' DEFAULT ' || pg_catalog.pg_get_expr(t.typdefaultbin, 0)
