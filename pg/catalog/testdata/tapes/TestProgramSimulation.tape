| 			WHEN 'R' THEN format(E'ALTER EVENT TRIGGER %I ENABLE REPLICA;\n', e.evtname)
| 			WHEN 'A' THEN format(E'ALTER EVENT TRIGGER %I ENABLE ALWAYS;\n', e.evtname)
