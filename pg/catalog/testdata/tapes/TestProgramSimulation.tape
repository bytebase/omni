| 				WHERE pg_catalog.obj_description(pol.oid, 'pg_policy') IS NOT NULL), ''),
| 			'' ORDER BY pol.polname COLLATE "C"), '') AS text
| 	FROM rel r JOIN pg_catalog.pg_policy pol ON pol.polrelid = r.oid
| 	GROUP BY r.oid
