| CREATE OR REPLACE FUNCTION public.f_item_qty(i integer)
|  RETURNS integer
|  LANGUAGE sql
| BEGIN ATOMIC
|  SELECT items.qty
|     FROM items
|    WHERE (items.id = f_item_qty.i);
| END;
