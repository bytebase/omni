| CREATE INDEX t_n_idx ON t (n);
| CREATE TABLE s.t (id integer, a integer);
| CREATE VIEW tv AS SELECT code FROM t;
| CREATE MATERIALIZED VIEW mv AS SELECT id FROM p;
