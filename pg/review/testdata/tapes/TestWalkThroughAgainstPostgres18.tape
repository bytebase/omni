| PREPARE walk_columns(text) AS SELECT attname FROM pg_attribute WHERE attrelid = substr($1, 5)::oid AND attnum > 0 AND NOT attisdropped ORDER BY attnum
< ok 0 -
> exec
| PREPARE walk_indexes(text) AS SELECT i.relname, x.indisunique, x.indisprimary, EXISTS (SELECT 1 FROM pg_constraint c WHERE c.conindid = x.indexrelid AND c.contype IN ('p', 'u', 'x')), pg_get_indexdef(i.oid) || ';'
| 			FROM pg_index x JOIN pg_class i ON i.oid = x.indexrelid WHERE x.indrelid = substr($1, 5)::oid ORDER BY 1
< ok 0 -
