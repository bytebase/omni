| 		'squeeze', 'citus', 'citus_internal', 'columnar', 'columnar_internal', 'cron', 'partman') ORDER BY 1, 2
< result
< column "nspname" "NAME"
< column "proname" "NAME"
< column "prokind" "TEXT"
> query
