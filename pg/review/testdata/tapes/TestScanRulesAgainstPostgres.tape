| 				array_to_string(ARRAY(SELECT a.attname FROM pg_attribute a WHERE a.attrelid = c.oid AND a.attnum = ANY(k.conkey) ORDER BY array_position(k.conkey, a.attnum)), ',')), E'\n' ORDER BY c.oid), '')
