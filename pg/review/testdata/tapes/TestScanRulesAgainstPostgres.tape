| 				coalesce(fn.nspname, ''), coalesce(f.relname, ''), coalesce(ARRAY(SELECT a.attname FROM unnest(c.confkey) WITH ORDINALITY k(n, i) JOIN pg_attribute a ON a.attrelid = c.confrelid AND a.attnum = k.n ORDER BY k.i)::text[], '{}'), coalesce(pg_get_expr(c.conbin, c.conrelid), '')
| 			FROM pg_constraint c LEFT JOIN pg_class f ON f.oid = c.confrelid LEFT JOIN pg_namespace fn ON fn.oid = f.relnamespace
