| PREPARE truth_constraints AS SELECT coalesce(string_agg(concat_ws(E'\t', 'oid:' || c.oid, c.conname, c.contype::text, 'oid:' || c.conrelid), E'\n' ORDER BY c.oid), '') FROM pg_constraint c
| 			JOIN pg_class r ON r.oid = c.conrelid JOIN pg_namespace n ON n.oid = r.relnamespace
| 			WHERE n.nspname NOT LIKE 'pg\_%' AND n.nspname <> 'information_schema'
