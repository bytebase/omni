| CREATE TYPE mood AS ENUM ('a', 'b');
| CREATE TABLE e (id integer PRIMARY KEY, m mood CONSTRAINT e_m_check CHECK (m <> 'a'));
| CREATE TABLE ek (m mood PRIMARY KEY);
