| CREATE DEFINER=`root`@`%` FUNCTION `CalculateTotalSales`(p_product_id INT, p_start_date DATE, p_end_date DATE) RETURNS decimal(10,2)
|     READS SQL DATA
|     DETERMINISTIC
| BEGIN
|     DECLARE total DECIMAL(10, 2);
|
|     SELECT COALESCE(SUM(quantity * unit_price), 0) INTO total
|     FROM sales
|     WHERE product_id = p_product_id
|     AND sale_date BETWEEN p_start_date AND p_end_date;
|
|     RETURN total;
| END
: bytes
