| CREATE TABLE `order_items` (
|   `id` int(11) NOT NULL AUTO_INCREMENT COMMENT 'Line item identifier',
|   `order_id` int(11) NOT NULL COMMENT 'Reference to parent order',
|   `product_name` varchar(150) NOT NULL COMMENT 'Full product name including variant details',
|   `quantity` int(11) NOT NULL COMMENT 'Quantity ordered (must be positive)',
|   `unit_price` decimal(10,2) NOT NULL,
|   PRIMARY KEY (`id`),
|   KEY `idx_order` (`order_id`)
| ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
