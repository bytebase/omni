< row
: bytes
| function
: bytes
| CalculateTotalSales
: bytes
| decimal(10,2)
| YES
| READS SQL DATA
| DEFINER
|
| STRICT_TRANS_TABLES,ERROR_FOR_DIVISION_BY_ZERO,NO_AUTO_CREATE_USER,NO_ENGINE_SUBSTITUTION
| BEGIN
|     DECLARE total DECIMAL(10, 2);
|
|     SELECT COALESCE(SUM(quantity * unit_price), 0) INTO total
|     FROM sales
|     WHERE product_id = p_product_id
|     AND sale_date BETWEEN p_start_date AND p_end_date;
|
|     RETURN total;
| END
| IN p_product_id int(11), IN p_start_date date, IN p_end_date date
< row
: bytes
| function
: bytes
| GetTaxAmount
: bytes
| decimal(10,2)
| YES
| NO SQL
| DEFINER
|
| STRICT_TRANS_TABLES,ERROR_FOR_DIVISION_BY_ZERO,NO_AUTO_CREATE_USER,NO_ENGINE_SUBSTITUTION
| BEGIN
|     RETURN amount * (tax_rate / 100);
| END
| IN amount decimal(10,2), IN tax_rate decimal(5,2)
